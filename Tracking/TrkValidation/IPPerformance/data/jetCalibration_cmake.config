Debug             False
InputContainer    AntiKt4EMTopoJets
JetAlgorithm      AntiKt4EMTopo
Sort              False
#
JetCalibCutLevel      LooseBad
JetCleanUgly          False
SaveAllCleanDecisions False
#
OutputContainer   Jets_Calib
OutputAlgo        Jets_Calib_Algo


### small-R jet calibration ###

configNameAFII    JES_MC16Recommendation_AFII_EMTopo_Apr2019_Rel21.config 
configNameFullSim JES_MC16Recommendation_Consolidated_EMTopo_Apr2019_Rel21.config
configNameData    JES_MC16Recommendation_Consolidated_EMTopo_Apr2019_Rel21.config 
# same file as for FullSim

# alternative 1: anti-kT R=0.4 PFlow jets, which  will become standard in Run 3
#configNameAFII    JES_MC16Recommendation_AFII_PFlow_Apr2019_Rel21.config 
#configNameFullSim JES_MC16Recommendation_Consolidated_PFlow_Apr2019_Rel21.config
#configNameData    JES_MC16Recommendation_Consolidated_PFlow_Apr2019_Rel21.config 


# alternative 2: anti-kT R=0.4 LCTopo jets
# --> only have MC-based calibration, no in-situ: https://twiki.cern.ch/twiki/bin/view/AtlasProtected/ApplyJetCalibrationR21#NovPreRec

# JetCalibrator adds _Insitu for the data
CalibSequence     JetArea_Residual_EtaJES_GSC_Smear
CalibSequenceData JetArea_Residual_EtaJES_GSC_Insitu

CalibArea 00-04-82

RedoJVT           False


### systematics below ###

JESJERSyst      None

# Can select if continuous systematics are to be evaluated at 1 sigma or alternative values
sysySigmaVal      1

##JESUncertConfig   $ROOTCOREBIN/data/JetUncertainties/JES_2015/Prerec/PrerecJES2015_3NP_Scenario1_25ns.config
#JESUncertConfig     $IPPerformance_DIR/data/IPPerformance/JetUncertainties/JES_2015/Prerec/PrerecJES2015_3NP_Scenario1_50ns.config
JESUncertConfig     rel21/Summer2019/R4_GlobalReduction_SimpleJER.config
JESUncertMCType   MC16

#### For AFII ###
#JESUncertMCType   AFII
#SetAFII           true
##JESUncertConfig   $ROOTCOREBIN/data/JetUncertainties/JES_2015/Prerec/PrerecJES2015_AllNuisanceParameters_50ns.config

## JER ## only uncomment if want to use systematics
#JERUncertConfig         JetResolution/Prerec2015_xCalib_2012JER_ReducedTo9NP_Plots.root
#JERFullSys        false
#JERApplyNominal   false

## last option must be followed by a new line ##
