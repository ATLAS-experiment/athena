Debug             False
InputContainer    AntiKt4EMTopoJets
JetAlgorithm      AntiKt4EMTopo
Sort              False
#
JetCalibCutLevel      LooseBad
JetCleanUgly          False
SaveAllCleanDecisions False
#
OutputContainer   Jets_Calib
OutputAlgo        Jets_Calib_Algo

### Jet calibration ###


#configNameAFII    JES_MC16Recommendation_AFII_PFlow_Apr2019_Rel21.config # for PFlow
configNameAFII    JES_MC16Recommendation_AFII_EMTopo_Apr2019_Rel21.config # for EMTopo
#configNameFullSim JES_MC16Recommendation_Consolidated_PFlow_Apr2019_Rel21.config # for PFlow
configNameFullSim JES_MC16Recommendation_Consolidated_EMTopo_Apr2019_Rel21.config # for EMTopo
#configNameData    JES_data2016_data2015_Recommendation_Dec2016_rel21.config # not needed any more, included in the config for FullSim

# JetCalibrator adds _Insitu for the data
CalibSequence     JetArea_Residual_EtaJES_GSC_Smear
CalibSequenceData JetArea_Residual_EtaJES_GSC_Insitu

CalibArea 00-04-82

RedoJVT           False


### systematics below ###


##JESUncertConfig   $ROOTCOREBIN/data/JetUncertainties/JES_2015/Prerec/PrerecJES2015_3NP_Scenario1_25ns.config
JESUncertConfig   $ROOTCOREBIN/data/JetUncertainties/JES_2015/Prerec/PrerecJES2015_3NP_Scenario1_50ns.config

JESUncertMCType   MC15

#### For AFII ###
#JESUncertMCType   AFII
#SetAFII           true
##JESUncertConfig   $ROOTCOREBIN/data/JetUncertainties/JES_2015/Prerec/PrerecJES2015_AllNuisanceParameters_50ns.config

## JER ## only uncomment if want to use systematics
#JERUncertConfig         JetResolution/Prerec2015_xCalib_2012JER_ReducedTo9NP_Plots.root
#JERFullSys        false
#JERApplyNominal   false

## last option must be followed by a new line ##
