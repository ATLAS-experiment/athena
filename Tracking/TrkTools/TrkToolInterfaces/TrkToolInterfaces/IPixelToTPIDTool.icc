namespace Trk {

inline float
IPixelToTPIDTool::dEdx(const Trk::Track& track,
                       int& nUsedHits,
                       int& nIBLOverflowHits) const
{

  return dEdx(
    Gaudi::Hive::currentContext(), track, nUsedHits, nIBLOverflowHits);
}
}
