namespace ActsTrk::detail {

template <typename calib_data_t, typename traj_t>
StatusCode NNClusterCalibratorToolImpl<calib_data_t, traj_t>::initialize() {
  ATH_CHECK(m_readKeyONNX.initialize());
  ATH_MSG_DEBUG("Initializing ...");

  ATH_CHECK(BASE::initialize());
  ATH_MSG_INFO(" successfully initialized, NNClusterCalibrator implementation");
  return StatusCode::SUCCESS;
}

template <typename calib_data_t, typename traj_t>
NNClusterCalibratorOptions<calib_data_t, traj_t>
NNClusterCalibratorToolImpl<calib_data_t, traj_t>::createOptions(
    const EventContext& ctx) const {
  NNClusterCalibratorOptions<calib_data_t, traj_t> opt;
  opt.m_minClusterSizeForNN = m_minClusterSizeForNN;
  opt.m_minClusterChargeForNN = m_minClusterChargeForNN;
  SG::ReadCondHandle<OnnxNNCollection> onnxCollection(m_readKeyONNX, ctx);
  if (!onnxCollection.isValid()) {
    ATH_MSG_FATAL("Failed to get ONNX network collection with key "
                  << m_readKeyONNX.key());
    return opt;  // this options will be invalid
  } else {
    ATH_MSG_DEBUG("Obtained NN models for this event");
  }

  opt.m_models = onnxCollection.cptr();

  auto barePointer = BASE::createOnTrackCalibrator(ctx).release();
  auto downCast =
      dynamic_cast<AnalogueClusteringCalibrator<calib_data_t, traj_t>*>(
          barePointer);
  opt.m_fallback =
      std::unique_ptr<AnalogueClusteringCalibrator<calib_data_t, traj_t>>(
          downCast);
  return opt;
}

template <typename calib_data_t, typename traj_t>
std::tuple<typename NNClusterCalibrator<calib_data_t, traj_t>::BASE::Pos,
           typename NNClusterCalibrator<calib_data_t, traj_t>::BASE::Cov,
           unsigned int>
NNClusterCalibrator<calib_data_t, traj_t>::calibrate(
    const EventContext& ctx, const Acts::GeometryContext& gctx,
    const Acts::CalibrationContext& cctx, const xAOD::PixelCluster& cluster,
    const InDetDD::SiDetectorElement& detElement,
    const std::pair<float, float>& tan_incidence_angles,
    const Acts::Vector2& predicted_local_position) const {
    double totalCharge = cluster.totalCharge();
    if (totalCharge < m_options.m_minClusterChargeForNN || cluster.chargeList().size() <
      	m_options.m_minClusterSizeForNN) {
    return m_options.m_fallback->calibrate(ctx, gctx, cctx, cluster,
                                             detElement, tan_incidence_angles,
                                             predicted_local_position);
  }

  ActsTrk::NNinput nnInput;
  NNPixelCluster::fillClusterData(this->pixelID(), nnInput, cluster, detElement);

  nnInput.set(NNinput::Index::phi, std::atan(tan_incidence_angles.first));
  nnInput.set(NNinput::Index::theta, std::atan(tan_incidence_angles.second));

  // 1st call to
  std::array<float, 3> probabilities = NNPixelCluster::predictNumberOfClusters(
      *m_options.m_models->numberNetwork, nnInput);
  // pick max probability
  const int maxProbNumberIndex = NumberNNoutput::maxProbIndex(probabilities);
  const int maxProbNumberOfClusters = maxProbNumberIndex + 1;

  PositionNNoutput positions =
      predictPositions(nnInput, maxProbNumberOfClusters);

  // local module coordinates of the i-th sub-cluster
  auto subClusterPosition = [&nnInput, &positions](NNinput::index_t i) {
    return Acts::Vector2(
        nnInput.indexCoordToRealCoord(positions.x(i), NNinput::Index::pitchXOffset),
        nnInput.indexCoordToRealCoord(positions.y(i), NNinput::Index::pitchYOffset));
  };

  // The cluster was created by one or several particles: use the position of the
  // particle closest to the track
  assert(positions.numberOfSubClusters() > 0);
  const NNinput::index_t chosen = *std::ranges::min_element(
      std::views::iota(NNinput::index_t{0}, positions.numberOfSubClusters()),
      std::ranges::less{},
      [&subClusterPosition, &predicted_local_position](NNinput::index_t i) {
        return (subClusterPosition(i) - predicted_local_position).squaredNorm();
      });
  typename NNClusterCalibrator<calib_data_t, traj_t>::BASE::Pos pos =
      subClusterPosition(chosen).template cast<float>();

  // the NN precision is converted to the RMS (in mm), the covariance is its square
  const float rmsX = nnInput.precisionToRealCoord(positions.xprec(maxProbNumberIndex),
                                                  NNinput::Index::pitchXOffset);
  const float rmsY = nnInput.precisionToRealCoord(positions.yprec(maxProbNumberIndex),
                                                  NNinput::Index::pitchYOffset);
  typename NNClusterCalibrator<calib_data_t, traj_t>::BASE::Cov cov;
  cov(1, 0) = cov(0, 1) = 0.0f;
  cov(0, 0) = rmsX * rmsX;
  cov(1, 1) = rmsY * rmsY;

  unsigned int splitFlag =
      positions.numberOfSubClusters() > 1
          ? detail::setTrackStateFlag(Acts::TrackStateFlag::IsSplitHit)
          : 0;
  return {pos, cov, splitFlag};
}

template <typename calib_data_t, typename traj_t>
Ort::Session& NNClusterCalibrator<calib_data_t, traj_t>::selectPositionNetwork(
    int number) const {
  if (number == 1) {
    return *m_options.m_models->positionNetwork1;
  } else if (number == 2) {
    return *m_options.m_models->positionNetwork2;
  }
  return *m_options.m_models->positionNetwork3;
}

template <typename calib_data_t, typename traj_t>
PositionNNoutput NNClusterCalibrator<calib_data_t, traj_t>::predictPositions(
    NNinput& nn, int number) const {

  Ort::Session& session = selectPositionNetwork(number);
  auto inputTypeInfo = session.GetInputTypeInfo(0);
  auto tensorInfo = inputTypeInfo.GetTensorTypeAndShapeInfo();
  const int64_t expectedDim = tensorInfo.GetShape()[1];

  // TODO investigate streamlining this
  // at least part of preparation can be shared between Number and Posion (this)
  // this is copy paste from NnClusterizationFactory
  // seems to be a lot of preps to be repeated for each invocation
  // maybe it can be spared?
  Ort::MemoryInfo memInfo =
      Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);

  std::vector<int64_t> inputShape = {1, expectedDim};
  Ort::Value inputTensor = Ort::Value::CreateTensor<float>(
      memInfo, nn.payload().data(), nn.payload().size(), inputShape.data(),
      inputShape.size());

  Ort::AllocatorWithDefaultOptions allocator;
  auto inputName = session.GetInputNameAllocated(0, allocator);
  auto outputName = session.GetOutputNameAllocated(0, allocator);
  std::array<const char*, 1> inputNames({inputName.get()});
  std::array<const char*, 1> outputNames({outputName.get()});

  Ort::TypeInfo typeInfo = session.GetOutputTypeInfo(0);
  auto tensorInfoOutput = typeInfo.GetTensorTypeAndShapeInfo();
  std::vector<int64_t> shape = tensorInfoOutput.GetShape();

  // this shape is supposed to always be: [number*5]
  assert(shape[1] == 5 * number);

  // Run inference
  auto outputTensors = session.Run(Ort::RunOptions{nullptr}, inputNames.data(),
                                   &inputTensor, 1, outputNames.data(), 1);

  // Extract output
  const float* outputData = outputTensors[0].GetTensorData<float>();

  // NN outputs 5 numbers
  return PositionNNoutput(outputData, outputData + (number * 5));
}


}  // namespace ActsTrk::detail

#endif  // NNCLUSTERINGTOOLIMPL_ICC
