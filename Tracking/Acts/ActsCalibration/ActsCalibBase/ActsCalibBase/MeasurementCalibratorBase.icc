#ifndef ACTSCALIBBASE_MEASUREMENTCALIBRATORBASE_ICC
#define ACTSCALIBBASE_MEASUREMENTCALIBRATORBASE_ICC

namespace ActsTrk::detail {
template <std::size_t Dim, Acts::TrackStateProxyConcept proxy_t, typename pos_t, typename cov_t>
    inline void MeasurementCalibratorBase::setState(const ProjectorType projector,
                                                    const pos_t& locpos, const cov_t& cov,
                                                    Acts::SourceLink link,
                                                    proxy_t& trackState) const {
      static_assert(Dim>0 && Dim <= 3, "Wrong measurement dimension");
      trackState.setUncalibratedSourceLink(std::move(link));
      trackState.allocateCalibrated(Dim);
      trackState.setProjectorSubspaceIndices(s_boundSpaceIndices[static_cast<int>(projector)]);
      trackState.template calibrated<Dim>() = locpos.template cast<double>();
      trackState.template calibratedCovariance<Dim>() = cov.template cast<double>();
  }

template <std::size_t Dim, Acts::TrackStateProxyConcept proxy_t>
    void MeasurementCalibratorBase::prepareCalibratedState(const ProjectorType projector,
                                                           Acts::SourceLink link,
                                                           proxy_t& trackState) const {
      static_assert(Dim>0 && Dim <= 3, "Wrong measurement dimension");
      trackState.setUncalibratedSourceLink(std::move(link));
      trackState.setProjectorSubspaceIndices(s_boundSpaceIndices[static_cast<int>(projector)]);
  }

template <Acts::PointerConcept Ptr_t>
    inline Acts::SourceLink MeasurementCalibratorBase::pack(const Ptr_t& measurement) {
        if (!measurement) {
            return Acts::SourceLink{SourceLink_t{}};
        }
        return Acts::SourceLink{SourceLink_t{measurement}};
    }

  inline MeasurementCalibratorBase::SourceLink_t 
      MeasurementCalibratorBase::unpackBase(const Acts::SourceLink& sl) {
      return sl.template get<SourceLink_t>();
  }
  inline SourceLinkType MeasurementCalibratorBase::getType(const Acts::SourceLink& sl) {
      const auto& atlasSL = sl.template get<SourceLink_t>();
      return std::visit([](const auto& visitSl) -> SourceLinkType {
          using SL_t = std::decay_t<decltype(visitSl)>;
          if constexpr (std::is_same_v<SL_t, const xAOD::UncalibratedMeasurement*>) {
              return SourceLinkType::xAODUnCalibMeas;
          } else if constexpr(std::is_same_v<SL_t, const Trk::PrepRawData*>) {
              return SourceLinkType::TrkPrepRawData;
          } else if constexpr (std::is_same_v<SL_t, const Trk::MeasurementBase*>) {
              return SourceLinkType::TrkMeasurement;
          } else {
              return SourceLinkType::nTypes;
          }

      }, atlasSL);
    
  }
} // namespace ActsTrk::detail

#endif

