#include "xAODInDetMeasurement/ContainerAccessor.h"
#include "AthenaMonitoringKernel/MonitoredTimer.h"
#include "CxxUtils/checker_macros.h"

#ifndef ACTSTRK_DATAPREPARATION_CLUSTERIZATIONALG_H
namespace {
   template <typename T>
   concept has_moduleIndex = requires (T &&a) { a.moduleIndex(); };
}
#endif

namespace ActsTrk {

  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::DataPreparationAlg(const std::string& name,
														  ISvcLocator* pSvcLocator)
    : AthReentrantAlgorithm(name, pSvcLocator)
  {}

  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  StatusCode DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::initialize()
  {
    ATH_MSG_INFO("Initializing " << name() << " ...");

    // Handles we always need
    ATH_CHECK(m_outputCollectionKey.initialize());
    ATH_CHECK(m_roiCollectionKey.initialize());
    // Collections needed if we do not use the cache
    ATH_CHECK(m_inputCollectionKey.initialize(not useCache));
    ATH_CHECK(m_detEleCollKey.initialize(not useCache));
    // Collections needed if we use the cache
    ATH_CHECK(m_inputIdentifiableContainer.initialize(useCache));
    // Prd Map from previous tracking pass
    ATH_CHECK(m_inputPrdMap.initialize(not m_inputPrdMap.empty()));
    
    // Tools
    ATH_CHECK(m_monTool.retrieve(EnableTool{not m_monTool.empty()}));
    ATH_CHECK(m_regionSelector.retrieve(EnableTool{not m_regionSelector.empty()}));

    return StatusCode::SUCCESS;
  }

  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  StatusCode DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::finalize()
  {
    ATH_MSG_INFO("Data Prep statistics" << std::endl << makeTable(m_stat,
								       std::array<std::string, kNStat>{
									 "Inputs",
									 "Outputs"
								       }).columnWidth(10));
    
    return StatusCode::SUCCESS;
  }
  
  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  StatusCode
  DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::execute(const EventContext& ctx) const
  {
    ATH_MSG_DEBUG("Executing " << name() << " ...");
    auto timer = Monitored::Timer<std::chrono::milliseconds>( "TIME_execute" );
    auto mon = Monitored::Group( m_monTool, timer );    


    ATH_MSG_DEBUG("Writing output collection with key `" << m_outputCollectionKey.key() << "`");
    SG::WriteHandle< output_collection_t > outputHandle = SG::makeHandle( m_outputCollectionKey, ctx );
    ATH_CHECK( outputHandle.record( std::make_unique<output_collection_t>(SG::VIEW_ELEMENTS) ) );
    output_collection_t *outputCollection = outputHandle.ptr();

    ATH_CHECK( fill( ctx, *outputCollection ) );
    m_stat[kNOutputs] += outputCollection->size();
    ATH_MSG_DEBUG("Concluded creation of output collection with " << outputCollection->size() << " entries");
    return StatusCode::SUCCESS;
  }

  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  StatusCode
  DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::fill(const EventContext& ctx,
												    output_collection_t& outputCollection) const
  {
    ATH_MSG_DEBUG("Filling output collection from container");
    
    // Inputs
    ATH_MSG_DEBUG("Retrieving Input Collection with key `" << m_inputCollectionKey.key() << "`");
    SG::ReadHandle< input_collection_t > inputHandle = SG::makeHandle(  m_inputCollectionKey, ctx );
    ATH_CHECK(inputHandle.isValid());
    const input_collection_t* inputCollection = inputHandle.cptr();
    ATH_MSG_DEBUG("Retrieved input collection with " << inputCollection->size() << " elements.");
    
    if (inputCollection->size() == 0) {
      return StatusCode::SUCCESS;
    }

    const ActsTrk::PrepRawDataAssociation *inputPrdMap = nullptr;
    if (not m_inputPrdMap.empty()) {
      ATH_MSG_DEBUG("Retrieving Prd map from previous Acts Tracking Pass with key: " << m_inputPrdMap.key());
      SG::ReadHandle< ActsTrk::PrepRawDataAssociation > inputPrdMapHandle = SG::makeHandle( m_inputPrdMap, ctx );
      ATH_CHECK( inputPrdMapHandle.isValid() );
      inputPrdMap = inputPrdMapHandle.cptr();
      ATH_MSG_DEBUG("   \\__ Number of already used measurement from previous passes: " << inputPrdMap->size());
    }
    
    ATH_MSG_DEBUG("Retrieving SiDetectorElementCollection with key `" << m_detEleCollKey.key() << "`");
    SG::ReadCondHandle< external_detector_element_collection_t > detEleHandle = SG::makeHandle( m_detEleCollKey, ctx );
    ATH_CHECK(detEleHandle.isValid());    
    const external_detector_element_collection_t* detElements = detEleHandle.cptr();

    int nRejected = 0;
    if constexpr(has_moduleIndex<external_collection_t>) {
       // in addition to pushing back elements to the ConstDataVector
       // also the moduleIndex needs to be built.
       // So the access control of the CosntDataVector needs to be circumvented
       // so that the ModuleIndex can be updated at the same as elements are pushed to
       // the ConstDataVector.
       input_collection_t *non_const_outputCollection ATLAS_THREAD_SAFE = const_cast<input_collection_t *>(outputCollection.asDataVector());
       auto &outputCollection_moduleIndex = non_const_outputCollection->moduleIndex();

       std::set<IdentifierHash> hashes;
       ATH_CHECK( fetchIdHashes( ctx, hashes ) );
       // Run on all the id hashes that overlap with the RoI
       unsigned int n_elements_total=0u;
       for (const IdentifierHash id : hashes) {
          const PhaseII::DataRange &range(inputCollection->m_moduleIndex.range(id));
          // If the requested idHash is not present move to the next one
          // This should not happen for clusters, but may happen for strip space points
          if (range.empty()) {
             continue;
          }
          n_elements_total+=range.size(); // does not take element selection into account -> overallocation of selection index
       }
       m_stat[kNInputs] += n_elements_total;
       outputCollection_moduleIndex.m_range.resize( inputCollection->moduleIndex().m_range.size());
       outputCollection_moduleIndex.m_selection.reserve(n_elements_total);
       outputCollection_moduleIndex.m_srcContainer = inputCollection->moduleIndex().m_srcContainer;
       for (const IdentifierHash id : hashes) {
          const PhaseII::DataRange &range(inputCollection->moduleIndex().range(id));
          // If the requested idHash is not present move to the next one
          // This should not happen for clusters, but may happen for strip space points
          if (range.empty()) {
             continue;
          }
          auto const &src_container = inputCollection->moduleIndex().container(range);
          unsigned int begin_index = outputCollection_moduleIndex.m_selection.size();
          for (unsigned int idx = range.beginIndex(); idx < range.endIndex(); ++idx) {
             assert(idx < src_container.size());
             const auto *element = src_container[idx];
             if constexpr (not std::is_same<object_t, xAOD::SpacePoint >::value) {
                if ( inputPrdMap and inputPrdMap->isUsed(element->identifier()) ) {
                   ++nRejected;
                   continue;
                }
             } else {
                if ( inputPrdMap and inputPrdMap->isUsed(element->measurements()[0]->identifier()) ) {
                   ++nRejected;
                   continue;
                }
             }
             outputCollection_moduleIndex.m_selection.push_back(element->index());
             outputCollection.push_back(element);
          }
          outputCollection_moduleIndex.registerRange(id,
                                                     begin_index,
                                                     outputCollection_moduleIndex.m_selection.size(),
                                                     range.containerIndex());
       }
    }
    else {
    // Selection
    // For the time being we simply insert data given the idHash
    // Use the Container Accessor strategy
    ContainerAccessor<object_t, IdentifierHash, 1>
      accessor ( *inputCollection,
		 [this] (const object_t& coll) -> IdentifierHash 
		 { return retrieveDetectorIDHash(coll); },
		 detElements->size());
    m_stat[kNInputs] += inputCollection->size();
    
    // Get the list of id hashes from the RoI
    std::set<IdentifierHash> hashes;
    ATH_CHECK( fetchIdHashes( ctx, hashes ) );

    // Run on all the id hashes that overlap with the RoI
    for (const IdentifierHash id : hashes) {      
      // If the requested idHash is not present move to the next one
      // This should not happen for clusters, but may happen for strip space points
      if (not accessor.isIdentifierPresent(id)) {
	continue;
      }

      // Get the objects and add them to the output collection
      const auto& ranges = accessor.rangesForIdentifierDirect(id);
      for (auto [firstElement, lastElement] : ranges) {
	for (; firstElement != lastElement; ++firstElement) {
	  // Check Prd Map
	  if constexpr (not std::is_same<object_t, xAOD::SpacePoint >::value) {
	    if ( inputPrdMap and inputPrdMap->isUsed((*firstElement)->identifier()) ) {
	      ++nRejected;
	      continue;
	    }
	  } else {
	    if ( inputPrdMap and inputPrdMap->isUsed((*firstElement)->measurements()[0]->identifier()) ) {
              ++nRejected;
	      continue;
	    }
	  }
	  outputCollection.push_back(*firstElement);
	}
      }
    }
    }
    
    ATH_MSG_VERBOSE("Rejected: " << nRejected);
    
    return StatusCode::SUCCESS;
  }

  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  StatusCode
  DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::fill(const EventContext& ctx,
												    output_collection_t& outputCollection) const
    requires (useCache == true)
  {
    ATH_MSG_DEBUG("Filling output collection from cache");

    // Inputs
    ATH_MSG_DEBUG("Retrieving Identifiable Container with key `" << m_inputIdentifiableContainer.key() << "`");
    cache_read_handle_t cacheHandle = SG::makeHandle( m_inputIdentifiableContainer, ctx );
    ATH_CHECK( cacheHandle.isValid() );

    const ActsTrk::PrepRawDataAssociation *inputPrdMap = nullptr;
    if (not m_inputPrdMap.empty()) {
      ATH_MSG_DEBUG("Retrieving Prd map from previous Acts Tracking Pass with key: " << m_inputPrdMap.key());
      SG::ReadHandle< ActsTrk::PrepRawDataAssociation > inputPrdMapHandle = SG::makeHandle( m_inputPrdMap, ctx );
      ATH_CHECK( inputPrdMapHandle.isValid() );
      inputPrdMap = inputPrdMapHandle.cptr();
      ATH_MSG_DEBUG("   \\__ Number of already used measurement from previous passes: " << inputPrdMap->size());
    }
    
    std::set<IdentifierHash> hashes;
    ATH_CHECK( fetchIdHashes( ctx, hashes ) );

    int nRejected = 0;
    if constexpr(has_moduleIndex<external_collection_t>) {
       // in addition to pushing back elements to the ConstDataVector
       // also the moduleIndex needs to be built.
       // So the access control of the CosntDataVector needs to be circumvented
       // so that the ModuleIndex can be updated at the same as elements are pushed to
       // the ConstDataVector.
       input_collection_t *non_const_outputCollection ATLAS_THREAD_SAFE = const_cast<input_collection_t *>(outputCollection.asDataVector());
       auto &outputCollection_moduleIndex = non_const_outputCollection->moduleIndex();

       std::set<IdentifierHash> hashes;
       ATH_CHECK( fetchIdHashes( ctx, hashes ) );
       // Run on all the id hashes that overlap with the RoI
       unsigned int n_elements_total=0u;
       for (const IdentifierHash idHash : hashes) {
          auto ce = cacheHandle->indexFindPtr(idHash);
          if(ce == nullptr) continue;
          if (!ce->container)  continue;
          const input_collection_t *src_container=dynamic_cast<const input_collection_t *>(ce->container);
          assert(src_container);
          outputCollection_moduleIndex.m_range.resize( src_container->moduleIndex().m_range.size() );
          break;
       }
       for (const IdentifierHash idHash : hashes) {
          auto ce = cacheHandle->indexFindPtr(idHash);
          if(ce == nullptr) continue;
          assert( ce->ranges.size()==1ul);
          const input_collection_t *src_container=nullptr;
          unsigned int container_index = std::numeric_limits<unsigned int>::max();
          for(auto rng: ce->ranges){
             if(rng.first == rng.second) continue;
             assert(ce->container);
             if (ce->container != src_container) {
                src_container=dynamic_cast<const input_collection_t *>(ce->container);
                container_index = outputCollection_moduleIndex.containerIndex(*src_container);
             }
             assert(src_container);
             outputCollection_moduleIndex.registerRange(idHash, rng.first, rng.second, container_index);
             n_elements_total+=rng.second - rng.first; // does not take element selection into account -> overallocation of selection index
          }
       }
       outputCollection_moduleIndex.m_selection.reserve(n_elements_total);
       for (unsigned int id_hash=0u; id_hash < outputCollection_moduleIndex.m_range.size(); ++id_hash) {
          const PhaseII::DataRange range = outputCollection_moduleIndex.m_range[id_hash];
          if(range.empty()) continue;
          auto const &src_container = outputCollection_moduleIndex.container(range);
          unsigned int begin_index=outputCollection_moduleIndex.m_selection.size();
          for (unsigned int element_index = range.beginIndex(); element_index < range.endIndex(); ++element_index) {
             const auto *element = src_container[element_index];
             // Check the measurement has not been used previously
             if constexpr (not std::is_same<object_t, xAOD::SpacePoint >::value) {
                if ( inputPrdMap and inputPrdMap->isUsed(element->identifier()) ) {
                   ++nRejected;
                   continue;
                }
             } else {
                if ( inputPrdMap and inputPrdMap->isUsed(element->measurements()[0]->identifier()) ) {
                   ++nRejected;
                   continue;
                }
             }
             assert( element->index() < src_container.size());
             outputCollection_moduleIndex.m_selection.push_back(element->index());
             outputCollection.push_back(element);
          }
          outputCollection_moduleIndex.registerRange(id_hash,
                                                     begin_index,
                                                     outputCollection_moduleIndex.m_selection.size(),
                                                     range.containerIndex());
       }
    }
    else {
    unsigned int n_elements_total=0u;
    for(auto idHash: hashes) {
      //this function will wait if an item is not available
      auto ce = cacheHandle->indexFindPtr(idHash);
      if(ce == nullptr) continue;
      for(auto rng: ce->ranges){
        if(rng.first == rng.second) continue;
	n_elements_total += rng.second - rng.first;
        for(unsigned int i = rng.first; i < rng.second; i++){

	  // Check the measurement has not been used previously
	  if constexpr (not std::is_same<object_t, xAOD::SpacePoint >::value) {
            if ( inputPrdMap and inputPrdMap->isUsed(ce->container->at(i)->identifier()) ) {
              ++nRejected;
              continue;
            }
          } else {
            if ( inputPrdMap and inputPrdMap->isUsed(ce->container->at(i)->measurements()[0]->identifier()) ) {
              ++nRejected;
              continue;
            }
          }
	  
          outputCollection.push_back(ce->container->at(i));
        }
      }
    }
    m_stat[kNInputs]+=n_elements_total;
    }
    ATH_MSG_VERBOSE("Rejected: " << nRejected);
    
    return StatusCode::SUCCESS;
  }
  
  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  StatusCode
  DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::fetchIdHashes(const EventContext& ctx,
													     std::set<IdentifierHash>& hashes) const
  {
    // Check Regional Selection Tool is enabled
    if ( m_regionSelector.empty() ) {
      ATH_MSG_ERROR("Regional Selector Tool must be enabled in order to fetch the id hashes!");
      return StatusCode::FAILURE;
    }
    
    ATH_MSG_DEBUG("Retrieving RoIs with key `" << m_roiCollectionKey.key() << "`");
    SG::ReadHandle< TrigRoiDescriptorCollection > roiHandle = SG::makeHandle( m_roiCollectionKey, ctx );
    ATH_CHECK(roiHandle.isValid());
    const TrigRoiDescriptorCollection* roiCollection = roiHandle.cptr();
    
    std::vector<IdentifierHash> listOfIds;
    for (const auto* roi : *roiCollection) {
      listOfIds.clear();
      m_regionSelector->lookup(ctx)->HashIDList(*roi, listOfIds);
      hashes.insert(listOfIds.begin(), listOfIds.end());
    }
    
    return StatusCode::SUCCESS;
  }

  template <typename external_collection_t,
	    typename external_detector_element_collection_t,
	    bool useCache>
  inline xAOD::DetectorIDHashType
  DataPreparationAlg<external_collection_t, external_detector_element_collection_t, useCache>::retrieveDetectorIDHash(const object_t&) const
  { return 0; }
  
} // namespace
