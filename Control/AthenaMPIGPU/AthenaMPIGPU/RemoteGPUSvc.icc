#ifndef ATHENAMPIGPU_REMOTEGPUSVC_ICC
#define ATHENAMPIGPU_REMOTEGPUSVC_ICC

// Local include(s)
#include "RemoteGPUSvc.h"

// Athena include(s)
#include "AthenaKernel/ClusterMessage.h"

// System include(s)
#include <format>
#include <utility>

namespace RemoteCall {

template <RPCCallable F>
StatusCode RemoteGPUSvc::registerFunction(F&& f, std::string name) {
  if (!m_registrationPermitted) {
    ATH_MSG_ERROR(
        "RPC function registration may only occur during initialization");
    return StatusCode::FAILURE;
  }
  const bool added =
      m_functionRegistry.emplace(std::forward<F>(f), std::move(name)).second;
  return added ? StatusCode::SUCCESS : StatusCode::FAILURE;
}

/// Submit a request and suspend the asynchronous algorithm for its result.
template <RPCSupported... R, RPCSupported... Args>
std::tuple<RPCRet<Host, R>...> RemoteGPUSvc::call(
    const EventContext& ctx, const AthAsynchronousAlgorithm& algorithm,
    std::string_view functionName, const Args*... args) const {
  if (isServer()) {
    throw std::logic_error("Cannot submit a request from the server");
  }

  auto fn_iter = m_functionRegistry.find(functionName);
  if (fn_iter == m_functionRegistry.end()) {
    throw std::logic_error(std::format(
        "Tried to call unregistered remote function {}", functionName));
  }

  if (!fn_iter->validateArgTypes<Args...>()) {
    throw std::logic_error(std::format(
        "Argument type mismatch in call to remote function {}", functionName));
  }

  if (!fn_iter->validateReturnTypes<R...>()) {
    throw std::logic_error(std::format(
        "Return type mismatch in call to remote function {}", functionName));
  }

  // Validate sizes and pointers before sending anything to the server.
  std::vector<ClusterMessage::DataDescr> argData;
  argData.reserve(sizeof...(Args));
  (argData.push_back(describeArg(args)), ...);
  auto request = std::make_unique<ClientRequest>(ctx.evt(), &*fn_iter);
  auto request_future = request->completion.get_future();
  {
    // New scope so request_entry gets released before we suspend
    decltype(m_clientRequests)::accessor request_entry;

    m_clientRequests.insert(request_entry, request->id());
    auto& [id, request_] =
        *request_entry;  // need a second name for the request
    request_ = std::move(request);

    // Send the request. Start by sending the hash of the function name.
    // The remote end knows this because it's the first message it has received
    // from this rank with this request id.
    startRequest(*request_);
    // Now send each argument
    for (std::size_t i = 0; i < argData.size(); ++i) {
      auto& desc = argData[i];
      desc.dest = fn_iter->arguments()[i].destination;
      desc.evtNumber = request_->eventNumber;
      desc.requestNumber = request_->id();
      m_clusterSvc->sendMessage(
          ServerRank, ClusterMessage(ClusterMessageType::Data, std::move(desc)),
          ClusterComm::EventData);
    }
  }

  // Wait for results to come back. This is handled in a dedicated thread.
  // We moved from request so that is now empty, and we can re-use it
  request = request_future.get();
  algorithm.restoreAfterSuspend().orThrow(
      "Failed to restore after waiting for a remote GPU request",
      "RemoteGPUSvc");
  return request->rpcFunction->retrieve<R...>(std::move(request->returnVals));
}

template <RPCSupported T>
ClusterMessage::DataDescr RemoteGPUSvc::describeArg(const T* arg) {
  if (arg == nullptr)
    throw std::invalid_argument("Null RPC argument");
  if constexpr (RPCRange<T>) {
    using E = typename RPCDataTraits<T>::element_type;
    const auto count = std::ranges::size(*arg);
    const auto* data = std::ranges::data(*arg);
    if (count > std::numeric_limits<std::size_t>::max() / sizeof(E) ||
        (count != 0 && data == nullptr)) {
      throw std::invalid_argument("Invalid RPC argument range");
    }
    return ClusterMessage::DataDescr(data, count);
  } else {
    return ClusterMessage::DataDescr(arg);
  }
}
}  // namespace RemoteCall

#endif  // ATHENAMPIGPU_REMOTEGPUSVC_ICC
