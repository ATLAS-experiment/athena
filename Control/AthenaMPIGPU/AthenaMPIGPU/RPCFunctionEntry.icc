#ifndef ATHENAMPIGPU_RPCFUNCTIONENTRY_ICC
#define ATHENAMPIGPU_RPCFUNCTIONENTRY_ICC

// Local include(s)
#include "RPCFunctionEntry.h"

// Athena include(s)
#include "CxxUtils/XXH.h"

// Boost include(s)
#include <boost/callable_traits.hpp>
#include <boost/mp11.hpp>

// System include(s)
#include <stdexcept>
#include <tuple>
#include <utility>

namespace RemoteCall {

inline const std::string& RPCFunctionEntry::name() const noexcept {
  return m_name;
}

inline const std::vector<RPCArgEntry>& RPCFunctionEntry::arguments()
    const noexcept {
  return m_arguments;
}

inline const std::vector<RPCArgEntry>& RPCFunctionEntry::returnVals()
    const noexcept {
  return m_returnVals;
}

template <RPCSupported... Args>
inline bool RPCFunctionEntry::validateArgTypes() const {
  if (sizeof...(Args) != m_arguments.size()) {
    // Number of arguments matches expected
    return false;
  }

  // Each type matches
  std::size_t counter = 0;
  return ((typeid(Args) == *m_arguments[counter++].valType) && ...);
}

template <RPCSupported... Rs>
inline bool RPCFunctionEntry::validateReturnTypes() const {
  if (sizeof...(Rs) != m_returnVals.size())
    return false;
  std::size_t counter = 0;
  return ((typeid(Rs) == *m_returnVals[counter++].valType) && ...);
}

template <RPCSupported... Rs>
inline std::tuple<RPCRet<Host, Rs>...> RPCFunctionEntry::retrieve(
    std::vector<ClusterMessage::DataDescr>&& returnVals) const {
  if (!validateReturnTypes<Rs...>() || sizeof...(Rs) != returnVals.size()) {
    throw std::logic_error("RPC return types or result count do not match");
  }
  // Keep the descriptors in this scope so exceptions release every result
  // buffer.
  auto received = std::move(returnVals);
  auto makeResult = [&received]<typename R>(std::size_t i) {
    using E = typename RPCDataTraits<R>::element_type;
    auto& desc = received[i];
    if (desc.dest != Destination::Host || desc.align < alignof(E) ||
        desc.len % sizeof(E) != 0 ||
        (!RPCDataTraits<R>::isRange && desc.len != sizeof(E))) {
      throw std::logic_error(
          "Invalid RPC result size, alignment or destination");
    }
    const auto count = desc.len / sizeof(E);
    return RPCRet<Host, R>(desc.takeOwnership(), count);
  };
  return [&makeResult]<std::size_t... I>(std::index_sequence<I...>) {
    return std::tuple<RPCRet<Host, Rs>...>{
        makeResult.template operator()<Rs>(I)...};
  }(std::index_sequence_for<Rs...>{});
}

inline const RPCFunctionEntry::Wrapper& RPCFunctionEntry::wrapper()
    const noexcept {
  return m_wrapper;
}

inline bool RPCFunctionEntryHash::transparent_key_equal::operator()(
    const RPCFunctionEntry& lhs, const RPCFunctionEntry& rhs) const noexcept {
  return lhs.name() == rhs.name();
}

inline bool RPCFunctionEntryHash::transparent_key_equal::operator()(
    const RPCFunctionEntry& lhs, std::size_t rhs) const noexcept {
  return xxh3::hash64(lhs.name()) == rhs;
}

inline bool RPCFunctionEntryHash::transparent_key_equal::operator()(
    const RPCFunctionEntry& lhs, std::string_view rhs) const noexcept {
  return lhs.name() == rhs;
}

inline bool RPCFunctionEntryHash::transparent_key_equal::operator()(
    std::size_t lhs, const RPCFunctionEntry& rhs) const noexcept {
  return xxh3::hash64(rhs.name()) == lhs;
}

inline bool RPCFunctionEntryHash::transparent_key_equal::operator()(
    std::string_view lhs, const RPCFunctionEntry& rhs) const noexcept {
  return rhs.name() == lhs;
}

inline std::size_t RPCFunctionEntryHash::operator()(
    const RPCFunctionEntry& x) const {
  return xxh3::hash64(x.name());
}

inline std::size_t RPCFunctionEntryHash::operator()(
    std::size_t nameHash) const {
  return nameHash;
}

inline std::size_t RPCFunctionEntryHash::operator()(
    std::string_view name) const {
  return xxh3::hash64(name);
}

template <RPCMemory M, RPCSupported T>
RPCArgEntry::RPCArgEntry(RPCArg<M, T> /* placeholder */)
    : destination(std::same_as<M, Host> ? Destination::Host
                                        : Destination::Device),
      valType(&typeid(T)),
      elementSize(sizeof(typename RPCDataTraits<T>::element_type)),
      align(alignof(typename RPCDataTraits<T>::element_type)),
      isRange(RPCDataTraits<T>::isRange) {}

template <RPCMemory M, RPCSupported T>
RPCArgEntry::RPCArgEntry(const RPCRet<M, T>& /* placeholder */)
    : RPCArgEntry(RPCArg<M, T>{}) {}

/// Create an RPCFunctionEntry
template <RPCCallable F>
RPCFunctionEntry::RPCFunctionEntry(F&& f, std::string name)
    : m_name(std::move(name)) {
  namespace ct = boost::callable_traits;
  namespace mp11 = boost::mp11;
  using arg_t = ct::args_t<F>;
  // Wrapping in a tuple then flattening turns a plain return type into a
  // single-element tuple.
  using ret_tup_t = mp11::mp_flatten<std::tuple<ct::return_type_t<F>>>;

  m_arguments.reserve(std::tuple_size_v<arg_t>);
  m_returnVals.reserve(std::tuple_size_v<ret_tup_t>);

  mp11::tuple_for_each(arg_t{},
                       [&args = m_arguments](auto a) { args.emplace_back(a); });
  mp11::tuple_for_each(ret_tup_t{}, [&rets = m_returnVals](const auto& r) {
    rets.emplace_back(r);
  });

  // Define the wrapper function.
  m_wrapper = [f = std::forward<F>(f)](
                  const std::vector<ClusterMessage::DataDescr>& argsVec)
      -> std::vector<RPCResultBuffer> {
    if (argsVec.size() != std::tuple_size_v<arg_t>) {
      throw std::logic_error(
          "RPC function called with incorrect number of arguments");
    }
    auto makeArgs = [&argsVec]<std::size_t I>(
                        mp11::mp_size_t<I>) -> std::tuple_element_t<I, arg_t> {
      using T = std::tuple_element_t<I, arg_t>;
      using E = typename T::element_type;
      const auto& desc = argsVec[I];
      constexpr auto destination = std::same_as<typename T::memory_type, Host>
                                       ? Destination::Host
                                       : Destination::Device;
      if (desc.dest != destination || desc.align < alignof(E) ||
          desc.len % sizeof(E) != 0 ||
          (!RPCDataTraits<typename T::value_type>::isRange &&
           desc.len != sizeof(E))) {
        throw std::logic_error(
            "Invalid RPC argument size, alignment or destination");
      }
      return T{.ptr = static_cast<E*>(desc.ptr), .size = desc.len / sizeof(E)};
    };
    arg_t args = mp11::tuple_transform(
        makeArgs, mp11::mp_apply<std::tuple,
                                 mp11::mp_iota_c<std::tuple_size_v<arg_t>>>{});

    ret_tup_t result = std::apply(f, args);

    std::vector<RPCResultBuffer> resultVec;
    resultVec.reserve(std::tuple_size_v<ret_tup_t>);
    mp11::tuple_for_each(result, [&resultVec](auto& p) {
      using R = std::remove_cvref_t<decltype(p)>;
      using E = typename R::element_type;
      if ((!RPCDataTraits<typename R::value_type>::isRange && p.size != 1) ||
          (p.size != 0 && p.ptr == nullptr) ||
          p.size > std::numeric_limits<std::size_t>::max() / sizeof(E)) {
        throw std::logic_error("Invalid RPC return buffer");
      }
      resultVec.push_back({p.ptr, p.size * sizeof(E), alignof(E),
                           std::move(p).takeOwnership()});
    });
    return resultVec;
  };
}

}  // namespace RemoteCall

#endif  // ATHENAMPIGPU_RPCFUNCTIONENTRY_ICC
