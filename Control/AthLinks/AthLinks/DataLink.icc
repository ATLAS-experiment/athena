#include "AthLinks/exceptions.h"
#include "SGTools/DataProxy_cast.h"
#include "AthenaKernel/proxyDictFromEventContext.h"


/**
 * @brief Return the CLID for the class that we reference.
 */
template <typename STORABLE>
inline
CLID DataLink<STORABLE>::classID()
{
  return ClassID_traits<value_type>::ID(); 
}


/**
 * @brief Default constructor --- gives the equivalent of a NULL pointer.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink()
{
}


/**
 * @brief Constructor --- link to a STORABLE using a transient ref to it.
 * @param data The object to which to link.
 * @param ctx Event context for this link.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(const_reference data, const EventContext& ctx/*= currentContext()*/)
  : DataLinkBase (&data, classID(), Atlas::proxyDictFromEventContext(ctx))
{
}


/**
 * @brief Constructor --- link to a STORABLE using a transient ref to it.
 * @param data The object to which to link.
 * @param sg Associated store; if nullptr, use the global default.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(const_reference data, IProxyDict* sg)
  : DataLinkBase (&data, classID(), sg)
{
}


/**
 * @brief Constructor --- link to a STORABLE using a transient pointer to it.
 * @param data The object to which to link.
 * @param ctx Event context for this link.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(const_pointer pdata, const EventContext& ctx/*= currentContext()*/)
  : DataLinkBase (pdata, classID(), Atlas::proxyDictFromEventContext(ctx))
{
}


/**
 * @brief Constructor --- link to a STORABLE using a transient pointer to it.
 * @param data The object to which to link.
 * @param sg Associated store; if nullptr, use the global default.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(const_pointer pdata, IProxyDict* sg)
  : DataLinkBase (pdata, classID(), sg)
{
}


/**
 * @brief Constructor --- link to a STORABLE using a string ID.
 * @param dataID Key of the object.
 * @param ctx Event context for this link.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(const ID_type& dataID,
                             const EventContext& ctx/*= currentContext()*/)
  : DataLinkBase (dataID, classID(), Atlas::proxyDictFromEventContext(ctx))
{
}


/**
 * @brief Constructor --- link to a STORABLE using a string ID.
 * @param dataID Key of the object.
 * @param sg Associated store; if nullptr, use the global default.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(const ID_type& dataID, IProxyDict* sg)
  : DataLinkBase (dataID, classID(), sg)
{
}


/**
 * @brief Constructor --- link to a STORABLE using a hashed ID.
 * @param key Hashed key of the object.
 * @param ctx Event context for this link.
 *
 * May throw @c ExcCLIDMismatch.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(sgkey_t key, const EventContext& ctx/*= currentContext()*/)
  : DataLinkBase (key, classID(), Atlas::proxyDictFromEventContext(ctx))
{
}


/**
 * @brief Constructor --- link to a STORABLE using a hashed ID.
 * @param key Hashed key of the object.
 * @param sg Associated store; if nullptr, use the global default.
 *
 * May throw @c ExcCLIDMismatch.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(sgkey_t key, IProxyDict* sg)
  : DataLinkBase (key, classID(), sg)
{
}


/**
 * @brief Constructor from a hashed key and a proxy holder object.
 *        Used internally for EL -> DL conversion.
 * @param key Hashed key of the object.
 * @param holder Internal holder object for the proxy.
 */
template <typename STORABLE>
inline
DataLink<STORABLE>::DataLink(sgkey_t key, const SG::DataProxyHolder& holder)
  : DataLinkBase (key, holder)
{
}


/**
 * @brief Set the link to an object given by a reference.
 * @param data The object to which to link.
 * @param ctx Event context for this link.
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toStorableObject(const_reference data,
                                          const EventContext& ctx/*= currentContext()*/)
{
  DataLinkBase::toStorableObject (&data, classID(), Atlas::proxyDictFromEventContext(ctx));
}


/**
 * @brief Set the link to an object given by a reference.
 * @param data The object to which to link.
 * @param sg Associated store.
 *
 * If @c sg is nullptr, then we take the store from whatever the link's currently
 * set to.  If the link has no current store, then we take the global
 * default.
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toStorableObject(const_reference data, IProxyDict* sg)
{
  DataLinkBase::toStorableObject (&data, classID(), sg);
}


/**
 * @brief Set the link to an object given by a string key.
 * @param dataID Key of the object.
 * @param ctx Event context for this link.
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toIdentifiedObject(const ID_type& dataID,
                                            const EventContext& ctx/*= currentContext()*/)
{
  DataLinkBase::toIdentifiedObject (dataID, classID(), Atlas::proxyDictFromEventContext(ctx));
}


/**
 * @brief Set the link to an object given by a string key.
 * @param dataID Key of the object.
 * @param sg Associated store.
 *
 * If @c sg is nullptr, then we take the store from whatever the link's currently
 * set to.  If the link has no current store, then we take the global
 * default.
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toIdentifiedObject(const ID_type& dataID,
                                            IProxyDict* sg)
{
  DataLinkBase::toIdentifiedObject (dataID, classID(), sg);
}


/**
 * @brief Set the link to an object given by a hashed key.
 * @param key Hashed key of the object.
 * @param ctx Event context for this link.
 *
 * May throw @c ExcCLIDMismatch.
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toIdentifiedObject(sgkey_t key,
                                            const EventContext& ctx/*= currentContext()*/)
{
  DataLinkBase::toIdentifiedObject (key, classID(), Atlas::proxyDictFromEventContext(ctx));
}


/**
 * @brief Set the link to an object given by a hashed key.
 * @param key Hashed key of the object.
 * @param sg Associated store.
 *
 * If @c sg is nullptr, then we take the store from whatever the link's currently
 * set to.  If the link has no current store, then we take the global
 * default.
 *
 * May throw @c ExcCLIDMismatch.
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toIdentifiedObject(sgkey_t key, IProxyDict* sg)
{
  DataLinkBase::toIdentifiedObject (key, classID(), sg);
}


/**
 * @brief Set the link to the default object of this type.
 * @param ctx Event context for this link.
 *
 * Note that this is _not_ the same as clearing the link
 * (use @c clear for that).  This produces a link that will resolve
 * to any object in SG of the given type, provided that there is only
 * one of them.  (An attempt to dereference an ambiguous default link
 * will give an error.)
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toDefaultObject (const EventContext& ctx/*= currentContext()*/)
{
  DataLinkBase::toIdentifiedObject (SG::DEFAULTKEY, classID(),
                                    Atlas::proxyDictFromEventContext(ctx));
}


/**
 * @brief Set the link to the default object of this type.
 * @param sg Associated store.
 *
 * If @c sg is nullptr, then we take the store from whatever the link's currently
 * set to.  If the link has no current store, then we take the global
 * default.
 *
 * Note that this is _not_ the same as clearing the link
 * (use @c clear for that).  This produces a link that will resolve
 * to any object in SG of the given type, provided that there is only
 * one of them.  (An attempt to dereference an ambiguous default link
 * will give an error.)
 */
template <typename STORABLE>
inline
void DataLink<STORABLE>::toDefaultObject (IProxyDict* sg)
{
  DataLinkBase::toIdentifiedObject (SG::DEFAULTKEY, classID(), sg);
}


/**
 * @brief Finish initialization after link has been read.
 * @param ctx Event context for this link.
 *
 * This should be called after a link has been read by root
 * in order to set the proxy pointer.
 * Returns true.
 */
template <typename STORABLE>
inline
bool DataLink<STORABLE>::toTransient (const EventContext& ctx/*= currentContext()*/)
{
  return DataLinkBase::toTransient (Atlas::proxyDictFromEventContext(ctx));
}


/**
 * @brief Finish initialization after link has been read.
 * @param sg Associated store.
 *
 * This should be called after a link has been read by root
 * in order to set the proxy pointer.
 * Returns true.
 *
 * If @c sg is nullptr, then we use the global default store.
 */
template <typename STORABLE>
inline
bool DataLink<STORABLE>::toTransient (IProxyDict* sg)
{
  return DataLinkBase::toTransient (sg);
}


/**
 * @brief Finish initialization like the link as just been read from root,
 *        but with a specified key.
 * @param dataID Key of the object.
 * @param ctx Event context for this link.
 *
 * The link should be clear before this is called.
 * Returns true.
 */
template <typename STORABLE>
inline
bool DataLink<STORABLE>::toTransient (const ID_type& dataID,
                                      const EventContext& ctx/*= currentContext()*/)
{
  return DataLinkBase::toTransient (dataID, classID(), Atlas::proxyDictFromEventContext(ctx));
}


/**
 * @brief Finish initialization like the link as just been read from root,
 *        but with a specified key.
 * @param dataID Key of the object.
 * @param sg Associated store.
 *
 * The link should be clear before this is called.
 * Returns true.
 *
 * If @c sg is nullptr, then we use the global default store.
 */
template <typename STORABLE>
inline
bool DataLink<STORABLE>::toTransient (const ID_type& dataID, IProxyDict* sg)
{
  return DataLinkBase::toTransient (dataID, classID(), sg);
}


/**
 * @brief Return a pointer to the currently-referenced object.
 * @return A pointer to an object of the type given by @a clid,
 *         or null on a failure (or if the reference is null).
 */
template <typename STORABLE>
inline
typename DataLink<STORABLE>::const_pointer
DataLink<STORABLE>::getDataPtr() const
{
  return reinterpret_cast<const_pointer> (this->storable());
}   	


/**
 * @brief Return a pointer to the currently-referenced object.
 * @return A pointer to an object of the type given by @a clid,
 *         or null on a failure (or if the reference is null).
 */
template <typename STORABLE>
inline
typename DataLink<STORABLE>::pointer
DataLink<STORABLE>::getDataNonConstPtr()
{
  return reinterpret_cast<pointer> (this->storableNonConst());
}   	


/**
 * @brief Dereference the link.
 */
template< typename STORABLE>
inline
typename DataLink< STORABLE >::const_reference
DataLink< STORABLE >::operator* () const
{
  const_pointer p = this->getDataPtr();
  if (!p)
    throwInvalidLink();
  return *p;
}


/**
 * @brief Dereference the link.
 */
template< typename STORABLE>
inline
typename DataLink< STORABLE >::const_pointer
DataLink< STORABLE >::operator->() const
{
   return this->getDataPtr();
}


/**
 * @brief Dereference the link.
 */
template< typename STORABLE>
inline
DataLink<STORABLE>::operator const_pointer() const
{
  return cptr();
}


/**
 * @brief Dereference the link.
 */
template< typename STORABLE>
inline
typename DataLink< STORABLE >::const_pointer
DataLink< STORABLE >::cptr() const
{
   return this->getDataPtr();
}


/**
 * @brief Test to see if the link is dereferencable.
 */
template <typename STORABLE>
inline
bool 
DataLink<STORABLE>::isValid() const
{
  return 0 != getDataPtr();
}


/**
 * @brief True if the link is not dereferencable.
 */
template <typename STORABLE>
inline
bool DataLink<STORABLE>::operator!() const
{
  return !isValid();
}


/**
 * @brief Return a (void) pointer to the currently-referenced object.
 * @return A pointer to an object of the type given by @a clid,
 *         or null on a failure (or if the reference is null).
 */
template <typename STORABLE>
inline
const void* DataLink<STORABLE>::storable() const
{
  typedef STORABLE* fn_t (SG::DataProxy*);
  fn_t* fn = &SG::DataProxy_cast<STORABLE>;
  return this->storableBase (reinterpret_cast<castfn_t*> (fn), classID(), true);
}


/**
 * @brief Return a (void) pointer to the currently-referenced object.
 * @return A pointer to an object of the type given by @a clid,
 *         or null on a failure (or if the reference is null).
 */
template <typename STORABLE>
inline
void* DataLink<STORABLE>::storableNonConst()
{
  typedef STORABLE* fn_t (SG::DataProxy*);
  fn_t* fn = &SG::DataProxy_cast<STORABLE>;
  return this->storableBase (reinterpret_cast<castfn_t*> (fn), classID(), false);
}


namespace SG {


/*
 * @brief Do post-read processing for DataLink dl.
 * @param dl The DataLink that was just read.
 * @param ctx The current event context.
 */
template <class STORABLE>
inline
void ToTransient<DataLink<STORABLE> >::toTransient (DataLink<STORABLE>& dl,
                                                    const EventContext& ctx/*= currentContext()*/)
{
  toTransient (dl, Atlas::proxyDictFromEventContext (ctx));
}


/*
 * @brief Do post-read processing for DataLink dl.
 * @param dl The DataLink that was just read.
 * @param sg The current event store.
 */
template <class STORABLE>
void ToTransient<DataLink<STORABLE> >::toTransient (DataLink<STORABLE>& dl, IProxyDict* sg)
{
  dl.toTransient (sg);
}


/*
 * @brief Do post-read processing for vector of DataLinks dlv.
 * @param dlv The vector of DataLinks that was just read.
 * @param ctx The current event context.
 */
template <class STORABLE, class ALLOC>
void ToTransient<std::vector<DataLink<STORABLE>, ALLOC> >::toTransient
  (std::vector<DataLink<STORABLE>, ALLOC>& dlv, const EventContext& ctx/*= currentContext()*/)
{
  toTransient (dlv, Atlas::proxyDictFromEventContext (ctx));
}


/*
 * @brief Do post-read processing for vector of DataLinks dlv.
 * @param dlv The vector of DataLinks that was just read.
 * @param sg The current event store.
 */
template <class STORABLE, class ALLOC>
void ToTransient<std::vector<DataLink<STORABLE>, ALLOC> >::toTransient
  (std::vector<DataLink<STORABLE>, ALLOC>& dlv, IProxyDict* sg)
{
  for (auto& dl : dlv) {
    dl.toTransient (sg);
  }
}


/*
 * @brief Do post-read processing for vector of vectors of DataLinks dlvv.
 * @param dlvv The vector of vectors of DataLinks that was just read.
 * @param ctx The current event context.
 */
template <class STORABLE, class ALLOC1, class ALLOC2>
void ToTransient<std::vector<std::vector<DataLink<STORABLE>, ALLOC1>, ALLOC2> >::toTransient
  (std::vector<std::vector<DataLink<STORABLE>, ALLOC1>, ALLOC2 >& dlvv, const EventContext& ctx/*= currentContext()*/)
{
  toTransient (dlvv, Atlas::proxyDictFromEventContext (ctx));
}


/*
 * @brief Do post-read processing for vector of vectors of DataLinks dlvv.
 * @param dlvv The vector of vectors of DataLinks that was just read.
 * @param sg The current event store.
 */
template <class STORABLE, class ALLOC1, class ALLOC2>
void ToTransient<std::vector<std::vector<DataLink<STORABLE>, ALLOC1>, ALLOC2> >::toTransient
  (std::vector<std::vector<DataLink<STORABLE>, ALLOC1>, ALLOC2>& dlvv, IProxyDict* sg)
{
  for (auto& dlv : dlvv) {
    ToTransient<std::vector<DataLink<STORABLE>, ALLOC1> >::toTransient (dlv, sg);
  }
}


} // namespace SG
