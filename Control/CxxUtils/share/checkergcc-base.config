# Copyright (C) 2002-2025 CERN for the benefit of the ATLAS collaboration
#
# Configuration file for the checkergcc plugins.
#    see https://gitlab.cern.ch/atlas/atlasexternals/tree/master/External/CheckerGccPlugins
#
# This file contains the default checkergcc settings. They are extended via the additional
# *.config files in this directory.
#

[thread.check_paths]
# Hack: disable checking of auto-generated Cint dictionaries:
-CMakeFiles

[thread.thread_safe_calls]
# Don't warn about calls to unchecked code for paths containing any
# of these strings.
/Gaudi
/rootsys/
/ROOT/
/CORAL
/COOL
/CLHEP
/GeoModelKernel
/GeoModelRead
/GeoModelTools
/GeoGenericFunctions
/ExpressionEvaluator
/GeoModelXml
/GeoModelHelpers
/GeoModelIO
include/Acts
/MCUtils
/HepMC
/HepPDT
/QtCore/
/eformat
/Geant
/tdaq
/yampl
/lwtnn
/fastjet
/fmt/
/gsl/
/tbb/
/nlohmann/
/include/python3.
/onnxruntime
/lhapdf
/googletest
/l1topo2a-vae
/CrestApi
/itksw
/vecmem
/chai


[thread.init_methods]
# Allow overriding these methods with inconsistent threading attributes.
Gaudi::Algorithm::stop
Gaudi::Algorithm::start
Gaudi::Algorithm::initialize
Converter::initialize
Converter::finalize
IStateful::initialize
Service::initialize
Service::start
Service::stop
AlgTool::initialize
AlgTool::start
AlgTool::stop
IAlgTool::initialize
Gaudi::Algorithm::finalize
Service::finalize
AlgTool::finalize
MinimalEventLoopMgr::initialize
MinimalEventLoopMgr::finalize
T_AthenaPoolCustCnv::initialize

[naming.check_paths]
# Paths under which to check naming conventions.
AtlasGeometryCommon
AtlasTest
Calorimeter
Commission
Control
Database
DataQuality
DetectorDescription
Event
External/CheckerGccPlugins
ForwardDetectors
Generators
graphics
HighGranularityTimingDetector
HLT
InnerDetector
LArCalorimeter
LumiBlock
MagneticField
MuonSpectrometer
PhysicsAnalysis
Reconstruction
Simulation
TestBeam
TileCalorimeter
Tools
Tracking
Trigger
# Don't trigger on MagneticField component of acts.
-acts/Core/src/MagneticField

# Don't check headers from rivet (prevent Tools above from matching Rivet/tools)
-Rivet


[callcheck.event_context_name]
# Name of the EventContext class.
EventContext

[callcheck.functions]
# List of signatures to warn about if used when an EventContext is available.
# The category in front tells where the EventContext parameter should be
# inserted for the suggested fix.
#  APPEND: At the end of the parameter list.
#  PREFIX: At the start of the parameter list.
#  INSERT: Parameter list was empty; insert an EventContext parameter.
#  CURCTX: This is a function to retrieve the current context.
#          The entire call should be replaced with the context.
#  RNG: Special case for ATHRNG::RNGWrapper.
APPEND SG::ReadHandle<>::ReadHandle(const SG::ReadHandleKey<>&)
APPEND SG::makeHandle(const SG::ReadHandleKey<>&)
APPEND SG::WriteHandle<>::WriteHandle(const SG::WriteHandleKey<>&)
APPEND SG::makeHandle(const SG::WriteHandleKey<>&)
APPEND SG::UpdateHandle<>::UpdateHandle(const SG::UpdateHandleKey<>&)
APPEND SG::makeHandle(const SG::UpdateHandleKey<>&)
APPEND SG::ReadCondHandle<>::ReadCondHandle(const SG::ReadCondHandleKey<>&)
APPEND SG::WriteCondHandle<>::WriteCondHandle(const SG::WriteCondHandleKey<>&)
APPEND SG::ReadDecorHandle<>::ReadDecorHandle(const SG::ReadDecorHandleKey<>&)
APPEND SG::makeHandle(const SG::ReadDecorHandleKey<>&)
APPEND SG::WriteDecorHandle<>::WriteDecorHandle(const SG::WriteDecorHandleKey<>&)
APPEND SG::makeHandle(const SG::WriteDecorHandleKey<>&)
APPEND SG::ReadMetaHandle<>::ReadMetaHandle(const SG::ReadMetaHandleKey<>&)
APPEND SG::WriteMetaHandle<>::WriteMetaHandle(const SG::WriteMetaHandleKey<>&)
INSERT SG::HandleKeyArray<>::makeHandles() const
PREFIX ICoreDumpSvc::setCoreDumpInfo(const std::string&, const std::string&)
APPEND IDecisionSvc::isEventAccepted(const std::string&) const
INSERT Athena::IRCUObject::quiescent()
INSERT Athena::RCUObject<>::readerQuiesce()
INSERT Athena::RCUObject<>::updater()
APPEND Athena::RCUReadQuiesce<>::RCUReadQuiesce(Athena::RCUObject<>&)
APPEND Athena::RCUUpdate<>::RCUUpdate(Athena::RCUObject<>&)
INSERT SG::SlotSpecificObj<>::get()
INSERT SG::SlotSpecificObj<>::get() const
INSERT Athena::Timeout::instance()
INSERT Atlas::proxyDictFromEventContext()
INSERT Atlas::sourceIDFromEventContext()
CURCTX Gaudi::Hive::currentContext()
RNG    ATHRNG::RNGWrapper::operator CLHEP::HepRandomEngine*() const
