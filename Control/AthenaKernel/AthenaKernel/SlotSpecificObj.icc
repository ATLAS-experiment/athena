/**
 * @file AthenaKernel/SlotSpecificObj.icc
 * @author scott snyder <snyder@bnl.gov>
 * @date Jul, 2017
 * @brief Maintain a set of objects, one per slot.
 */


namespace SG {


/**
 * @brief Constructor.
 *
 * The number of slots will be found by calling @c getNSlots().
 */
template <class T, InvalidSlot S>
inline
SlotSpecificObj<T, S>::SlotSpecificObj()
  : SlotSpecificObj (getNSlots())
{
}


/**
 * @brief Constructor, with number of slots specified explicitly.
 * @param nslots The number of event slots.
 */
template <class T, InvalidSlot S>
inline
SlotSpecificObj<T, S>::SlotSpecificObj (size_t nslots)
  : m_slots (S==InvalidSlot::Disabled ? nslots : nslots+1)
{
}


/**
 * @brief Return pointer to the object for slot given by @c ctx.
 * @param ctx Event context giving the desired slot.
 */
template <class T, InvalidSlot S>
inline
T* SlotSpecificObj<T, S>::get (const EventContext& ctx)
{
  if constexpr (S==InvalidSlot::Disabled) {
    return &m_slots.at(ctx.slot());
  }
  else {
    return ctx.valid() ? &m_slots.at(ctx.slot()) : &m_slots.back();
  }
}


/**
 * @brief Return pointer to the object for the current slot.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
inline
T* SlotSpecificObj<T, S>::get()
{
  return get (Gaudi::Hive::currentContext());
}


/**
 * @brief Return pointer to the object for slot given by @c ctx.
 * @param ctx Event context giving the desired slot.
 */
template <class T, InvalidSlot S>
inline
const T* SlotSpecificObj<T, S>::get (const EventContext& ctx) const
{
  if constexpr (S==InvalidSlot::Disabled) {
    return &m_slots.at(ctx.slot());
  }
  else {
    return ctx.valid() ? &m_slots.at(ctx.slot()) : &m_slots.back();
  }
}


/**
 * @brief Return pointer to the object for the current slot.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
inline
const T* SlotSpecificObj<T, S>::get() const
{
  return get (Gaudi::Hive::currentContext());
}


/**
 * @brief Dereference the pointer.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
inline
T& SlotSpecificObj<T, S>::operator* ()
{
  return *get();
}


/**
 * @brief Dereference the pointer.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
inline
const T& SlotSpecificObj<T, S>::operator* () const
{
  return *get();
}


/**
 * @brief Dereference the pointer.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
inline
T* SlotSpecificObj<T, S>::operator-> ()
{
  return get();
}


/**
 * @brief Dereference the pointer.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
inline
const T* SlotSpecificObj<T, S>::operator-> () const
{
  return get();
}

  
/**
 * @brief Begin iterator.
 */
template <class T, InvalidSlot S>
inline
typename SlotSpecificObj<T, S>::iterator SlotSpecificObj<T, S>::begin()
{
  return m_slots.begin();
}


/**
 * @brief Const begin iterator.
 */
template <class T, InvalidSlot S>
inline
typename SlotSpecificObj<T, S>::const_iterator SlotSpecificObj<T, S>::begin() const
{
  return m_slots.begin();
}


/**
 * @brief End iterator.
 */
template <class T, InvalidSlot S>
inline
typename SlotSpecificObj<T, S>::iterator SlotSpecificObj<T, S>::end()
{
  return m_slots.end();
}


/**
 * @brief Const end iterator.
 */
template <class T, InvalidSlot S>
inline
typename SlotSpecificObj<T, S>::const_iterator SlotSpecificObj<T, S>::end() const
{
  return m_slots.end();
}


} // namespace SG
