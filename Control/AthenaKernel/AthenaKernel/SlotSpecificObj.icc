/**
 * @file AthenaKernel/SlotSpecificObj.icc
 * @author scott snyder <snyder@bnl.gov>
 * @date Jul, 2017
 * @brief Maintain a set of objects, one per slot.
 */


namespace SG {


/**
 * @brief Constructor.
 *
 * The number of slots will be found by calling @c getNSlots().
 */
template <class T, InvalidSlot S>
inline
SlotSpecificObj<T, S>::SlotSpecificObj()
  : SlotSpecificObj (getNSlots())
{
}


/**
 * @brief Constructor, with number of slots specified explicitly.
 * @param nslots The number of event slots.
 */
template <class T, InvalidSlot S>
inline
SlotSpecificObj<T, S>::SlotSpecificObj (size_t nslots)
  : m_slots (S==InvalidSlot::Disabled ? nslots : nslots+1)
{
}


/**
 * @brief Return pointer to the object for slot given by @c ctx.
 * @param ctx Event context giving the desired slot.
 */
template <class T, InvalidSlot S>
template <class Self>
inline
auto* SlotSpecificObj<T, S>::get (this Self&& self, const EventContext& ctx)
{
  if constexpr (S==InvalidSlot::Disabled) {
    return &self.m_slots.at(ctx.slot());
  }
  else {
    return ctx.valid() ? &self.m_slots.at(ctx.slot()) : &self.m_slots.back();
  }
}


/**
 * @brief Return pointer to the object for the current slot.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
template <class Self>
inline
auto* SlotSpecificObj<T, S>::get(this Self&& self)
{
  return self.get (Gaudi::Hive::currentContext());
}


/**
 * @brief Dereference the pointer.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
template <class Self>
inline
auto& SlotSpecificObj<T, S>::operator* (this Self&& self)
{
  return *self.get();
}


/**
 * @brief Dereference the pointer.
 *
 * The slot number is found by retrieving the global current context.
 */
template <class T, InvalidSlot S>
template <class Self>
inline
auto* SlotSpecificObj<T, S>::operator-> (this Self&& self)
{
  return self.get();
}


/**
 * @brief Begin iterator.
 */
template <class T, InvalidSlot S>
template <class Self>
inline
auto SlotSpecificObj<T, S>::begin(this Self&& self)
{
  return self.m_slots.begin();
}


/**
 * @brief End iterator.
 */
template <class T, InvalidSlot S>
template <class Self>
inline
auto SlotSpecificObj<T, S>::end(this Self&& self)
{
  return self.m_slots.end();
}


} // namespace SG
