    dir Sim {
      dir detail {
       algorithm = GatherData
        dir L1Topo {
          dir Multiplicities {
           output = L1Calo/Developer/Sim/detail/L1Topo/Multiplicities
            hist Topo1Opt0_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
            hist Topo1Opt1_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
            hist Topo1Opt2_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
            hist Topo1Opt3_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
          }
          dir Algos {
           output = L1Calo/Developer/Sim/detail/L1Topo/Algos
            hist L1TopoAlgo_2a {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
            hist L1TopoAlgo_2b {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
            hist L1TopoAlgo_3a {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
            hist L1TopoAlgo_3b {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry
              display = SetPalette(55)
            }
          }
        }
      }
    }
    dir EfexInputMonAlg {
     output = L1Calo/Developer/EfexInputMonAlg
      hist h_errors_entries {
      }
    }
    dir JfexInputMonAlg {
     output = L1Calo/Developer/JfexInputMonAlg
      hist h_errors_entries {
      }
      hist h_saturated {
      }
      hist h_invalidCodes {
      }
      hist h_emptyCodes {
      }
    }
    dir GfexInputMonAlg {
     output = L1Calo/Developer/GfexInputMonAlg
      hist h_errors_entries {
      }
      hist h_HotTower_HeatMap {
      }
      hist h_ColdTower_HeatMap {
      }
      hist h_TowerEt {
      }
      hist h_SaturatedTower_HeatMap {
      }
    }
  }
  dir Expert {
    dir ByteStreamDecoders {
     output = L1Calo/Expert/ByteStreamDecoders
