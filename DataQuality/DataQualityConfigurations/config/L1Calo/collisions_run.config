        hist h_jTau_EtaPhiMap_Pt10 {
          algorithm = Jfex_etaPhiMapFilled_TAU
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjTauh_jTau_EtaPhiMap_Pt10">Help</a>
          display = SetPalette(87)
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jTau/detail
          hist h_jTau_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jTau_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjTaudetailh_jTau_posVsLBN">Help</a>
          }
          hist h_jTau_posVsLBN_Pt10 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jTau_EtaPhiMap_Pt10'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjTaudetailh_jTau_posVsLBN_Pt10">Help</a>
          }
        }
      }
      dir jEM {
       output = L1Calo/Expert/Outputs/jEM
        hist h_jEM_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled_EM
          description = Bins with negative number of entries (in the FCAL and central region) signify that no TOBs can be produced at that position. Inspect for hot/cold spots, note that there are no jEM TOBs for |eta| < 2.3 - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMh_jEM_EtaPhiMap">Help</a>
          display = SetPalette(87),Draw=COL1Z
        }
        hist h_jEM_EtaPhiMap_Pt10 {
          algorithm = Jfex_etaPhiMapFilled_EM
          description = Bins with negative number of entries (in the FCAL and central region) signify that no TOBs can be produced at that position. Inspect for hot/cold spots, note that there are no jEM TOBs for |eta| < 2.3 - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMh_jEM_EtaPhiMap_Pt10">Help</a>
          display = SetPalette(87),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jEM/detail
          hist h_jEM_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jEM_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMdetailh_jEM_posVsLBN">Help</a>
          }
          hist h_jEM_posVsLBN_Pt10 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jEM_EtaPhiMap_Pt10'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMdetailh_jEM_posVsLBN_Pt10">Help</a>
          }
        }
      }
      dir gLJ {
       output = L1Calo/Expert/Outputs/gLJ
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt0 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt0_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJh_etaphiMapL1_gFexLRJetRoI_CutPt0">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/gLJ/detail
          hist h_L1_gFexLRJetRoI_CutPt0_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt0'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJdetailh_L1_gFexLRJetRoI_CutPt0_posVsLBN">Help</a>
          }
          hist h_L1_gFexLRJetRoI_CutPt30_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt30'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJdetailh_L1_gFexLRJetRoI_CutPt30_posVsLBN">Help</a>
          }
          hist h_L1_gFexLRJetRoI_CutPt400_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt400'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJdetailh_L1_gFexLRJetRoI_CutPt400_posVsLBN">Help</a>
          }
        }
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt30 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt30_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJh_etaphiMapL1_gFexLRJetRoI_CutPt30">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt400 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt400_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJh_etaphiMapL1_gFexLRJetRoI_CutPt400">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
      dir gJ {
       output = L1Calo/Expert/Outputs/gJ
        hist h_etaphiMapL1_gFexSRJetRoI_CutPt0 {
          algorithm = Gfex_etaPhiMapFilled_gJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexSRJetRoI_CutPt0_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJh_etaphiMapL1_gFexSRJetRoI_CutPt0">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/gJ/detail
          hist h_L1_gFexSRJetRoI_CutPt0_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexSRJetRoI_CutPt0'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJdetailh_L1_gFexSRJetRoI_CutPt0_posVsLBN">Help</a>
          }
          hist h_L1_gFexSRJetRoI_CutPt100_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexSRJetRoI_CutPt100'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJdetailh_L1_gFexSRJetRoI_CutPt100_posVsLBN">Help</a>
          }
        }
        hist h_etaphiMapL1_gFexSRJetRoI_CutPt100 {
          algorithm = Gfex_etaPhiMapFilled_gJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexSRJetRoI_CutPt100_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJh_etaphiMapL1_gFexSRJetRoI_CutPt100">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
    }
    dir Efficiency {
      dir gFEX {
        dir MuonReferenceTrigger {
         output = L1Calo/Expert/Efficiency/gFEX/MuonReferenceTrigger
          hist SRpt_L1_gJ20p0ETA25 {
            algorithm = JetEfficiency_L1_gJ20p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gJ20p0ETA25">Help</a>
          }
          hist SRpt_L1_gJ50p0ETA25 {
            algorithm = JetEfficiency_L1_gJ50p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gJ50p0ETA25">Help</a>
          }
          hist SRpt_L1_gJ100p0ETA25 {
            algorithm = JetEfficiency_L1_gJ100p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gJ100p0ETA25">Help</a>
          }
          hist SRpt_L1_gJ400p0ETA25 {
            algorithm = JetEfficiency_L1_gJ400p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gJ400p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ80p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ80p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ80p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ100p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ100p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ100p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ140p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ140p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ140p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ160p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ160p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ160p0ETA25">Help</a>
          }
        }
      }
      dir jFEX {
        dir MuonReferenceTrigger {
         output = L1Calo/Expert/Efficiency/jFEX/MuonReferenceTrigger
          hist SRpt_L1_jJ30 {
            algorithm = JetEfficiency_L1_jJ30
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ30">Help</a>
          }
          hist SRpt_L1_jJ40 {
            algorithm = JetEfficiency_L1_jJ40
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ40">Help</a>
          }
          hist SRpt_L1_jJ50 {
            algorithm = JetEfficiency_L1_jJ50
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ50">Help</a>
          }
          hist SRpt_L1_jJ60 {
            algorithm = JetEfficiency_L1_jJ60
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ60">Help</a>
          }
          hist SRpt_L1_jJ80 {
            algorithm = JetEfficiency_L1_jJ80
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ80">Help</a>
          }
          hist SRpt_L1_jJ90 {
            algorithm = JetEfficiency_L1_jJ90
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ90">Help</a>
          }
          hist SRpt_L1_jJ125 {
            algorithm = JetEfficiency_L1_jJ125
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ125">Help</a>
          }
          hist SRpt_L1_jJ140 {
            algorithm = JetEfficiency_L1_jJ140
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ140">Help</a>
          }
          hist SRpt_L1_jJ160 {
            algorithm = JetEfficiency_L1_jJ160
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ160">Help</a>
          }
          hist SRpt_L1_jJ180 {
            algorithm = JetEfficiency_L1_jJ180
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ180">Help</a>
          }
          hist LRpt_L1_SC111-CjJ40 {
            algorithm = JetEfficiency_L1_SC111-CjJ40
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerLRpt_L1_SC111-CjJ40">Help</a>
          }
        }
      }
    }
    dir Inputs {
      dir eFEX {
       output = L1Calo/Expert/Inputs/eFEX
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Inputs/eFEX/detail
          hist h_summary {
            description = TowerID format: '[E]EPPMMF', where E=eta index, P=phi index,M=module,F=fpga - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_summary">Help</a>
          }
          hist h_dataTowers_ecal_hot_posVsLBN {
            algorithm = Efex_ecal_hot_etaPhiLBMapOutliers
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_ecal_hot_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_ecal_hot_posVsLBN">Help</a>
          }
          hist h_dataTowers_ecal_cold_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_ecal_cold_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_ecal_cold_posVsLBN">Help</a>
          }
          hist h_dataTowers_hcal_hot_posVsLBN {
            algorithm = Efex_hcal_hot_etaPhiLBMapOutliers
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_hcal_hot_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_hcal_hot_posVsLBN">Help</a>
          }
          hist h_dataTowers_hcal_cold_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_hcal_cold_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_hcal_cold_posVsLBN">Help</a>
          }
        }
        hist h_errors {
          algorithm = Histogram_Empty
          description = Locations of any non-zero em or hadronic status flags. Check <a href='./detail/h_summary'>detail/h_summary</a> for more detail if there are entries - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_errors">Help</a>
        }
        hist h_dataTowers_ecal_hot_EtaPhiMap {
          algorithm = Efex_ecal_hot_etaPhiMapOutliers
          description = Check <a href='./detail/h_dataTowers_ecal_hot_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_ecal_hot_EtaPhiMap">Help</a>
        }
        hist h_dataTowers_ecal_cold_EtaPhiMap {
          algorithm = Efex_ecal_cold_etaPhiMapOutliers
          description = Check <a href='./detail/h_dataTowers_ecal_cold_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_ecal_cold_EtaPhiMap">Help</a>
        }
        hist h_dataTowers_hcal_hot_EtaPhiMap {
          algorithm = Efex_hcal_hot_etaPhiMapOutliers
          description = Check <a href='./detail/h_dataTowers_hcal_hot_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_hcal_hot_EtaPhiMap">Help</a>
        }
        hist h_dataTowers_hcal_cold_EtaPhiMap {
          algorithm = Efex_hcal_cold_etaPhiMapOutliers
          description = Check <a href='./detail/h_dataTowers_hcal_cold_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_hcal_cold_EtaPhiMap">Help</a>
        }
      }
      dir gFEX {
       output = L1Calo/Expert/Inputs/gFEX
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Inputs/gFEX/detail
          hist h_LBN_vs_nGfexTowers {
            description = The y value gives the number of gTowers with Et > 10 GeV; the z value gives the number of events - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXdetailh_LBN_vs_nGfexTowers">Help</a>
          }
          hist h_HotTowers_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_HotTower_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXdetailh_HotTowers_posVsLBN">Help</a>
          }
          hist h_ColdTowers_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_ColdTower_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXdetailh_ColdTowers_posVsLBN">Help</a>
          }
        }
        hist h_HotTower_EtaPhiMap {
          algorithm = Gfex_Tower_etaPhiMapFilled
          description = Look for hot spots with unusual high statistics; Check <a href='./detail/h_HotTowers_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXh_HotTower_EtaPhiMap">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_ColdTower_EtaPhiMap {
          algorithm = Gfex_Tower_etaPhiMapFilled
          description = Look for cold spots with unusual high statistics; Check <a href='./detail/h_ColdTowers_posVsLBN'>detail plot</a> to get timeseries for each location  - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXh_ColdTower_EtaPhiMap">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
    }
  }
}
