          hist ppm_had_2d_etaPhi_tt_lutCp_SimNoData {
            description = PPM LUT-CP HAD Simulation but no Data - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutCp_SimNoData">Help</a>
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutCp_DataNoSim {
            description = PPM LUT-CP HAD Data but no Simulation - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutCp_DataNoSim">Help</a>
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimEqData {
            description = PPM LUT-JEP HAD Data/Simulation Non-zero Matches - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutJep_SimEqData">Help</a>
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimNeData {
            description = PPM LUT-JEP HAD Data/Simulation Non-zero Mismatches - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutJep_SimNeData">Help</a>
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimNoData {
            description = PPM LUT-JEP HAD Simulation but no Data - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutJep_SimNoData">Help</a>
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_DataNoSim {
            description = PPM LUT-JEP HAD Data but no Simulation - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutJep_DataNoSim">Help</a>
            algorithm = GatherData
          }
        }
        hist ppm_2d_LUT_MismatchEvents_cr0cr1 {
          display = SetGridx,SetGridy
