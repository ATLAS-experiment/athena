            description = #eta - #phi map of HAD LUT-JEP > 5 GeV - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexOutputsdetailppm_had_2d_etaPhi_tt_lutjep_Threshold03">Help</a>
