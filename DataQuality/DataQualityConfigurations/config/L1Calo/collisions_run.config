          }
          hist LRpt_L1_SC111-CjJ40 {
            algorithm = JetEfficiency_L1_SC111-CjJ40
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerLRpt_L1_SC111-CjJ40">Help</a>
          }
        }
      }
    }
    dir Inputs {
      dir eFEX {
       output = L1Calo/Expert/Inputs/eFEX
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Inputs/eFEX/detail
          hist h_summary {
            description = TowerID format: '[E]EPPMMF', where E=eta index, P=phi index,M=module,F=fpga - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_summary">Help</a>
          }
          hist h_dataTowers_ecal_hot_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_ecal_hot_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_ecal_hot_posVsLBN">Help</a>
          }
          hist h_dataTowers_ecal_cold_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_ecal_cold_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_ecal_cold_posVsLBN">Help</a>
          }
          hist h_dataTowers_hcal_hot_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_hcal_hot_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_hcal_hot_posVsLBN">Help</a>
          }
          hist h_dataTowers_hcal_cold_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_hcal_cold_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXdetailh_dataTowers_hcal_cold_posVsLBN">Help</a>
          }
        }
        hist h_errors {
          algorithm = Histogram_Empty
          description = Locations of any non-zero em or hadronic status flags. Check <a href='./detail/h_summary'>detail/h_summary</a> for more detail if there are entries - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_errors">Help</a>
        }
        hist h_dataTowers_ecal_hot_EtaPhiMap {
          algorithm = Efex_ecal_hot_etaThiMapFilled
          description = Check <a href='./detail/h_dataTowers_ecal_hot_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_ecal_hot_EtaPhiMap">Help</a>
        }
        hist h_dataTowers_ecal_cold_EtaPhiMap {
          description = Check <a href='./detail/h_dataTowers_ecal_cold_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_ecal_cold_EtaPhiMap">Help</a>
          algorithm = GatherData
        }
        hist h_dataTowers_hcal_hot_EtaPhiMap {
          algorithm = Efex_hcal_hot_etaThiMapFilled
          description = Check <a href='./detail/h_dataTowers_hcal_hot_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_hcal_hot_EtaPhiMap">Help</a>
        }
        hist h_dataTowers_hcal_cold_EtaPhiMap {
          description = Check <a href='./detail/h_dataTowers_hcal_cold_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputseFEXh_dataTowers_hcal_cold_EtaPhiMap">Help</a>
          algorithm = GatherData
        }
      }
      dir gFEX {
       output = L1Calo/Expert/Inputs/gFEX
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Inputs/gFEX/detail
          hist h_LBN_vs_nGfexTowers {
            description = The y value gives the number of gTowers with Et > 10 GeV; the z value gives the number of events - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXdetailh_LBN_vs_nGfexTowers">Help</a>
          }
          hist h_HotTowers_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_HotTower_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXdetailh_HotTowers_posVsLBN">Help</a>
          }
          hist h_ColdTowers_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_ColdTower_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXdetailh_ColdTowers_posVsLBN">Help</a>
          }
        }
        hist h_HotTower_EtaPhiMap {
          algorithm = Gfex_Tower_etaPhiMapFilled
          description = Look for hot spots with unusual high statistics; Check <a href='./detail/h_HotTowers_posVsLBN'>detail plot</a> to get timeseries for each location - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXh_HotTower_EtaPhiMap">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_ColdTower_EtaPhiMap {
          algorithm = Gfex_Tower_etaPhiMapFilled
          description = Look for cold spots with unusual high statistics; Check <a href='./detail/h_ColdTowers_posVsLBN'>detail plot</a> to get timeseries for each location  - <a href="https://codimd.web.cern.ch/s/678H65Tk9#InputsgFEXh_ColdTower_EtaPhiMap">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
    }
  }
}
#outputs
output top_level {
  output L1Calo {
    output Expert {
      output ByteStreamDecoders {
      }
      output Sim {
        output detail {
        }
      }
      output Outputs {
        output eEM {
          output detail {
          }
        }
        output eTAU {
          output detail {
          }
        }
        output jJ {
          output detail {
          }
        }
        output jTau {
          output detail {
          }
        }
        output jEM {
          output detail {
          }
        }
        output gLJ {
          output detail {
          }
        }
        output gJ {
          output detail {
          }
        }
      }
      output Efficiency {
        output gFEX {
          output MuonReferenceTrigger {
          }
        }
        output jFEX {
          output MuonReferenceTrigger {
          }
        }
      }
      output Inputs {
        output eFEX {
          output detail {
          }
        }
        output gFEX {
          output detail {
          }
        }
      }
    }
  }
}

#algorithms
algorithm AnyNonZeroBinIsError {
  # Use this algo if want error on any non-zero bin content
  libname = libdqm_summaries.so
  name = Bins_NotEqual_Threshold
  BinThreshold = 0.
  thresholds = th_AnyBinIsError
}

algorithm L1CaloMismatchRate {
  libname = libdqm_summaries.so
  name = Bins_GreaterThan_Threshold
  BinThreshold = 0.9
  thresholds = L1CaloMismatchRateThresholds
  }
algorithm Efex_eEM_etaThiMapFilled {
  libname = libdqm_summaries.so
  name = Bins_Equal_Threshold
  BinThreshold = 0.
  thresholds = Efex_eEM_etaThiMapFilledThresholds
  }
