          description = PPM LUT Mismatch Event Numbers. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationppm_2d_LUT_MismatchEvents_cr0cr1">Help</a>
        }
        hist ppm_2d_LUT_MismatchEvents_cr2cr3 {
          display = SetGridx,SetGridy
          algorithm = Histogram_Empty
          description = PPM LUT Mismatch Event Numbers. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationppm_2d_LUT_MismatchEvents_cr2cr3">Help</a>
        }
        hist ppm_2d_LUT_MismatchEvents_cr4cr5 {
          display = SetGridx,SetGridy
          algorithm = Histogram_Empty
          description = PPM LUT Mismatch Event Numbers. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationppm_2d_LUT_MismatchEvents_cr4cr5">Help</a>
        }
        hist ppm_2d_LUT_MismatchEvents_cr6cr7 {
          display = SetGridx,SetGridy
          algorithm = Histogram_Empty
          description = PPM LUT Mismatch Event Numbers. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationppm_2d_LUT_MismatchEvents_cr6cr7">Help</a>
        }
      }
      dir Overview {
       output = L1Calo/Expert/PpmTrex/Overview
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/PpmTrex/Overview/detail
          hist l1calo_1d_NumberOfEvents {
            description = Number of processed events. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexOverviewdetaill1calo_1d_NumberOfEvents">Help</a>
          }
          hist l1calo_1d_ErrorsByLumiblock {
