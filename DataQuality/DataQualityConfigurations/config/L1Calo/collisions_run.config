            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerLRpt_L1_jJ80">Help</a>
          }
          hist SRpt_L1_jJ90 {
            algorithm = JetEfficiency_L1_jJ90
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ90">Help</a>
          }
          hist LRpt_L1_jJ90 {
