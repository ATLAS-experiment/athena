          }
          hist ppm_had_2d_etaPhi_tt_lutcp_Threshold07 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-CP > 50 GeV/2
          }
          hist ppm_1d_tt_lutjep_LutPerBCN {
            description = Number of LUT-JEP > 5 GeV per BC.
          }
          hist ppm_had_2d_etaPhi_tt_lutjep_AverageEt {
            display = SetPalette(1),LogZ
            description = HAD Average LUT-JEP Et for Et > 5 GeV.
          }
          hist ppm_had_2d_etaPhi_tt_lutjep_Threshold01 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-JEP > 1 GeV
          }
          hist ppm_had_2d_etaPhi_tt_lutjep_Threshold02 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-JEP > 3 GeV
          }
          hist ppm_had_2d_etaPhi_tt_lutjep_Threshold03 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-JEP > 5 GeV
          }
          hist ppm_had_2d_etaPhi_tt_lutjep_Threshold04 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-JEP > 10 GeV
          }
          hist ppm_had_2d_etaPhi_tt_lutjep_Threshold06 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-JEP > 30 GeV
          }
          hist ppm_had_2d_etaPhi_tt_lutjep_Threshold07 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-JEP > 50 GeV
          }
        }
        hist ppm_had_1d_tt_lutcp_Eta {
          description = HAD LUT-CP: Distribution of peak in #eta.
          algorithm = GatherData
        }
        hist ppm_had_1d_tt_lutcp_Phi {
          description = HAD LUT-CP: Distribution of peak in #phi.
          algorithm = GatherData
        }
        hist ppm_had_1d_tt_lutcp_Et {
          display = LogX,LogY
          description = HAD LUT-CP: Distribution of peak.
          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_lutcp_Threshold00 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD LUT-CP > 0 GeV/2
          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_lutcp_Threshold05 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD LUT-CP > 20 GeV/2
          algorithm = GatherData
        }
        hist ppm_had_1d_tt_lutjep_Eta {
          description = HAD LUT-JEP: Distribution of peak in #eta.
          algorithm = GatherData
        }
        hist ppm_had_1d_tt_lutjep_Phi {
          description = HAD LUT-JEP: Distribution of peak in #phi.
          algorithm = GatherData
        }
        hist ppm_had_1d_tt_lutjep_Et {
          display = LogX,LogY
          description = HAD LUT-JEP: Distribution of peak.
          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_lutjep_Threshold00 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD LUT-JEP > 0 GeV
          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_lutjep_Threshold05 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD LUT-JEP > 20 GeV
          algorithm = GatherData
        }
      }
      dir Inputs {
       output = L1Calo/Expert/PpmTrex/Inputs
        hist ppm_had_2d_etaPhi_tt_adc_HitMap {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD FADC > {0} for triggered timeslice.
          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_adc_ProfileHitMap {
          display = SetPalette(1),LogZ
          description = #eta - #phi profile map of HAD FADC > {0} for triggered timeslice.
          algorithm = GatherData
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/PpmTrex/Inputs/detail
          hist ppm_had_1d_tt_adc_TriggeredSlice {
            display = LogY
            description = Number of the HAD triggered slice.
          }
          hist ppm_2d_tt_adc_BcidBits {
            description = PPM: PeakADC Vs. Bits of BCID Logic Word.
          }
          hist ppm_1d_tt_adc_HLCase {
            description = PPM: Sat80 thresholds passed by ADC[n-2.5] / ADC[n-1.5].
          }
          hist ppm_had_1d_tt_adc_SignalProfileTileEBC {
            description = Signal Shape Profile for TileEBC.
          }
          hist ppm_had_1d_tt_adc_SignalProfileTileLBC {
            description = Signal Shape Profile for TileLBC.
          }
          hist ppm_had_1d_tt_adc_SignalProfileTileLBA {
            description = Signal Shape Profile for TileLBA.
          }
          hist ppm_had_1d_tt_adc_SignalProfileTileEBA {
            description = Signal Shape Profile for TileEBA.
          }
          hist ppm_had_1d_tt_adc_SignalProfileLArHECA {
            description = Signal Shape Profile for LArHECA.
          }
          hist ppm_had_1d_tt_adc_SignalProfileLArFCAL23A {
            description = Signal Shape Profile for LArFCAL23A.
          }
        }
        hist ppm_had_1d_tt_adc_MaxTimeslice {
          display = SetPalette(1)
          description = HAD distribution of maximum timeslice.
          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_adc_MaxTimeslice {
          description = Average maximum timeslice for HAD signal (TS:1-15).
          algorithm = GatherData
        }
      }
      dir Errors {
       output = L1Calo/Expert/PpmTrex/Errors
