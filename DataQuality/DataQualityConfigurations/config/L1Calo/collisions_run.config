            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_peakf_DataNoSim {
            description = PPM Peakfinder Data but no Simulation - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationBcidSimppm_2d_etaPhi_tt_peakf_DataNoSim">Help</a>
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_peakf_SimNoData {
            description = PPM Peakfinder Simulation but no Data - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationBcidSimppm_2d_etaPhi_tt_peakf_SimNoData">Help</a>
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_NonZeroMatches {
            description = PPM SaturatedBCID Data/Simulation Non-Zero Matches - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationBcidSimppm_2d_etaPhi_tt_satBcid_NonZeroMatches">Help</a>
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_ZeroMatches {
            description = PPM SaturatedBCID Data/Simulation Zero Matches - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationBcidSimppm_2d_etaPhi_tt_satBcid_ZeroMatches">Help</a>
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_DataNoSim {
            description = PPM SaturatedBCID Data but no Simulation - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationBcidSimppm_2d_etaPhi_tt_satBcid_DataNoSim">Help</a>
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_SimNoData {
            description = PPM SaturatedBCID Simulation but no Data - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationBcidSimppm_2d_etaPhi_tt_satBcid_SimNoData">Help</a>
            algorithm = GatherData
          }
        }
        dir LutSim {
         output = L1Calo/Expert/PpmTrex/Simulation/LutSim
          hist ppm_had_2d_etaPhi_tt_lutCp_SimEqData {
            description = PPM LUT-CP HAD Data/Simulation Non-zero Matches - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutCp_SimEqData">Help</a>
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutCp_SimNeData {
            description = PPM LUT-CP HAD Data/Simulation Non-zero Mismatches - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexSimulationLutSimppm_had_2d_etaPhi_tt_lutCp_SimNeData">Help</a>
            algorithm = GatherData
