          }
        }
        hist ppm_had_1d_tt_adc_MaxTimeslice {
          display = SetPalette(1)
          description = HAD distribution of maximum timeslice. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexInputsppm_had_1d_tt_adc_MaxTimeslice">Help</a>
