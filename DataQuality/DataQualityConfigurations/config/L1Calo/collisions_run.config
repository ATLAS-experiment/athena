          hist ppm_1d_tt_lutcp_LutPerBCN {
            description = Number of LUT-CP > 5 GeV/2 per BC. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexOutputsdetailppm_1d_tt_lutcp_LutPerBCN">Help</a>
