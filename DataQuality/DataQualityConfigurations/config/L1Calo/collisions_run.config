          }
          hist LRpt_L1_jJ160 {
            algorithm = JetEfficiency_L1_jJ160
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerLRpt_L1_jJ160">Help</a>
          }
          hist SRpt_L1_jJ180 {
            algorithm = JetEfficiency_L1_jJ180
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ180">Help</a>
          }
          hist LRpt_L1_jJ180 {
            algorithm = JetEfficiency_L1_jJ180
