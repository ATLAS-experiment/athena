          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_lutjep_Threshold00 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD LUT-JEP > 0 GeV - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexOutputsppm_had_2d_etaPhi_tt_lutjep_Threshold00">Help</a>
          algorithm = GatherData
        }
        hist ppm_had_2d_etaPhi_tt_lutjep_Threshold05 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD LUT-JEP > 20 GeV - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexOutputsppm_had_2d_etaPhi_tt_lutjep_Threshold05">Help</a>
          algorithm = GatherData
        }
      }
      dir Inputs {
       output = L1Calo/Expert/PpmTrex/Inputs
        hist ppm_had_2d_etaPhi_tt_adc_HitMap {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of HAD FADC > {0} for triggered timeslice. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexInputsppm_had_2d_etaPhi_tt_adc_HitMap">Help</a>
          algorithm = GatherData
