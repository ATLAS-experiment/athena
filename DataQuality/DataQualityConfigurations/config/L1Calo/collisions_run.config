          display = SetPalette(55)
          description = Any really significant hot/cold spots (see results for significances) should check over what LBs they occurred, using <a href='./detail/h_L1_eEMRoI_HiPtCut_posVsLBN'>detail timeseries</a>. Any new (unknown) spots, if they occur multiple times in a week, please report<br>KnownDead : 49,41;49,42;48,8<br>KnownCold : 48,8;2,18;3,17;4,18;5,17;20,31;21,31;23,26;49,10;11,30;11,44;11,51;15,51;40,12;40,19;40,26;10,17;10,18;10,20;2,50;24,49;14,54;12,20;14,51;16,49;21,46;23,47;31,24;34,40;35,40;36,39;37,39;42,38;46,41;47,47;47,8<br>KnownWarm : 11,26;11,52;21,48;40,21;41,21;42,21;43,21;44,21;45,21;46,21;47,21;50,21<br>KnownHot : 4,5;6,2;13,48;21,48;14,49;27,53;35,13;22,14
          algorithm = Efex_eEM_etaThiMapFilled
        }
