      dir eTAU {
       output = L1Calo/Expert/Outputs/eTAU
        hist h_L1_eTauRoI_LowPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Any really significant hot/cold spots (see results for significances) should check over what LBs they occurred, using <a href='./detail/h_L1_eTauRoI_LowPtCut_posVsLBN'>detail timeseries</a>. Any new (unknown) spots, if they occur multiple times in a week, please report<br>KnownCold : 49,41;49,42;48,8;1,29;13,36;18,24;18,50;2,29;23,29;25,36;26,38;30,15;32,46;36,39;41,54;42,21;42,43;47,6;7,62;8,54;9,41;9,51;9,52;9,53;9,54;9,56;26,10;27,10;28,10;29,10;30,10;31,10;32,10;33,10;18,3;19,3;20,3;21,3;22,3;23,3;24,3;25,3;48,8;2,18;3,17;4,18;5,17;49,10;10,18;10,20;20,31;21,31;14,51;15,51;23,26;29,7;17,32;14,54;34,6;40,12;40,19;26,20;11,44;24,49;30,15;32,46;29,5;16,49;12,19;12,20;17,3;20,10;22,47;23,47;34,10;34,40;35,40;37,39;40,26;43,59;47,47;47,8<br>KnownWarm : 24,39;41,21;43,21;44,21;47,21<br>KnownHot : 4,5;6,2;11,27;13,48;15,49;21,48;40,24;42,35;18,4
