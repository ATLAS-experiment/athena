        }
      }
    }
    dir Sim {
     output = L1Calo/Expert/Sim
      dir detail {
       algorithm = GatherData
       output = L1Calo/Expert/Sim/detail
        hist h_simSummary {
          display = SetPalette(87),Draw=COLZTEXT
          description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simdetailh_simSummary">Help</a>
        }
        hist h_gJ_mismatches_posLbnMap {
          display = SetPalette(87)
          description = Location of mismatched gJ TOBs. Use this plot to identify any localized gFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simdetailh_gJ_mismatches_posLbnMap">Help</a>
        }
        hist h_gLJ_mismatches_posLbnMap {
          display = SetPalette(87)
          description = Location of mismatched gLJ TOBs. Use this plot to identify any localized gFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simdetailh_gLJ_mismatches_posLbnMap">Help</a>
        }
        dir L1Topo {
          dir Multiplicities {
           output = L1Calo/Expert/Sim/detail/L1Topo/Multiplicities
            hist Topo1Opt0_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoMultiplicitiesTopo1Opt0_mismatch">Help</a>
              display = SetPalette(55)
            }
            hist Topo1Opt1_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoMultiplicitiesTopo1Opt1_mismatch">Help</a>
              display = SetPalette(55)
            }
            hist Topo1Opt2_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoMultiplicitiesTopo1Opt2_mismatch">Help</a>
              display = SetPalette(55)
            }
            hist Topo1Opt3_mismatch {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hdw per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoMultiplicitiesTopo1Opt3_mismatch">Help</a>
              display = SetPalette(55)
            }
          }
          dir Algos {
           output = L1Calo/Expert/Sim/detail/L1Topo/Algos
            hist L1TopoAlgo_2a {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoAlgosL1TopoAlgo_2a">Help</a>
              display = SetPalette(55)
            }
            hist L1TopoAlgo_2b {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoAlgosL1TopoAlgo_2b">Help</a>
              display = SetPalette(55)
            }
            hist L1TopoAlgo_3a {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoAlgosL1TopoAlgo_3a">Help</a>
              display = SetPalette(55)
            }
            hist L1TopoAlgo_3b {
              algorithm = L1TopoMismatchCountVerticalRange
              description = Agreements and Mismatches between L1Topo Simulation and Hardware per L1Topo Item (x-axis). The upper row should be filled (Sim and Hdw agrees), while the lower two rows shouldn't have any entry - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimdetailL1TopoAlgosL1TopoAlgo_3b">Help</a>
              display = SetPalette(55)
            }
          }
        }
      }
      hist h_mismatched_SimReadyRate {
        algorithm = L1CaloMismatchRate
        description = Mismatch rate, per LB (x-axis), per signature (y-axis) for signatures that are deemed simulation-ready - should not be high rate (see DQ algo) - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simh_mismatched_SimReadyRate">Help</a>
        display = SetPalette(55)
      }
      hist h_eEM_mismatches_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eEM TOBs in simulation-ready events. Use this plot to identify any localized eFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simh_eEM_mismatches_posLbnMap">Help</a>
      }
      hist h_eTAU_mismatches_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eTAU TOBs in simulation-ready events. Use this plot to identify any localized eFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simh_eTAU_mismatches_posLbnMap">Help</a>
      }
      hist L1TopoMultiplicityMismatchRateVsLumi {
        algorithm = L1TopoMismatchRate
        description = Agreements and Mismatches between L1Topo Simulation and Hdw perLumi-Block - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimL1TopoMultiplicityMismatchRateVsLumi">Help</a>
        display = SetPalette(87),Draw=COLZTEXT
      }
      hist L1TopoAlgoMismatchRateVsLB {
        algorithm = L1TopoMismatchRate
        description = Mismatch Rate between L1Topo Simulation and Hardware vs Lumi-Block (x-axis) - <a href="https://codimd.web.cern.ch/s/678H65Tk9#SimL1TopoAlgoMismatchRateVsLB">Help</a>
        display = SetPalette(87),Draw=COLZTEXT
      }
    }
    dir Outputs {
      dir eEM {
       output = L1Calo/Expert/Outputs/eEM
        hist h_L1_eEMRoI_LowPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots, then check <a href='./detail/h_L1_eEMRoI_LowPtCut_posVsLBN'>detail timeseries</a>. Warning if more than 1 deadspot, but could just be low stats - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseEMh_L1_eEMRoI_LowPtCut_EtaPhiMap">Help</a>
          algorithm = Efex_eEM_etaThiMapFilled
