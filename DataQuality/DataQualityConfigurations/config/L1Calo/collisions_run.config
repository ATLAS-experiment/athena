            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-CP > 1 GeV/2 - <a href="https://codimd.web.cern.ch/s/678H65Tk9#PpmTrexOutputsdetailppm_had_2d_etaPhi_tt_lutcp_Threshold01">Help</a>
