          }
          hist l1calo_1d_ErrorsByLumiblock {
            description = Events with Errors by Lumiblock.
          }
        }
        hist l1calo_2d_GlobalOverview {
          algorithm = Histogram_Empty
          display = SetPalette(1),SetGridx,SetGridy
          description = L1Calo Global Error Overview.
        }
      }
    }
    dir Sim {
     output = L1Calo/Expert/Sim
      dir detail {
       algorithm = GatherData
       output = L1Calo/Expert/Sim/detail
        hist h_simSummary {
          display = SetPalette(87),Draw=COLZTEXT
        }
        hist h_gJ_mismatches_posLbnMap {
          display = SetPalette(87)
          description = Location of mismatched gJ TOBs. Use this plot to identify any localized gFEX issues. N.B. this plot is only created if there are mismatches.
        }
        hist h_gLJ_mismatches_posLbnMap {
          display = SetPalette(87)
          description = Location of mismatched gLJ TOBs. Use this plot to identify any localized gFEX issues. N.B. this plot is only created if there are mismatches.
        }
      }
      hist h_mismatched_SimReadyRate {
        algorithm = L1CaloMismatchRate
        description = Mismatch rate, per LB (x-axis), per signature (y-axis) for signatures that are deemed simulation-ready - should not be high rate (see DQ algo)
        display = SetPalette(55)
      }
      hist h_eEM_mismatches_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eEM TOBs in simulation-ready events. Use this plot to identify any localized eFEX issues. N.B. this plot is only created if there are mismatches.
      }
      hist h_eEM_mismatchesEmulated_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eEM TOBs in events with EmulatedTower simput. Discuss mismatches with expert, they may be caused by LATOME readout issues if there are LAr Mismatches in Input/eFEX folder. N.B. this plot is only created if there are mismatches.
      }
      hist h_eTAU_mismatches_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eTAU TOBs in simulation-ready events. Use this plot to identify any localized eFEX issues. N.B. this plot is only created if there are mismatches.
      }
      hist h_eTAU_mismatchesEmulated_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eTAU TOBs in events with EmulatedTower simput. Discuss mismatches with expert, they may be caused by LATOME readout issues if there are LAr Mismatches in Input/eFEX folder. N.B. this plot is only created if there are mismatches.
      }
      hist L1TopoMultiplicityMismatchRateVsLumi {
        algorithm = L1TopoMultMismatchRate
        description = Drag the y-axis to make the text bigger<br>IgnoreBins : *:120,*:119,*:115
        display = SetPalette(87),Draw=COLZ
      }
      hist L1TopoAlgoMismatchRateVsLB {
        algorithm = L1TopoAlgMismatchRate
        description = Drag the y-axis to make the text bigger<br>IgnoreBins : *:125,*:123,*:96,*:94,*:92,*:90,*:37,*:20,*:18
        display = SetPalette(87),Draw=COLZ
      }
    }
