          }
          hist ppm_had_2d_etaPhi_tt_lutCp_DataNoSim {
            description = PPM LUT-CP HAD Data but no Simulation
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimEqData {
