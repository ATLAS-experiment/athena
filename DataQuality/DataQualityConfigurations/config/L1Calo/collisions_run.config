#############
# Algorithms
#############

algorithm L1Calo_GatherData {
  libname = libdqm_algorithms.so
  name = GatherData
  reference = stream=physics_Main:CentrallyManagedReferences_TriggerMain;CentrallyManagedReferences_Trigger
}

algorithm L1Calo_IsEmpty {
  libname = libdqm_algorithms.so
  name = Bins_GreaterThan_Threshold
  BinThreshold = 0
  thresholds = L1Calo_EmptyHistThreshold
}



#############
# Thresholds
#############

thresholds L1Calo_EmptyHistThreshold {
  limits NBins {
    warning = 0
    error = 1
  }
}

#######
# BELOW IS THE AUTO-GENERATED HAN CONFIG THAT WILL EVENTUALLY REPLACE ALL OF THE ABOVE FOR L1CALO
#######

#inputs
dir L1Calo {
  dir Expert {
    dir ByteStreamDecoders {
     output = L1Calo/Expert/ByteStreamDecoders
      hist h_efex_errors_vs_lbn {
        algorithm = Histogram_Empty
        description = Should be empty. Please report any errors to eFEX software experts. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#ByteStreamDecodersh_efex_errors_vs_lbn">Help</a>
      }
    }
    dir Sim {
     output = L1Calo/Expert/Sim
      dir detail {
       algorithm = GatherData
       output = L1Calo/Expert/Sim/detail
        hist h_simSummary {
          display = SetPalette(87),Draw=COLZTEXT
          description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simdetailh_simSummary">Help</a>
        }
        hist h_gJ_mismatches_posLbnMap {
          display = SetPalette(87)
          description = Location of mismatched gJ TOBs. Use this plot to identify any localized gFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simdetailh_gJ_mismatches_posLbnMap">Help</a>
        }
        hist h_gLJ_mismatches_posLbnMap {
          display = SetPalette(87)
          description = Location of mismatched gLJ TOBs. Use this plot to identify any localized gFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simdetailh_gLJ_mismatches_posLbnMap">Help</a>
        }
      }
      hist h_mismatched_SimReadyRate {
        algorithm = L1CaloMismatchRate
        description = Mismatch rate, per LB (x-axis), per signature (y-axis) for signatures that are deemed simulation-ready - should not be high rate (see DQ algo) - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simh_mismatched_SimReadyRate">Help</a>
        display = SetPalette(55)
      }
      hist h_eEM_mismatches_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eEM TOBs in simulation-ready events. Use this plot to identify any localized eFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simh_eEM_mismatches_posLbnMap">Help</a>
      }
      hist h_eTAU_mismatches_posLbnMap {
        algorithm = Histogram_Empty
        display = SetPalette(87)
        description = Location of mismatched eTAU TOBs in simulation-ready events. Use this plot to identify any localized eFEX issues. N.B. this plot is only created if there are mismatches. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#Simh_eTAU_mismatches_posLbnMap">Help</a>
      }
    }
    dir Outputs {
      dir eEM {
       output = L1Calo/Expert/Outputs/eEM
        hist h_L1_eEMRoI_LowPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots, then check <a href='./detail/h_L1_eEMRoI_LowPtCut_posVsLBN'>detail timeseries</a>. Warning if more than 1 deadspot, but could just be low stats - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseEMh_L1_eEMRoI_LowPtCut_EtaPhiMap">Help</a>
          algorithm = Efex_eEM_etaThiMapFilled
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/eEM/detail
          hist h_L1_eEMRoI_LowPtCut_posVsLBN {
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eEMRoI_LowPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseEMdetailh_L1_eEMRoI_LowPtCut_posVsLBN">Help</a>
          }
          hist h_L1_eEMRoI_HiPtCut_posVsLBN {
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eEMRoI_HiPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseEMdetailh_L1_eEMRoI_HiPtCut_posVsLBN">Help</a>
          }
        }
        hist h_L1_eEMRoI_HiPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots, then check <a href='./detail/h_L1_eEMRoI_HiPtCut_posVsLBN'>detail timeseries</a>. Warning if more than 1 deadspot, but could just be low stats - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseEMh_L1_eEMRoI_HiPtCut_EtaPhiMap">Help</a>
          algorithm = Efex_eEM_etaThiMapFilled
        }
      }
      dir eTAU {
       output = L1Calo/Expert/Outputs/eTAU
        hist h_L1_eTauRoI_LowPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots, then check <a href='./detail/h_L1_eTauRoI_LowPtCut_posVsLBN'>detail timeseries</a>. Warning if any deadspots/empty, but could just be low stats - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseTAUh_L1_eTauRoI_LowPtCut_EtaPhiMap">Help</a>
          algorithm = Efex_eTAU_etaThiMapFilled
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/eTAU/detail
          hist h_L1_eTauRoI_LowPtCut_posVsLBN {
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eTauRoI_LowPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseTAUdetailh_L1_eTauRoI_LowPtCut_posVsLBN">Help</a>
          }
          hist h_L1_eTauRoI_HiPtCut_posVsLBN {
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eTauRoI_HiPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseTAUdetailh_L1_eTauRoI_HiPtCut_posVsLBN">Help</a>
          }
        }
        hist h_L1_eTauRoI_HiPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots, then check <a href='./detail/h_L1_eTauRoI_HiPtCut_posVsLBN'>detail timeseries</a>. Warning if any deadspots/empty, but could just be low stats - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseTAUh_L1_eTauRoI_HiPtCut_EtaPhiMap">Help</a>
          algorithm = Efex_eTAU_etaThiMapFilled
        }
      }
      dir jJ {
       output = L1Calo/Expert/Outputs/jJ
        hist h_jJ_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled
          description = Bins with negative number of entries (in the FCAL) signify that no TOBs can be produced at that position. In the region 3.1 < |eta| < 3.2 seeded in EMEC and FCAL1 are displayed next to each other, though in reality have similar eta coordinates. Inspect for hot/cold spots - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjJh_jJ_EtaPhiMap">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_jJ_EtaPhiMap_Pt20 {
          algorithm = Jfex_etaPhiMapFilled
          description = Bins with negative number of entries (in the FCAL) signify that no TOBs can be produced at that position. In the region 3.1 < |eta| < 3.2 seeded in EMEC and FCAL1 are displayed next to each other, though in reality have similar eta coordinates. Inspect for hot/cold spots - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjJh_jJ_EtaPhiMap_Pt20">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jJ/detail
          hist h_jJ_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jJ_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjJdetailh_jJ_posVsLBN">Help</a>
          }
          hist h_jJ_posVsLBN_Pt20 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jJ_EtaPhiMap_Pt20'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjJdetailh_jJ_posVsLBN_Pt20">Help</a>
          }
        }
      }
      dir jTau {
       output = L1Calo/Expert/Outputs/jTau
        hist h_jTau_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled_TAU
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjTauh_jTau_EtaPhiMap">Help</a>
          display = SetPalette(87)
        }
        hist h_jTau_EtaPhiMap_Pt10 {
          algorithm = Jfex_etaPhiMapFilled_TAU
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjTauh_jTau_EtaPhiMap_Pt10">Help</a>
          display = SetPalette(87)
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jTau/detail
          hist h_jTau_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jTau_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjTaudetailh_jTau_posVsLBN">Help</a>
          }
          hist h_jTau_posVsLBN_Pt10 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jTau_EtaPhiMap_Pt10'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjTaudetailh_jTau_posVsLBN_Pt10">Help</a>
          }
        }
      }
      dir jEM {
       output = L1Calo/Expert/Outputs/jEM
        hist h_jEM_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled_EM
          description = Bins with negative number of entries (in the FCAL and central region) signify that no TOBs can be produced at that position. Inspect for hot/cold spots, note that there are no jEM TOBs for |eta| < 2.3 - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMh_jEM_EtaPhiMap">Help</a>
          display = SetPalette(87),Draw=COL1Z
        }
        hist h_jEM_EtaPhiMap_Pt10 {
          algorithm = Jfex_etaPhiMapFilled_EM
          description = Bins with negative number of entries (in the FCAL and central region) signify that no TOBs can be produced at that position. Inspect for hot/cold spots, note that there are no jEM TOBs for |eta| < 2.3 - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMh_jEM_EtaPhiMap_Pt10">Help</a>
          display = SetPalette(87),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jEM/detail
          hist h_jEM_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jEM_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMdetailh_jEM_posVsLBN">Help</a>
          }
          hist h_jEM_posVsLBN_Pt10 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jEM_EtaPhiMap_Pt10'>eta-phi map</a>. Use projection X1 for 1D plot. - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjEMdetailh_jEM_posVsLBN_Pt10">Help</a>
          }
        }
      }
      dir gLJ {
       output = L1Calo/Expert/Outputs/gLJ
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt0 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt0_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJh_etaphiMapL1_gFexLRJetRoI_CutPt0">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/gLJ/detail
          hist h_L1_gFexLRJetRoI_CutPt0_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt0'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJdetailh_L1_gFexLRJetRoI_CutPt0_posVsLBN">Help</a>
          }
          hist h_L1_gFexLRJetRoI_CutPt30_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt30'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJdetailh_L1_gFexLRJetRoI_CutPt30_posVsLBN">Help</a>
          }
          hist h_L1_gFexLRJetRoI_CutPt400_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt400'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJdetailh_L1_gFexLRJetRoI_CutPt400_posVsLBN">Help</a>
          }
        }
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt30 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt30_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJh_etaphiMapL1_gFexLRJetRoI_CutPt30">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt400 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt400_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgLJh_etaphiMapL1_gFexLRJetRoI_CutPt400">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
      dir gJ {
       output = L1Calo/Expert/Outputs/gJ
        hist h_etaphiMapL1_gFexSRJetRoI_CutPt0 {
          algorithm = Gfex_etaPhiMapFilled_gJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexSRJetRoI_CutPt0_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJh_etaphiMapL1_gFexSRJetRoI_CutPt0">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/gJ/detail
          hist h_L1_gFexSRJetRoI_CutPt0_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexSRJetRoI_CutPt0'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJdetailh_L1_gFexSRJetRoI_CutPt0_posVsLBN">Help</a>
          }
          hist h_L1_gFexSRJetRoI_CutPt100_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexSRJetRoI_CutPt100'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJdetailh_L1_gFexSRJetRoI_CutPt100_posVsLBN">Help</a>
          }
        }
        hist h_etaphiMapL1_gFexSRJetRoI_CutPt100 {
          algorithm = Gfex_etaPhiMapFilled_gJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexSRJetRoI_CutPt100_posVsLBN'>detail timeseries</a> - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsgJh_etaphiMapL1_gFexSRJetRoI_CutPt100">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
    }
    dir Efficiency {
      dir gFEX {
        dir MuonReferenceTrigger {
         output = L1Calo/Expert/Efficiency/gFEX/MuonReferenceTrigger
          hist SRpt_L1_gJ20p0ETA25 {
            algorithm = JetEfficiency_L1_gJ20p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gJ20p0ETA25">Help</a>
          }
          hist LRpt_L1_gJ20p0ETA25 {
            algorithm = JetEfficiency_L1_gJ20p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gJ20p0ETA25">Help</a>
          }
          hist SRpt_L1_gJ50p0ETA25 {
            algorithm = JetEfficiency_L1_gJ50p0ETA25
