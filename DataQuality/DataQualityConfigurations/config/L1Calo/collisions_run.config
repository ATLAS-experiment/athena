            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimNeData {
            description = PPM LUT-JEP HAD Data/Simulation Non-zero Mismatches
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimNoData {
            description = PPM LUT-JEP HAD Simulation but no Data
