#############
# Output
#############

output top_level {
  output L1Calo {
    output Expert {
     output TREX {
      output Overview {
      }
      output SpareChannels {
        output ADC {
        }
        output Errors {
          output Detail {
          }
        }
      }
      output Errors {
        output Data_Simulation {
          output MismatchEventNumbers {
          }
          output PPMLUTSim {
          }
          output PPMBcidSim {
          }
        }
        output Detail {
        }
      }
      output ADC {
        output EtaPhiMaps {
        }
        output Timeslices {
        }
      }
      output LUT-CP {
        output EtaPhiMaps {
        }
        output Distributions {
        }
      }
      output LUT-JEP {
        output EtaPhiMaps {
        }
        output Distributions {
        }
      }
      output Stability {
        output FineTime {
          output FineTime_Lumi {
          }
        }
        output Pedestal {
          output Pedestal_Summary {
          }
          output Pedestal_BCN {
          }
          output Pedestal_Lumi {
          }
        }
        output PedestalCorrection {
          output PedestalCorrection_Summary {
          }
          output PedestalCorrection_BCN {
          }
          output PedestalCorrection_Lumi {
          }
        }
        output EtCorrelation {
          output EtCorrelation_Lumi {
          }
        }
      }
     }
    }
  }
}



dir L1Calo {
  algorithm = L1Calo_GatherData
  reference = CentrallyManagedReferences_TriggerMain
  output = L1Calo
  dir Overview {
    hist l1calo_1d_NumberOfEvents {
      output = L1Calo/Expert/TREX/Overview
    }
    dir Errors {
      hist l1calo_2d_GlobalOverview {
        output = L1Calo/Expert/TREX/Overview
        display = SetPalette(1),SetGridx,SetGridy
        algorithm = L1Calo_IsEmpty
      }
    }
  }
  dir PPM {
    dir SpareChannels {
      dir ADC {
        output = L1Calo/Expert/TREX/SpareChannels/ADC
        hist ppmspare_1d_tt_adc_TriggeredSlice {
          display = LogY
        }
        hist ppmspare_2d_tt_adc_ProfileMap {
          display = SetPalette(1)
        }
      }
      dir Errors {
        output = L1Calo/Expert/TREX/SpareChannels/Errors
        hist ppmspare_1d_ErrorSummary {
          display = SetGridx,SetGridy
        }
        hist ppmspare_2d_ASICErrorEventNumbers {
        }
        hist ppmspare_2d_ErrorEventNumbers {
        }
        hist ppmspare_2d_ErrorField25 {
          display = SetGridx,SetGridy
        }
        hist ppmspare_2d_Status25 {
          display = SetGridx,SetGridy
        }
        dir Detail {
          output = L1Calo/Expert/TREX/SpareChannels/Errors/Detail
          hist ppmspare_2d_Channel0DisabledChannel1DisabledCrate23 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_Channel0DisabledChannel1DisabledCrate45 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_Channel2DisabledChannel3DisabledCrate23 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_Channel2DisabledChannel3DisabledCrate45 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_EventMismatchBunchMismatchCrate23 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_EventMismatchBunchMismatchCrate45 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_FIFOCorruptPinParityCrate23 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_FIFOCorruptPinParityCrate45 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_MCMAbsentCrate23 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_MCMAbsentCrate45 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_TimeoutASICFullCrate23 {
            display = SetGridx,SetGridy
          }
          hist ppmspare_2d_TimeoutASICFullCrate45 {
            display = SetGridx,SetGridy
          }
        }
      }
    }
    dir Errors {
      output = L1Calo/Expert/TREX/Errors
      hist ppm_1d_ErrorSummary {
        algorithm = L1Calo_IsEmpty
      }
      hist ppm_2d_ASICErrorEventNumbers {
      }
      hist ppm_2d_ErrorEventNumbers {
      }
      hist ppm_2d_BcnMismatch03 {
        display = SetPalette(1)
      }
      hist ppm_2d_BcnMismatch47 {
        display = SetPalette(1)
      }
      hist ppm_2d_ErrorField03 {
        display = SetPalette(1)
      }
      hist ppm_2d_ErrorField47 {
        display = SetPalette(1)
      }
      hist ppm_2d_Status03 {
        display = SetPalette(1)
      }
      hist ppm_2d_Status47 {
        display = SetPalette(1)
      }
      dir Data_Simulation {
        dir MismatchEventNumbers {
          output = L1Calo/Expert/TREX/Errors/Data_Simulation/MismatchEventNumbers
          hist ppm_2d_LUT_MismatchEvents_cr0cr1 {
          }
          hist ppm_2d_LUT_MismatchEvents_cr2cr3 {
          }
          hist ppm_2d_LUT_MismatchEvents_cr4cr5 {
          }
          hist ppm_2d_LUT_MismatchEvents_cr6cr7 {
          }
        }
        dir PPMLUTSim {
          output = L1Calo/Expert/TREX/Errors/Data_Simulation/PPMLUTSim
          hist ppm_em_2d_etaPhi_tt_lutCp_DataNoSim {
          }
          hist ppm_em_2d_etaPhi_tt_lutCp_SimEqData {
          }
          hist ppm_em_2d_etaPhi_tt_lutCp_SimNeData {
          }
          hist ppm_em_2d_etaPhi_tt_lutCp_SimNoData {
          }
          hist ppm_em_2d_etaPhi_tt_lutJep_DataNoSim {
          }
          hist ppm_em_2d_etaPhi_tt_lutJep_SimEqData {
          }
          hist ppm_em_2d_etaPhi_tt_lutJep_SimNeData {
          }
          hist ppm_em_2d_etaPhi_tt_lutJep_SimNoData {
          }
          hist ppm_had_2d_etaPhi_tt_lutCp_DataNoSim {
          }
          hist ppm_had_2d_etaPhi_tt_lutCp_SimEqData {
          }
          hist ppm_had_2d_etaPhi_tt_lutCp_SimNeData {
          }
          hist ppm_had_2d_etaPhi_tt_lutCp_SimNoData {
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_DataNoSim {
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimEqData {
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimNeData {
          }
          hist ppm_had_2d_etaPhi_tt_lutJep_SimNoData {
          }
        }
        dir PPMBcidSim {
          output = L1Calo/Expert/TREX/Errors/Data_Simulation/PPMBcidSim
          hist ppm_2d_etaPhi_tt_satBcid_DataNoSim {
          }
          hist ppm_2d_etaPhi_tt_satBcid_NonZeroMatches {
          }
          hist ppm_2d_etaPhi_tt_satBcid_SimNoData {
          }
          hist ppm_2d_etaPhi_tt_satBcid_ZeroMatches {
          }
        }
      }
      dir Detail {
        output = L1Calo/Expert/TREX/Errors/Detail
        hist ppm_2d_Channel0DisabledChannel1DisabledCrate01 {
        }
        hist ppm_2d_Channel0DisabledChannel1DisabledCrate23 {
        }
        hist ppm_2d_Channel0DisabledChannel1DisabledCrate45 {
        }
        hist ppm_2d_Channel0DisabledChannel1DisabledCrate67 {
        }
        hist ppm_2d_Channel2DisabledChannel3DisabledCrate01 {
        }
        hist ppm_2d_Channel2DisabledChannel3DisabledCrate23 {
        }
        hist ppm_2d_Channel2DisabledChannel3DisabledCrate45 {
        }
        hist ppm_2d_Channel2DisabledChannel3DisabledCrate67 {
        }
        hist ppm_2d_EventMismatchBunchMismatchCrate01 {
        }
        hist ppm_2d_EventMismatchBunchMismatchCrate23 {
        }
        hist ppm_2d_EventMismatchBunchMismatchCrate45 {
        }
        hist ppm_2d_EventMismatchBunchMismatchCrate67 {
        }
        hist ppm_2d_FIFOCorruptPinParityCrate01 {
        }
        hist ppm_2d_FIFOCorruptPinParityCrate23 {
        }
        hist ppm_2d_FIFOCorruptPinParityCrate45 {
        }
        hist ppm_2d_FIFOCorruptPinParityCrate67 {
        }
        hist ppm_2d_MCMAbsentCrate01 {
        }
        hist ppm_2d_MCMAbsentCrate23 {
        }
        hist ppm_2d_MCMAbsentCrate45 {
        }
        hist ppm_2d_MCMAbsentCrate67 {
        }
        hist ppm_2d_TimeoutASICFullCrate01 {
        }
        hist ppm_2d_TimeoutASICFullCrate23 {
        }
        hist ppm_2d_TimeoutASICFullCrate45 {
        }
        hist ppm_2d_TimeoutASICFullCrate67 {
        }
      }
    }
    dir ADC {
      dir EtaPhiMaps {
        output = L1Calo/Expert/TREX/ADC/EtaPhiMaps
        hist ppm_em_2d_etaPhi_tt_adc_HitMap {
          display = SetPalette(1),LogZ
        }
        hist ppm_em_2d_etaPhi_tt_adc_ProfileHitMap {
          display = SetPalette(1),LogZ
        }
        hist ppm_had_2d_etaPhi_tt_adc_HitMap {
          display = SetPalette(1),LogZ
        }
        hist ppm_had_2d_etaPhi_tt_adc_ProfileHitMap {
