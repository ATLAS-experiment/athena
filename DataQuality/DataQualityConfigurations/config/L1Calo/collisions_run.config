      }
    }
    dir PpmTrex {
      dir Outputs {
       output = L1Calo/Expert/PpmTrex/Outputs
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/PpmTrex/Outputs/detail
          hist ppm_1d_tt_lutcp_LutPerBCN {
            description = Number of LUT-CP > 5 GeV/2 per BC.
          }
          hist ppm_had_2d_etaPhi_tt_lutcp_AverageEt {
            display = SetPalette(1),LogZ
            description = HAD Average LUT-CP Et for Et > 5 GeV/2.
          }
          hist ppm_had_2d_etaPhi_tt_lutcp_Threshold01 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-CP > 1 GeV/2
          }
          hist ppm_had_2d_etaPhi_tt_lutcp_Threshold02 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-CP > 3 GeV/2
          }
          hist ppm_had_2d_etaPhi_tt_lutcp_Threshold03 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-CP > 5 GeV/2
          }
          hist ppm_had_2d_etaPhi_tt_lutcp_Threshold04 {
            display = SetPalette(1),LogZ
            description = #eta - #phi map of HAD LUT-CP > 10 GeV/2
          }
          hist ppm_had_2d_etaPhi_tt_lutcp_Threshold06 {
            display = SetPalette(1),LogZ
