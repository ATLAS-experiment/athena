          hist h_L1_eTauRoI_LowPtCut_posVsLBN {
            algorithm = Efex_eTAU_etaPhiLBMapOutliers
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eTauRoI_LowPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot<br>KnownCold : 49,41;49,42;48,8;1,29;13,36;18,24;18,50;2,29;23,29;25,36;26,38;30,15;32,46;36,39;41,54;42,21;42,43;47,6;7,62;8,54;9,41;9,51;9,52;9,53;9,54;9,56;26,10;27,10;28,10;29,10;30,10;31,10;32,10;33,10;18,3;19,3;20,3;21,3;22,3;23,3;24,3;25,3;48,8;2,18;3,17;4,18;5,17;49,10;10,18;10,20;20,31;21,31;14,51;15,51;23,26;29,7;17,32;14,54;34,6;40,12;40,19;26,20;11,44;24,49;30,15;32,46;29,5;16,49;12,19;12,20;17,3;20,10;22,47;23,47;34,10;34,40;35,40;37,39;40,26;43,59;47,47;47,8<br>KnownWarm : 24,39;41,21;43,21;44,21;47,21<br>KnownHot : 4,5;6,2;11,27;13,48;15,49;21,48;40,24;42,35;18,4
          }
          hist h_L1_eTauRoI_HiPtCut_posVsLBN {
            algorithm = Efex_eTAU_etaPhiLBMapOutliers
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eTauRoI_HiPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot<br>KnownCold : 49,41;49,42;48,8;1,29;13,36;18,24;18,50;2,29;23,29;25,36;26,38;30,15;32,46;36,39;41,54;42,21;42,43;47,6;7,62;8,54;9,41;9,51;9,52;9,53;9,54;9,56;26,10;27,10;28,10;29,10;30,10;31,10;32,10;33,10;18,3;19,3;20,3;21,3;22,3;23,3;24,3;25,3;48,8;2,18;3,17;4,18;5,17;49,10;10,18;10,20;20,31;21,31;14,51;15,51;23,26;29,7;17,32;14,54;34,6;40,12;40,19;26,20;11,44;24,49;30,15;32,46;29,5;16,49;12,19;12,20;17,3;20,10;22,47;23,47;34,10;34,40;35,40;37,39;40,26;43,59;47,47;47,8<br>KnownWarm : 24,39;41,21;43,21;44,21;47,21<br>KnownHot : 4,5;6,2;11,27;13,48;15,49;21,48;40,24;42,35;18,4
          }
        }
        hist h_L1_eTauRoI_HiPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Any really significant hot/cold spots (see results for significances) should check over what LBs they occurred, using <a href='./detail/h_L1_eTauRoI_HiPtCut_posVsLBN'>detail timeseries</a>. Any new (unknown) spots, if they occur multiple times in a week, please report<br>KnownCold : 49,41;49,42;48,8;1,29;13,36;18,24;18,50;2,29;23,29;25,36;26,38;30,15;32,46;36,39;41,54;42,21;42,43;47,6;7,62;8,54;9,41;9,51;9,52;9,53;9,54;9,56;26,10;27,10;28,10;29,10;30,10;31,10;32,10;33,10;18,3;19,3;20,3;21,3;22,3;23,3;24,3;25,3;48,8;2,18;3,17;4,18;5,17;49,10;10,18;10,20;20,31;21,31;14,51;15,51;23,26;29,7;17,32;14,54;34,6;40,12;40,19;26,20;11,44;24,49;30,15;32,46;29,5;16,49;12,19;12,20;17,3;20,10;22,47;23,47;34,10;34,40;35,40;37,39;40,26;43,59;47,47;47,8<br>KnownWarm : 24,39;41,21;43,21;44,21;47,21<br>KnownHot : 4,5;6,2;11,27;13,48;15,49;21,48;40,24;42,35;18,4
          algorithm = Efex_eTAU_etaThiMapFilled
        }
      }
      dir jJ {
       output = L1Calo/Expert/Outputs/jJ
        hist h_jJ_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled
          description = Bins with negative number of entries (in the FCAL) signify that no TOBs can be produced at that position. In the region 3.1 < |eta| < 3.2 seeded in EMEC and FCAL1 are displayed next to each other, though in reality have similar eta coordinates. Inspect for hot/cold spots - check help for list of known hot/coldspots
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_jJ_EtaPhiMap_Pt20 {
          algorithm = Jfex_etaPhiMapFilled
          description = Bins with negative number of entries (in the FCAL) signify that no TOBs can be produced at that position. In the region 3.1 < |eta| < 3.2 seeded in EMEC and FCAL1 are displayed next to each other, though in reality have similar eta coordinates. Inspect for hot/cold spots - check help for list of known hot/coldspots
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jJ/detail
          hist h_jJ_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jJ_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot.
          }
          hist h_jJ_posVsLBN_Pt20 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jJ_EtaPhiMap_Pt20'>eta-phi map</a>. Use projection X1 for 1D plot.
          }
        }
      }
      dir jTAU {
       output = L1Calo/Expert/Outputs/jTAU
        hist h_jTAU_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled_TAU
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots
          display = SetPalette(87)
        }
        hist h_jTAU_EtaPhiMap_Pt10 {
          algorithm = Jfex_etaPhiMapFilled_TAU
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots
          display = SetPalette(87)
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jTAU/detail
          hist h_jTAU_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jTAU_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot.
          }
          hist h_jTAU_posVsLBN_Pt10 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jTAU_EtaPhiMap_Pt10'>eta-phi map</a>. Use projection X1 for 1D plot.
          }
        }
      }
      dir jEM {
       output = L1Calo/Expert/Outputs/jEM
        hist h_jEM_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled_EM
          description = Bins with negative number of entries (in the FCAL and central region) signify that no TOBs can be produced at that position. Inspect for hot/cold spots, note that there are no jEM TOBs for |eta| < 2.3 - check help for list of known hot/coldspots
          display = SetPalette(87),Draw=COL1Z
        }
        hist h_jEM_EtaPhiMap_Pt10 {
          algorithm = Jfex_etaPhiMapFilled_EM
          description = Bins with negative number of entries (in the FCAL and central region) signify that no TOBs can be produced at that position. Inspect for hot/cold spots, note that there are no jEM TOBs for |eta| < 2.3 - check help for list of known hot/coldspots
          display = SetPalette(87),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/jEM/detail
          hist h_jEM_posVsLBN {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jEM_EtaPhiMap'>eta-phi map</a>. Use projection X1 for 1D plot.
          }
          hist h_jEM_posVsLBN_Pt10 {
            description = Timeseries of TOB counts at each location, y-axis relates to x and y bin numbers from <a href='../h_jEM_EtaPhiMap_Pt10'>eta-phi map</a>. Use projection X1 for 1D plot.
          }
        }
      }
      dir gLJ {
       output = L1Calo/Expert/Outputs/gLJ
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt0 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt0_posVsLBN'>detail timeseries</a>
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/gLJ/detail
          hist h_L1_gFexLRJetRoI_CutPt0_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt0'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
          hist h_L1_gFexLRJetRoI_CutPt30_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt30'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
          hist h_L1_gFexLRJetRoI_CutPt400_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexLRJetRoI_CutPt400'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
        }
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt30 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt30_posVsLBN'>detail timeseries</a>
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_etaphiMapL1_gFexLRJetRoI_CutPt400 {
          algorithm = Gfex_etaPhiMapFilled_gLJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexLRJetRoI_CutPt400_posVsLBN'>detail timeseries</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
      dir gJ {
       output = L1Calo/Expert/Outputs/gJ
        hist h_etaphiMapL1_gFexSRJetRoI_CutPt0 {
          algorithm = Gfex_etaPhiMapFilled_gJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexSRJetRoI_CutPt0_posVsLBN'>detail timeseries</a>
          display = SetPalette(55),Draw=COL1Z
        }
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Outputs/gJ/detail
          hist h_L1_gFexSRJetRoI_CutPt0_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexSRJetRoI_CutPt0'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
          hist h_L1_gFexSRJetRoI_CutPt100_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_etaphiMapL1_gFexSRJetRoI_CutPt100'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
        }
        hist h_etaphiMapL1_gFexSRJetRoI_CutPt100 {
          algorithm = Gfex_etaPhiMapFilled_gJ
          description = Inspect for hot/cold spots - check <a href='./detail/h_L1_gFexSRJetRoI_CutPt100_posVsLBN'>detail timeseries</a>
          display = SetPalette(55),Draw=COL1Z
        }
      }
    }
    dir Efficiency {
      dir gFEX {
        dir MuonReferenceTrigger {
         output = L1Calo/Expert/Efficiency/gFEX/MuonReferenceTrigger
          hist SRpt_L1_gJ20p0ETA25 {
            algorithm = JetEfficiency_L1_gJ20p0ETA25
          }
          hist SRpt_L1_gJ50p0ETA25 {
            algorithm = JetEfficiency_L1_gJ50p0ETA25
          }
          hist SRpt_L1_gJ100p0ETA25 {
            algorithm = JetEfficiency_L1_gJ100p0ETA25
          }
          hist SRpt_L1_gJ400p0ETA25 {
            algorithm = JetEfficiency_L1_gJ400p0ETA25
            description = <b>EMBARGOED PLOT</b> - 
            output = L1Calo/Developer/Efficiency/gFEX/MuonReferenceTrigger
          }
          hist LRpt_L1_gLJ80p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ80p0ETA25
          }
          hist LRpt_L1_gLJ100p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ100p0ETA25
          }
          hist LRpt_L1_gLJ140p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ140p0ETA25
          }
          hist LRpt_L1_gLJ160p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ160p0ETA25
          }
        }
      }
      dir jFEX {
        dir MuonReferenceTrigger {
         output = L1Calo/Expert/Efficiency/jFEX/MuonReferenceTrigger
          hist SRpt_L1_jJ30 {
            algorithm = JetEfficiency_L1_jJ30
          }
          hist SRpt_L1_jJ40 {
            algorithm = JetEfficiency_L1_jJ40
          }
          hist SRpt_L1_jJ50 {
            algorithm = JetEfficiency_L1_jJ50
          }
          hist SRpt_L1_jJ60 {
            algorithm = JetEfficiency_L1_jJ60
          }
          hist SRpt_L1_jJ80 {
            algorithm = JetEfficiency_L1_jJ80
          }
          hist SRpt_L1_jJ90 {
            algorithm = JetEfficiency_L1_jJ90
          }
          hist SRpt_L1_jJ125 {
            algorithm = JetEfficiency_L1_jJ125
          }
          hist SRpt_L1_jJ140 {
            algorithm = JetEfficiency_L1_jJ140
          }
          hist SRpt_L1_jJ160 {
            algorithm = JetEfficiency_L1_jJ160
          }
          hist SRpt_L1_jJ180 {
            algorithm = JetEfficiency_L1_jJ180
          }
          hist LRpt_L1_SC175-SCjJ10 {
            algorithm = JetEfficiency_L1_SC175-SCjJ10
          }
        }
      }
    }
    dir Inputs {
      dir eFEX {
       output = L1Calo/Expert/Inputs/eFEX
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Inputs/eFEX/detail
          hist h_summary {
            description = TowerID format: '[E]EPPMMF', where E=eta index, P=phi index,M=module,F=fpga
          }
          hist h_dataTowers_ecal_hot_EtaPhiMap {
            algorithm = Efex_ecal_hot_etaPhiMapOutliers
            description = Check <a href='./detail/h_dataTowers_ecal_hot_posVsLBN'>detail plot</a> to get timeseries for each location<br>KnownHot : 2,15;2,16;2,47;2,48;2,55;2,56;47,35;47,36;48,35;48,36;47,47;47,48;48,47;48,48;4,5;13,48<br>KnownCold : 19,18;48,8;8,33;9,19;9,20;9,33;9,34<br>KnownWarm : 2,15;2,47;2,55;2,56;47,35;47,36;47,47;47,48;48,47;50,44
          }
          hist h_dataTowers_ecal_hot_posVsLBN {
            algorithm = Efex_ecal_hot_etaPhiLBMapOutliers
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_ecal_hot_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations<br>KnownHot : 2,15;2,16;2,47;2,48;2,55;2,56;47,35;47,36;48,35;48,36;47,47;47,48;48,47;48,48;4,5;13,48<br>KnownCold : 19,18;48,8;8,33;9,19;9,20;9,33;9,34<br>KnownWarm : 2,15;2,47;2,55;2,56;47,35;47,36;47,47;47,48;48,47;50,44
          }
          hist h_dataTowers_ecal_cold_EtaPhiMap {
            algorithm = Efex_ecal_cold_etaPhiMapOutliers
            description = Check <a href='./detail/h_dataTowers_ecal_cold_posVsLBN'>detail plot</a> to get timeseries for each location<br>KnownHot : 1,15;1,16;2,15;2,16;1,47;1,48;2,47;2,48;1,55;1,56;2,55;2,56;22,47;22,48;23,47;23,48;22,13;22,14;23,13;23,14;50,43;50,44;47,35;47,36;48,35;48,36;47,47;47,48;48,47;48,48<br>KnownCold : 8,33;8,34;49,41;49,42;10,20;9,34
          }
          hist h_dataTowers_ecal_cold_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_ecal_cold_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
          hist h_dataTowers_hcal_hot_EtaPhiMap {
            algorithm = Efex_hcal_hot_etaPhiMapOutliers
            description = Check <a href='./detail/h_dataTowers_hcal_hot_posVsLBN'>detail plot</a> to get timeseries for each location<br>KnownDead : 1,29;13,36;18,24;18,50;2,29;23,29;25,36;26,38;30,15;32,46;36,39;41,21;41,54;42,21;42,43;47,6;7,62;8,54;9,41;9,51;9,52;9,53;9,54;9,56;26,10;27,10;28,10;29,10;30,10;31,10;32,10;33,10;18,3;19,3;20,3;21,3;22,3;23,3;24,3;25,3<br>KnownWarm : 26,3;27,3;28,3;29,3;30,3;31,3;32,3;33,3;34,3<br>KnownHot : 15,49<br>KnownCold : 
          }
          hist h_dataTowers_hcal_hot_posVsLBN {
            algorithm = Efex_hcal_hot_etaPhiLBMapOutliers
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_hcal_hot_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations<br>KnownDead : 1,29;13,36;18,24;18,50;2,29;23,29;25,36;26,38;30,15;32,46;36,39;41,21;41,54;42,21;42,43;47,6;7,62;8,54;9,41;9,51;9,52;9,53;9,54;9,56;26,10;27,10;28,10;29,10;30,10;31,10;32,10;33,10;18,3;19,3;20,3;21,3;22,3;23,3;24,3;25,3<br>KnownWarm : 26,3;27,3;28,3;29,3;30,3;31,3;32,3;33,3;34,3<br>KnownHot : 15,49<br>KnownCold : 
          }
          hist h_dataTowers_hcal_cold_EtaPhiMap {
            algorithm = Efex_hcal_cold_etaPhiMapOutliers
            description = Check <a href='./detail/h_dataTowers_hcal_cold_posVsLBN'>detail plot</a> to get timeseries for each location<br>KnownDead : 1,29;13,36;18,24;18,50;2,29;23,29;25,36;26,38;30,15;32,46;36,39;41,21;41,54;42,21;42,43;47,6;7,62;8,54;9,41;9,51;9,52;9,53;9,54;9,56;26,10;27,10;28,10;29,10;30,10;31,10;32,10;33,10;18,3;19,3;20,3;21,3;22,3;23,3;24,3;25,3<br>KnownCold : 1,30;2,30<br>KnownHot : 6,33
          }
          hist h_dataTowers_hcal_cold_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_dataTowers_hcal_cold_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
        }
        hist h_errors {
          algorithm = Histogram_Empty
          description = Locations of any non-zero em or hadronic status flags. Check <a href='./detail/h_summary'>detail/h_summary</a> for more detail if there are entries
        }
      }
      dir gFEX {
       output = L1Calo/Expert/Inputs/gFEX
        dir detail {
         algorithm = GatherData
         output = L1Calo/Expert/Inputs/gFEX/detail
          hist h_LBN_vs_nGfexTowers {
            description = The y value gives the number of gTowers with Et > 10 GeV; the z value gives the number of events
          }
          hist h_HotTowers_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_HotTower_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
          hist h_ColdTowers_posVsLBN {
            description = x and y correspond to axis bin numbers on <a href='../h_ColdTower_EtaPhiMap'/>eta-phi plot</a>. Use this plot to check if hotspot/coldspots affected whole or part of run: turn on Projection X1 to see 1D hist of individual locations
          }
        }
        hist h_HotTower_EtaPhiMap {
          algorithm = Gfex_Tower_etaPhiMapFilled
          description = Look for hot spots with unusual high statistics; Check <a href='./detail/h_HotTowers_posVsLBN'>detail plot</a> to get timeseries for each location
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_ColdTower_EtaPhiMap {
          algorithm = Gfex_Tower_etaPhiMapFilled
          description = Look for cold spots with unusual high statistics; Check <a href='./detail/h_ColdTowers_posVsLBN'>detail plot</a> to get timeseries for each location 
          display = SetPalette(55),Draw=COL1Z
        }
      }
    }
  }
}
