#thresholds
thresholds th_AnyBinIsError {
    limits NBins {
      warning = 0
      error = 1
    }
}

thresholds L1CaloMismatchRateThresholds {
  limits NBins {
    warning = 0
    error = 10
  }
}
thresholds Efex_eEM_etaThiMapFilledThresholds {
  limits NBins {
    warning = 1
    error = 3200
  }
}
thresholds Efex_eTAU_etaThiMapFilledThresholds {
