#######
# BELOW IS THE AUTO-GENERATED HAN CONFIG THAT WILL EVENTUALLY REPLACE ALL OF THE ABOVE FOR L1CALO
#######

#inputs
dir L1Calo {
  dir Developer {
   algorithm = GatherData
    dir ByteStreamDecoders {
     output = L1Calo/Developer/ByteStreamDecoders
      hist h_efex_errors {
      }
    }
    dir PprMonAlg {
      dir Outputs {
       output = L1Calo/Developer/PprMonAlg/Outputs
        hist ppm_em_1d_tt_lutcp_Eta {
        }
        hist ppm_em_1d_tt_lutcp_Phi {
        }
        hist ppm_em_1d_tt_lutcp_Et {
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_AverageEt {
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold00 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 0 GeV/2
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold01 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 1 GeV/2
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold02 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 3 GeV/2
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold03 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 5 GeV/2
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold04 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 10 GeV/2
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold05 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 20 GeV/2
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold06 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 30 GeV/2
        }
        hist ppm_em_2d_etaPhi_tt_lutcp_Threshold07 {
          display = SetPalette(1),LogZ
          description = #eta - #phi map of EM LUT-CP > 50 GeV/2
        }
        hist ppm_em_1d_tt_lutjep_Eta {
        }
        hist ppm_em_1d_tt_lutjep_Phi {
        }
        hist ppm_em_1d_tt_lutjep_Et {
        }
