          hist h_L1_eTauRoI_LowPtCut_posVsLBN {
            algorithm = Efex_eTAU_etaPhiLBMapOutliers
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eTauRoI_LowPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseTAUdetailh_L1_eTauRoI_LowPtCut_posVsLBN">Help</a>
          }
          hist h_L1_eTauRoI_HiPtCut_posVsLBN {
            algorithm = Efex_eTAU_etaPhiLBMapOutliers
            description = Timeseries of TOB counts at each location ... y-axis relates to x and y bin numbers from <a href='../h_L1_eTauRoI_HiPtCut_EtaPhiMap'>eta-phi map</a>. Use Projection X1 for 1D plot - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseTAUdetailh_L1_eTauRoI_HiPtCut_posVsLBN">Help</a>
          }
        }
        hist h_L1_eTauRoI_HiPtCut_EtaPhiMap {
          display = SetPalette(55)
          description = Inspect for hot/cold spots - check help for list of known hot/coldspots, then check <a href='./detail/h_L1_eTauRoI_HiPtCut_posVsLBN'>detail timeseries</a>. Warning if any deadspots/empty, but could just be low stats - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputseTAUh_L1_eTauRoI_HiPtCut_EtaPhiMap">Help</a>
          algorithm = Efex_eTAU_etaThiMapFilled
        }
      }
      dir jJ {
       output = L1Calo/Expert/Outputs/jJ
        hist h_jJ_EtaPhiMap {
          algorithm = Jfex_etaPhiMapFilled
          description = Bins with negative number of entries (in the FCAL) signify that no TOBs can be produced at that position. In the region 3.1 < |eta| < 3.2 seeded in EMEC and FCAL1 are displayed next to each other, though in reality have similar eta coordinates. Inspect for hot/cold spots - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjJh_jJ_EtaPhiMap">Help</a>
          display = SetPalette(55),Draw=COL1Z
        }
        hist h_jJ_EtaPhiMap_Pt20 {
          algorithm = Jfex_etaPhiMapFilled
          description = Bins with negative number of entries (in the FCAL) signify that no TOBs can be produced at that position. In the region 3.1 < |eta| < 3.2 seeded in EMEC and FCAL1 are displayed next to each other, though in reality have similar eta coordinates. Inspect for hot/cold spots - check help for list of known hot/coldspots - <a href="https://codimd.web.cern.ch/s/678H65Tk9#OutputsjJh_jJ_EtaPhiMap_Pt20">Help</a>
          display = SetPalette(55),Draw=COL1Z
