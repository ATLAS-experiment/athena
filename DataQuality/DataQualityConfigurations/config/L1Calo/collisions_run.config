          }
          hist SRpt_L1_gLJ80p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ80p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gLJ80p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ80p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ80p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ80p0ETA25">Help</a>
          }
          hist SRpt_L1_gLJ100p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ100p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gLJ100p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ100p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ100p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ100p0ETA25">Help</a>
          }
          hist SRpt_L1_gLJ140p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ140p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gLJ140p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ140p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ140p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ140p0ETA25">Help</a>
          }
          hist SRpt_L1_gLJ160p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ160p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerSRpt_L1_gLJ160p0ETA25">Help</a>
          }
          hist LRpt_L1_gLJ160p0ETA25 {
            algorithm = JetEfficiency_L1_gLJ160p0ETA25
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencygFEXMuonReferenceTriggerLRpt_L1_gLJ160p0ETA25">Help</a>
          }
        }
      }
      dir jFEX {
        dir MuonReferenceTrigger {
         output = L1Calo/Expert/Efficiency/jFEX/MuonReferenceTrigger
          hist SRpt_L1_jJ30 {
            algorithm = JetEfficiency_L1_jJ30
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ30">Help</a>
          }
          hist LRpt_L1_jJ30 {
            algorithm = JetEfficiency_L1_jJ30
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerLRpt_L1_jJ30">Help</a>
          }
          hist SRpt_L1_jJ40 {
            algorithm = JetEfficiency_L1_jJ40
            description = <a href="https://codimd.web.cern.ch/s/678H65Tk9#EfficiencyjFEXMuonReferenceTriggerSRpt_L1_jJ40">Help</a>
          }
          hist LRpt_L1_jJ40 {
