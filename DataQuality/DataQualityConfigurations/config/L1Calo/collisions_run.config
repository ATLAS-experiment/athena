         algorithm = GatherData
         output = L1Calo/Expert/PpmTrex/Errors/detail
          hist ppm_had_1d_pedOverflow_Eta {
            description = Overflow of pedestal correction.
          }
          hist ppm_had_1d_pedUnderflow_Eta {
            description = Underflow of pedestal correction.
          }
          hist ppm_2d_SubStatErrorEventNumbers {
            description = SubStatus Word Errors Event Numbers.
          }
          hist ppm_2d_SubStatError47 {
            display = SetPalette(1),SetGridx,SetGridy
            description = SubStatus Word Errors (crates 4-7).
          }
          hist ppm_2d_MCMErrorEventNumbers {
            description = MCM Error Field Event Numbers.
          }
          hist ppm_2d_MCMErrorField47 {
            display = SetPalette(1),SetGridx,SetGridy
            description = MCM Error Field (crates 4-7).
          }
        }
        hist ppm_1d_SubStatErrorSummary {
          algorithm = Histogram_Empty
          description = Summary of SubStatus Word Errors.
        }
        hist ppm_1d_MCMErrorSummary {
          algorithm = Histogram_Empty
          description = Summary of MCM Errors.
        }
      }
      dir Simulation {
       output = L1Calo/Expert/PpmTrex/Simulation
        dir BcidSim {
         output = L1Calo/Expert/PpmTrex/Simulation/BcidSim
          hist ppm_2d_etaPhi_tt_peakf_NonZeroMatches {
            description = PPM Peakfinder Data/Simulation Non-Zero Matches
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_peakf_ZeroMatches {
            description = PPM Peakfinder Data/Simulation Zero Matches
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_peakf_DataNoSim {
            description = PPM Peakfinder Data but no Simulation
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_peakf_SimNoData {
            description = PPM Peakfinder Simulation but no Data
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_NonZeroMatches {
            description = PPM SaturatedBCID Data/Simulation Non-Zero Matches
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_ZeroMatches {
            description = PPM SaturatedBCID Data/Simulation Zero Matches
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_DataNoSim {
            description = PPM SaturatedBCID Data but no Simulation
            algorithm = GatherData
          }
          hist ppm_2d_etaPhi_tt_satBcid_SimNoData {
            description = PPM SaturatedBCID Simulation but no Data
            algorithm = GatherData
          }
        }
        dir LutSim {
         output = L1Calo/Expert/PpmTrex/Simulation/LutSim
          hist ppm_had_2d_etaPhi_tt_lutCp_SimEqData {
            description = PPM LUT-CP HAD Data/Simulation Non-zero Matches
            algorithm = GatherData
          }
          hist ppm_had_2d_etaPhi_tt_lutCp_SimNeData {
            description = PPM LUT-CP HAD Data/Simulation Non-zero Mismatches
