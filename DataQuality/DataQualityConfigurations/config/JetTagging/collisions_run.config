#######################
# Histogram Assessments
#######################

dir JetTagging {

    reference = CentrallyManagedReferences

  ##########################
  ###  Shifter
  ##########################

############ Shifter

 dir Shifter {
  output = JetTagging/Shifter

  hist Cutflow_Event {
    algorithm = Run3_KolTest
  }
  hist Cutflow_Jet {
    algorithm = Run3_KolTest
    display = LogY
  }

  hist PV_n {
    algorithm = Run3_KolTest
    display = LogY
  }
  hist PV_tracks_n {
    algorithm = Run3_KolTest
    display = LogY
  }
  hist Tracks_n {
    algorithm = Run3_KolTest
    display = LogY
  }

  hist Hits_IBL { 
    algorithm = Run3_KolTest
  }
  hist Hits_Pixel {
    algorithm = Run3_KolTest
  }
  hist Hits_SCT {
    algorithm = Run3_KolTest
  }
  hist Hits_Si {
    algorithm = Run3_KolTest
  }
  hist Hits_TRT {
    algorithm = Run3_KolTest
    display = LogY
  }

  hist jet_n_all {
    algorithm = Run3_KolTest
    display = LogY
  }

############ Jets selected good, distributions and 2D maps (after tagging)

  hist jet_eta_good {
    algorithm = Run3_KolTest
  }
  hist jet_phi_good {
    algorithm = Run3_KolTest
  }
  hist jet_pT_good {
    algorithm = Run3_KolTest
    display = LogY
  }
  hist jet_MV_good {
    algorithm = Run3_KolTest
    display = LogY
  }

  hist jet_MV_pu_good {
    algorithm = Run3_KolTest
    display = LogY
  }
  hist jet_MV_pc_good {
    algorithm = Run3_KolTest
    display = LogY
  }
  hist jet_MV_pb_good {
    algorithm = Run3_KolTest
    display = LogY
  }
 }

############ Jets before selection

