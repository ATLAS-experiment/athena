##Check if detector coverage is low
algorithm SCT_LowCoverage {
	libname = libdqm_algorithms.so
	name = BinThresh
	TypePublish = 1 ##Warnings and Errors
	UseValue = -2 ##Less than thresholds
	thresholds = SCT_Coverage_Threshold
        BinMinEntries = 1 ##Exclude checks of empty bins
	MinStat = 10
}

##List Modules with low efficiency
algorithm SCT_HitEff {
	libname = libdqm_algorithms.so
	name = BinPrint
	UnMask_All = 24 ##Print at most 2 full SBC's errors
	UseValue = -2
	Value = 0.9
	UseMaskValue = -1
	MaskValue = 0.
	TypeValue = 0 ##Efficiency Fractions
}

