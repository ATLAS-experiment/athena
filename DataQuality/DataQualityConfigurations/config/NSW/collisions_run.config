##########################################################
# MMG
###########################################################

#############
# Output
#############

output top_level {
  output MuonDetectors {
    output NSWEfficiency {
     output Shifter {
     }
     output Expert {
     }
    }
  }
}

#######################
# Histogram Assessments
#######################
dir Muon {
  dir MuonRawDataMonitoring {
    dir NSW {
      algorithm = NSW_GatherData
      dir Efficiency {
        hist eff_x_y_track_sideC {
          output = MuonDetectors/NSWEfficiency/Expert
        }
	hist eff_x_y_track_sideA {
          output = MuonDetectors/NSWEfficiency/Expert
        }
	hist eff_lb_sector {
          output = MuonDetectors/NSWEfficiency/Shifter
	  algorithm = NSW_SectorEfficiencyCheck
        }
	hist eff_lb_sideA {
          output = MuonDetectors/NSWEfficiency/Shifter
        }
        hist eff_lb_sideC {
          output = MuonDetectors/NSWEfficiency/Shifter
        }
	hist eff_lb_phi_track_sideA {
          output = MuonDetectors/NSWEfficiency/Expert
        }
        hist eff_lb_phi_track_sideC {
          output = MuonDetectors/NSWEfficiency/Expert
        }

      }
    }
  }
}

#############
# Algorithms
#############
algorithm NSW_GatherData {
  name = GatherData
  libname = libdqm_algorithms.so
}

algorithm NSW_SectorEfficiencyCheck {
  libname = libdqm_algorithms.so
  name = SectorEfficiencyCheck
  MinStat = 50
  EffThreshHigh = 0.9
  EffThreshMedium = 0.8
  EffThreshLow = 0.5
  NSectLowMax = 4
  NSectMedium = 5
  NSectHighMin = 6
  reference = stream=physics_Main:CentrallyManagedReferences_Main;CentrallyManagedReferences
}
