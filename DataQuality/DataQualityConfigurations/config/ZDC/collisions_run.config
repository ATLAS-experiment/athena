	  }
	  hist zdcModuleFract_above20N_vs_lb_A_2 {
	    algorithm = ZDC_Frac_Constant_Vs_LB
	    output = ZDC/Module/SideA/FractionLB
	  }
	  hist zdcModuleFract_above20N_vs_lb_A_3 {
	    algorithm = ZDC_Frac_Constant_Vs_LB
	    output = ZDC/Module/SideA/FractionLB
	  }
	}
	dir ModuleTimeLBdep {
	  hist zdcModuleTime_HG_vs_lb_C_0 {
	    algorithm = ZDC_Time_Constant_Vs_LB
	    output = ZDC/Module/SideC/TimeLB
	  }
	  hist zdcModuleTime_LG_vs_lb_C_0 {
	    algorithm = ZDC_Time_Constant_Vs_LB
	    output = ZDC/Module/SideC/TimeLB
	  }
	  hist zdcModuleTime_HG_vs_lb_C_1 {
	    algorithm = ZDC_Time_Constant_Vs_LB
	    output = ZDC/Module/SideC/TimeLB
	  }
	  hist zdcModuleTime_LG_vs_lb_C_1 {
	    algorithm = ZDC_Time_Constant_Vs_LB
