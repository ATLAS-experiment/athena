	  }
	  hist zdcModuleFract_above20N_vs_lb_C_3 {
	    algorithm = ZDC_Frac_Constant_Vs_LB
	    output = ZDC/Module/SideC/FractionLB
	  }
	  hist zdcModuleFract_above20N_vs_lb_A_0 {
	    algorithm = ZDC_Frac_Constant_Vs_LB
	    output = ZDC/Module/SideA/FractionLB
	  }
	  hist zdcModuleFract_above20N_vs_lb_A_1 {
	    algorithm = ZDC_Frac_Constant_Vs_LB
