
output top_level {
  output ZDC {
    output Module {
      output SideA {
        output Amp {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output AmpLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output TimeLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output FractionLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
      }
      output SideC {
        output Amp {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output AmpLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output TimeLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output FractionLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
      }
    }	
    output Arm {
      algorithm = WorstCaseSummary
        output SideA {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output SideC {
          algorithm = WorstCaseSummary
          weight = 0 
        }
    }
  }
}

dir ZDC {
  dir EXPERT {
    dir ZDC {
      dir ZdcModule {
	dir ModuleAmp {
	  hist zdcModuleAmp_C_0 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Module/SideC/Amp
	  }
	  hist zdcModuleAmp_halfrange_C_0 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Module/SideC/Amp
	  }
	  hist zdcModuleAmp_HG_C_0 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Module/SideC/Amp
	  }
	  hist zdcModuleAmp_halfrange_C_1 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
