	    output = ZDC/Module/SideA/Amp
	  }
	  hist zdcModuleAmp_HG_A_0 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Module/SideA/Amp
	  }
	  hist zdcModuleAmp_halfrange_A_1 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
