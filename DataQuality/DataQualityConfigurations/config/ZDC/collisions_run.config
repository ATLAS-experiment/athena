	  }
	  hist zdcModuleAmp_HG_A_3 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Module/SideA/Amp
	  }
	}
	dir ModuleAmpLBdep {
	  hist zdcModuleAmp_vs_lb_C_0 {
	    algorithm = ZDC_Test_Constant_Vs_LB
	    output = ZDC/Module/SideC/AmpLB
	  }
	  hist zdcModuleAmp_vs_lb_C_1 {
	    algorithm = ZDC_Test_Constant_Vs_LB
	    output = ZDC/Module/SideC/AmpLB
	  }
	  hist zdcModuleAmp_vs_lb_C_2 {
	    algorithm = ZDC_Test_Constant_Vs_LB
	    output = ZDC/Module/SideC/AmpLB
	  }
	  hist zdcModuleAmp_vs_lb_C_3 {
	    algorithm = ZDC_Test_Constant_Vs_LB
	    output = ZDC/Module/SideC/AmpLB
	  }
	  hist zdcModuleAmp_vs_lb_A_0 {
	    algorithm = ZDC_Test_Constant_Vs_LB
	    output = ZDC/Module/SideA/AmpLB
	  }
	  hist zdcModuleAmp_vs_lb_A_1 {
