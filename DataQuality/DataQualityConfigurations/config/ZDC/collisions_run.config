	  hist zdcModuleCalibAmp_halfrange_A_3 {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Module/SideA/Amp
	  }
	}
	dir ModuleFractionLBdep {
	  hist zdcModuleFract_above20N_vs_lb_C_0 {
	    algorithm = ZDC_Frac_Constant_Vs_LB
	    output = ZDC/Module/SideC/FractionLB
	  }
	  hist zdcModuleFract_above20N_vs_lb_C_1 {
	    algorithm = ZDC_Frac_Constant_Vs_LB
