        }
      }
      dir ModuleCalibAmp {
        hist zdcModuleCalibAmp_0_0 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleCalibAmp_halfrange_0_0 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleCalibAmp_0_1 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleCalibAmp_halfrange_0_1 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleCalibAmp_0_2 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleCalibAmp_halfrange_0_2 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
