
output top_level {
  output ZDC {
    output Module {
      output SideA {
        output Amp {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output AmpLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output TimeLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output FractionLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
      }
      output SideC {
        output Amp {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output AmpLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output TimeLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output FractionLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
      }
    }	
    output Arm {
      algorithm = WorstCaseSummary
        output SideA {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output SideC {
          algorithm = WorstCaseSummary
          weight = 0 
        }
    }
  }
}

dir ZDC {
  dir ZDC {
    dir ZdcModule {
      dir ModuleAmp {
        hist zdcModuleAmp_0_0 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleAmp_halfrange_0_0 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleAmp_HG_0_0 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleAmp_0_1 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleAmp_halfrange_0_1 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleAmp_HG_0_1 {
