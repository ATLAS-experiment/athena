  algorithm displayRef {
    #reference = CentrallyManagedReferences
    reference = stream=physics_Main:CentrallyManagedReferences_Main;stream=physics_HardProbes:CentrallyManagedReferences_HardProbes;stream=physics_UPC:CentrallyManagedReferences_UPC;stream=calibration_ZDCCalib:CentrallyManagedReferences_ZDCCalib;CentrallyManagedReferences
  }
