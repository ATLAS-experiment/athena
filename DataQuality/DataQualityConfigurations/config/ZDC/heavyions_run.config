
output top_level {
  output ZDC {
    output Module {
      output SideA {
        output Amp {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output AmpLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output TimeLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output FractionLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
      }
      output SideC {
        output Amp {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output AmpLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output TimeLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output FractionLB {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
      }
    }	
    output Arm {
      algorithm = WorstCaseSummary
        output SideA {
          algorithm = WorstCaseSummary
      	  weight = 0 
        }
        output SideC {
          algorithm = WorstCaseSummary
          weight = 0 
        }
    }
    output RPD {
      output Arm {
        algorithm = WorstCaseSummary
 	weight = 0 
      }	
      output Module {
        output SideA {
	  output MaxADC {
            algorithm = WorstCaseSummary
      	    weight = 0
	  }
	  output MaxSample {
            algorithm = WorstCaseSummary
      	    weight = 0
	  }
	}
        output SideC {
	  output MaxADC {
            algorithm = WorstCaseSummary
      	    weight = 0
	  }
	  output MaxSample {
            algorithm = WorstCaseSummary
      	    weight = 0
	  }
	}
      }	
    }
  }
}

dir ZDC {
  dir EXPERT {
