        hist zdcModuleTime_LG_vs_lb_1_2 {
          algorithm = ZDC_Time_Stable_LB
          output = ZDC/Module/SideA/TimeLB
        }
        hist zdcModuleTime_HG_vs_lb_1_3 {
          algorithm = ZDC_Time_Stable_LB
