        }
        hist zdcModuleCalibAmp_0_3 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleCalibAmp_halfrange_0_3 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideC/Amp
        }
        hist zdcModuleCalibAmp_1_0 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleCalibAmp_halfrange_1_0 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleCalibAmp_1_1 {
