        hist zdcModuleTime_HG_vs_lb_0_3 {
          algorithm = ZDC_Time_Stable_LB
          output = ZDC/Module/SideC/TimeLB
        }
        hist zdcModuleTime_LG_vs_lb_0_3 {
          algorithm = ZDC_Time_Stable_LB
          output = ZDC/Module/SideC/TimeLB
        }
        hist zdcModuleTime_HG_vs_lb_1_0 {
          algorithm = ZDC_Time_Stable_LB
          output = ZDC/Module/SideA/TimeLB
