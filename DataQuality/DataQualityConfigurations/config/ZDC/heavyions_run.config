          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleCalibAmp_halfrange_1_3 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
      }
      dir ModuleFractionLBdep {
        hist zdcModuleFract_above20N_vs_lb_0_0 {
