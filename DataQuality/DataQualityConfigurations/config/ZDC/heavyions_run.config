        }
        hist zdcModuleAmp_1_2 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleAmp_halfrange_1_2 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleAmp_HG_1_2 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleAmp_1_3 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleAmp_halfrange_1_3 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
        hist zdcModuleAmp_HG_1_3 {
          algorithm = TRT_Histogram_Has_NonZero_Entries
          output = ZDC/Module/SideA/Amp
        }
      }
      dir ModuleAmpLBdep {
        hist zdcModuleAmp_vs_lb_0_0 {
          algorithm = ZDC_Mod_Stable_LB
          output = ZDC/Module/SideC/AmpLB
        }
        hist zdcModuleAmp_vs_lb_0_1 {
          algorithm = ZDC_Mod_Stable_LB
          output = ZDC/Module/SideC/AmpLB
        }
        hist zdcModuleAmp_vs_lb_0_2 {
          algorithm = ZDC_Mod_Stable_LB
          output = ZDC/Module/SideC/AmpLB
        }
        hist zdcModuleAmp_vs_lb_0_3 {
