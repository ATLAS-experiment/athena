	}
	dir Energy {
	  hist zdcEnergySum_A {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Arm/SideA
	    display = LogY
	  }
	  hist zdcEnergySum_vs_lb_wTrig_A {
	    algorithm = ZDC_Histogram_Has_NonZero_Entries/displayRef
	    output = ZDC/Arm/SideA
	    display = LogZ,AxisRange(1500,4000,"Y")
	  }
	  hist zdcEnergySum_vs_lb_noTrig_A {
	    algorithm = ZDC_1n_Constant_Vs_LB
	    output = ZDC/Arm/SideA
	    display = LogZ,AxisRange(1500,4000,"Y")
	  }
	  hist zdcEnergySum_vs_lb_wTrig_A {
