# **********************************************************************
# ITk Global monitoring han configuration
#
# The ITkGlobalMonitoring package writes to its own ITkGlobal/ source
# folder (decoupled from the Run 3 InDetGlobal/ folder), with ITk
# naming (Strip instead of SCT) and without TRT/IBL histograms.
# First pass: display-only (GatherData) with full directory coverage
# via all_in_dir; DQ checks to be added as the ITk monitoring matures.
#
# The reference is a Phase-II MC HIST file (ttbar mu=200,
# ATLAS-P2-RUN4-03); it also defines the histogram set swept up by
# all_in_dir at han-config-gen time.  Replace with a centrally managed
# reference once ITk references exist.  The LRT directories only
# appear once large-radius tracking is enabled in the ITk
# reconstruction; until then they are skipped with a benign INFO
# message at config-generation time.
# **********************************************************************

#######################
# References
#######################

reference ITkGlobalReferences {
  location = /eos/user/m/mvessell/dqrun4/run/test-itk-packages/
  file = test_residuals.root
  path = run_350200
  info = ITk MC development reference (ttbar mu=200, ATLAS-P2-RUN4-03)
  name = same_name
}

#############
# Output
#############

output top_level {
  output InnerDetector {
    output ITkGlobal {
      output Hits {
      }
      output Track {
      }
      output TIDE {
      }
      output PrimaryVertex {
      }
      output BeamSpot {
      }
      output LRTTrack {
      }
      output LRTHits {
      }
    }
  }
}

#######################
# Histogram Assessments
#######################

dir ITkGlobal {
  algorithm = ITkGlobal_GatherData
  reference = ITkGlobalReferences

  dir Hits {
    output = InnerDetector/ITkGlobal/Hits
    hist all_in_dir {
      reference = ITkGlobalReferences
    }
  }
  dir Track {
    output = InnerDetector/ITkGlobal/Track
    hist all_in_dir {
      reference = ITkGlobalReferences
    }
  }
  dir TIDE {
    output = InnerDetector/ITkGlobal/TIDE
    hist all_in_dir {
      reference = ITkGlobalReferences
    }
  }
  dir PrimaryVertex {
    output = InnerDetector/ITkGlobal/PrimaryVertex
    hist all_in_dir {
      reference = ITkGlobalReferences
    }
  }
  dir BeamSpot {
    output = InnerDetector/ITkGlobal/BeamSpot
    hist all_in_dir {
      reference = ITkGlobalReferences
    }
  }
  dir LRTTrack {
    output = InnerDetector/ITkGlobal/LRTTrack
    hist all_in_dir {
      reference = ITkGlobalReferences
    }
  }
  dir LRTHits {
    output = InnerDetector/ITkGlobal/LRTHits
    hist all_in_dir {
      reference = ITkGlobalReferences
    }
  }
}

#############
# Algorithms
#############

algorithm ITkGlobal_GatherData {
  libname = libdqm_algorithms.so
  name = GatherData
}
