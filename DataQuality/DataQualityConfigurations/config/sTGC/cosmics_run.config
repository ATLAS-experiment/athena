#############
# Output
#############

output top_level {
       output MuonDetectors {
              output STG {
                     output Shifter {   
                            output StripEfficiency {
                            }                         
                            output PadTriggerOverview {
                            }
                            output OccupancyGlobal {
                            }
                     }
                     output Expert {
                            output Occupancy {
                                   output Pad {
                                          output SideA {
                                          }
                                          output SideC {
                                          }
                                   }
                                   output Strip {
                                          output SideA {
                                          }
                                          output SideC {
                                          }
                                   }
                                   output Wire {
                                          output SideA {
                                          }
                                          output SideC {
                                          }
                                   }
                            }
                            output Lumiblock {
                                   output Pad {
