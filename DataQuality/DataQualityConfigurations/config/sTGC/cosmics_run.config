###########################################################
# sTG
###########################################################

#######################
# Histogram Assessments
#######################
dir Muon {
    dir MuonRawDataMonitoring {
        dir STG {
            dir Shifter {
                regex = 1            
                dir StripEfficiency {
                    hist strip_efficiency_per_mm_squared_.* {
                         output = MuonDetectors/STG/Shifter/StripEfficiency
                         display = Draw=COLZ
                         algorithm = chi2NDF_check
                    }            
                }
                dir OccupancyGlobal {
                    hist Summary_LB_vs_Sector_pad {
                         output = MuonDetectors/STG/Shifter/OccupancyGlobal
                         display = LogZ,Draw=COLZ
                         algorithm = Occupancy_Bins    
                    }
                    hist Summary_LB_vs_Sector_strip {
                         output = MuonDetectors/STG/Shifter/OccupancyGlobal
                         display = LogZ,Draw=COLZ
                         algorithm = Occupancy_Bins    
                    }
                    hist Summary_LB_vs_Sector_wire {
                         output = MuonDetectors/STG/Shifter/OccupancyGlobal
                         display = LogZ,Draw=COLZ
                         algorithm = Occupancy_Bins   
                    }
                }
                dir PadTriggerOverview {
                    hist padTrigger_Efficiency_per_etaPhi {
                         output = MuonDetectors/STG/Shifter/PadTriggerOverview
                         display = Draw=COLZ
                         algorithm = chi2NDF_check
                    }           
                    hist padTrigger_Map_per_eta {
                         output = MuonDetectors/STG/Shifter/PadTriggerOverview
                         display = Draw=COLZ
                         algorithm = stgc_Histogram_Not_Empty     
                    }  
                    hist padTrigger_Map_per_etaPhi {
                         output = MuonDetectors/STG/Shifter/PadTriggerOverview
                         display = Draw=COLZ
                         algorithm = stgc_Histogram_Not_Empty     
                    }  
                    hist recoMuon_Map_per_etaPhi {
                         output = MuonDetectors/STG/Shifter/PadTriggerOverview
                         display = Draw=COLZ
                         algorithm = stgc_Histogram_Not_Empty     
                    }
                    hist OccupancySector_vs_LB {
		    	 output = MuonDetectors/STG/Shifter/PadTriggerOverview
			 algorithm = stgc_Histogram_Not_Empty
                    }                      
                }    
            }         
          dir Expert {
              regex = 1 
              dir Occupancy {
                  regex = 1
                  dir Pad {
                       hist Feb_vs_sector_pad {
                            output = MuonDetectors/STG/Expert/Occupancy/Pad
                            display = Draw=COLZ
                            algorithm = stgc_Histogram_Not_Empty     
                       }
                       hist Pad_ch_occupancy_per_sector_.* {
                            output = MuonDetectors/STG/Expert/Occupancy/Pad
                            algorithm = stgc_Histogram_Not_Empty
                       }
                       dir SideA {
                            hist pad_quad_occupancy_per_layer_A.* {
                             output = MuonDetectors/STG/Expert/Occupancy/Pad/SideA
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                       }
                       dir SideC {
                            hist pad_quad_occupancy_per_layer_C.* {
                             output = MuonDetectors/STG/Expert/Occupancy/Pad/SideC
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                       }  
                  }
                  dir Strip {
                      hist Feb_vs_sector_strip {
                           output = MuonDetectors/STG/Expert/Occupancy/Strip
                           display = Draw=COLZ
                           algorithm = stgc_Histogram_Not_Empty     
                      }
                      hist Strip_ch_occupancy_per_sector_.* {
                           output = MuonDetectors/STG/Expert/Occupancy/Strip
                           algorithm = stgc_Histogram_Not_Empty
                      }
                      dir SideA {
                        hist strip_quad_occupancy_per_layer_A.* {
                             output = MuonDetectors/STG/Expert/Occupancy/Strip/SideA
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                        }
                      }
                      dir SideC {
                        hist strip_quad_occupancy_per_layer_C.* {
                             output = MuonDetectors/STG/Expert/Occupancy/Strip/SideC
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                        }
                      }
                  }
                  dir Wire {
                      hist Feb_vs_sector_wire {
                           output = MuonDetectors/STG/Expert/Occupancy/Wire
                           display = Draw=COLZ
                           algorithm = stgc_Histogram_Not_Empty     
                      }
                      hist Wire_ch_occupancy_per_sector_.* {
                           output = MuonDetectors/STG/Expert/Occupancy/Wire
                           algorithm = stgc_Histogram_Not_Empty
                      }
                      dir SideA {
                        hist wire_quad_occupancy_per_layer_A.* {
                             output = MuonDetectors/STG/Expert/Occupancy/Wire/SideA
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                        }
                      }
                      dir SideC {
                        hist wire_quad_occupancy_per_layer_C.* {
                             output = MuonDetectors/STG/Expert/Occupancy/Wire/SideC
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                        }
                      }
                  }
              }
              dir Lumiblock {
                  dir Pad {
                      dir SideA {
                             hist LB_vs_FEB_perSector_pad_(?P<sector>[AC][0-9]{2}) {
                             output = MuonDetectors/STG/Expert/Lumiblock/Pad/SideA
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                      }
                      dir SideC {
                             hist LB_vs_FEB_perSector_pad_(?P<sector>[AC][0-9]{2}) {
                             output = MuonDetectors/STG/Expert/Lumiblock/Pad/SideC
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                      }
                  }
                  dir Strip {
                      dir SideA {
                             hist LB_vs_FEB_perSector_strip_(?P<sector>[AC][0-9]{2}) {
                             output = MuonDetectors/STG/Expert/Lumiblock/Strip/SideA
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                      }
                      dir SideC {
                             hist LB_vs_FEB_perSector_strip_(?P<sector>[AC][0-9]{2}) {
                             output = MuonDetectors/STG/Expert/Lumiblock/Strip/SideC
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                      }
                  }
                  dir Wire {
                      dir SideA {
                             hist LB_vs_FEB_perSector_wire_(?P<sector>[AC][0-9]{2}) {
                             output = MuonDetectors/STG/Expert/Lumiblock/Wire/SideA
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                      }
                      dir SideC {
                             hist LB_vs_FEB_perSector_wire_(?P<sector>[AC][0-9]{2}) {
                             output = MuonDetectors/STG/Expert/Lumiblock/Wire/SideC
                             display = LogZ,Draw=COLZ
                             algorithm = Occupancy_Bins
                            }
                      }
                  }
              }
              dir StripClusterSize { 
                    hist Strip_cluster_size_ontrk_per_sector_.* {
                         output = MuonDetectors/STG/Expert/StripClusterSize
                         algorithm = stg_Ymeans_size
                         display = LogZ,Draw=COLZ
                    }
              }
              dir PadTrigger {
                  dir Hits {
                      hist OccupancypFEB_vs_Sector {
                             output = MuonDetectors/STG/Expert/PadTrigger/Hits
                             algorithm = stgc_Histogram_Not_Empty
                        }
                        hist relBCID_vs_Sector {
                             output = MuonDetectors/STG/Expert/PadTrigger/Hits
                             algorithm = stgc_Histogram_Not_Empty
                        }  
                      regex = 1
                      dir padTriggerOccupancy {
                          hist padEtaPhiOcc_[1-8][AC][LS] {
                               output = MuonDetectors/STG/Expert/PadTrigger/Hits/padTriggerOccupancy
                               algorithm = stgc_Histogram_Not_Empty
                          }
                      }
                      dir PFEBvsRelBCID {
                            hist pFEB_vs_relBCID_.* {
                                 output = MuonDetectors/STG/Expert/PadTrigger/Hits/PFEBvsRelBCID
                                 algorithm = stgc_Histogram_Not_Empty
                            }
                        }
                  }
                  dir Triggers {  
                      regex = 1 
                      dir OccupancyBandIDvsLB { 
                          hist OccupancyBandId_vs_LB_.* {
                               output = MuonDetectors/STG/Expert/PadTrigger/Triggers/OccupancyBandIDvsLB
                               algorithm = stgc_Histogram_Not_Empty
                          }
                      }
                      dir OccupancyBandIDvsPhiId {
                          hist bandIds_vs_phiIds_.* {
                               output = MuonDetectors/STG/Expert/PadTrigger/Triggers/OccupancyBandIDvsPhiId
                               algorithm = stgc_Histogram_Not_Empty
                          }
                      }
                      dir RelBCIDvsLB {
                          hist RelBCID_vs_LB_.* {
                               output = MuonDetectors/STG/Expert/PadTrigger/Triggers/RelBCIDvsLB
                               algorithm = stgc_Histogram_Not_Empty
                          }
                      }
                      dir PhiIDvsRelBCID {
                            hist Trigger_PhiID_vs_RelBCID_.* {
                                 output = MuonDetectors/STG/Expert/PadTrigger/Triggers/PhiIDvsRelBCID
                                 algorithm = stgc_Histogram_Not_Empty
                            }
                        }
                      dir BandIDvsRelBCID {
                            hist Trigger_BandID_vs_RelBCID_.* {
                                 output = MuonDetectors/STG/Expert/PadTrigger/Triggers/BandIDvsRelBCID
                                 algorithm = stgc_Histogram_Not_Empty
                            }
                        }
                      hist RelBCID_vs_LB {
                             output = MuonDetectors/STG/Expert/PadTrigger/Triggers
                             algorithm = stgc_Histogram_Not_Empty
                        }
                        hist bandIds_vs_phiIds_.* {
                             output = MuonDetectors/STG/Expert/PadTrigger/Triggers
                             algorithm = stgc_Histogram_Not_Empty
                        }
                  }
              }
              dir Timing {
                  regex = 1
                  dir Pad {
                      dir Q1 {
                          hist All_pad_timing_in_Q1_.* {
                               output = MuonDetectors/STG/Expert/Timing/Pad/Q1
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Q2 {
                          hist All_pad_timing_in_Q2_.* {
                               output = MuonDetectors/STG/Expert/Timing/Pad/Q2
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Q3 {
                          hist All_pad_timing_in_Q3_.* {
                               output = MuonDetectors/STG/Expert/Timing/Pad/Q3
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Layer {
                           hist All_pad_timing_per_sector_.* {
                                output = MuonDetectors/STG/Expert/Timing/Pad/Layer
                                algorithm = stg_Ymeans_timing
                           }
                       }
                       dir Sector {
                           hist pad_timing_.* {
                                output = MuonDetectors/STG/Expert/Timing/Pad/Sector
                                algorithm = stg_Xmeans_timing
                           }
                       }
                  }
                  dir Strip {
                      dir Q1 {
                          hist All_strip_timing_in_Q1_.* {
                               output = MuonDetectors/STG/Expert/Timing/Strip/Q1
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Q2 {
                          hist All_strip_timing_in_Q2_.* {
                               output = MuonDetectors/STG/Expert/Timing/Strip/Q2
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Q3 {
                          hist All_strip_timing_in_Q3_.* {
                               output = MuonDetectors/STG/Expert/Timing/Strip/Q3
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Layer {                   
                           hist All_strip_timing_per_sector_.* {
                                output = MuonDetectors/STG/Expert/Timing/Strip/Layer
                                algorithm = stg_Ymeans_timing
                           }
                       }
                       dir Sector {
                           hist strip_timing_.* {
                                output = MuonDetectors/STG/Expert/Timing/Strip/Sector
                                algorithm = stg_Xmeans_timing
                           }
                       }
                  }
                  dir Wire {
                      dir Q1 {
                          hist All_wire_timing_in_Q1_.* {
                               output = MuonDetectors/STG/Expert/Timing/Wire/Q1
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Q2 {
                          hist All_wire_timing_in_Q2_.* {
                               output = MuonDetectors/STG/Expert/Timing/Wire/Q2
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Q3 {
                          hist All_wire_timing_in_Q3_.* {
                               output = MuonDetectors/STG/Expert/Timing/Wire/Q3
                               algorithm = stg_Ymeans_timing
                          }
                      }
                      dir Layer {                   
                           hist All_wire_timing_per_sector_.* {
                                output = MuonDetectors/STG/Expert/Timing/Wire/Layer
                                algorithm = stg_Ymeans_timing
                           }
                       }
                       dir Sector {
                           hist wire_timing_.* {
                                output = MuonDetectors/STG/Expert/Timing/Wire/Sector
                                algorithm = stg_Xmeans_timing
                           }
                       }
                  }
              }
              dir Residuals {
                  regex = 1 
                  algorithm = stgc_Histogram_Not_Empty
                  dir Q1 { 
                      dir (?P<sector>[AC][0-9]{2}) { 
                          hist Residuals_in_Q1_.* {
                               output = MuonDetectors/STG/Expert/Residuals/Q1/${sector}
                               display = Draw=E1,gauspluspol1(-2,2),AxisRange(-2,2,"X")
                               algorithm = stg_gaus_Fit&stgc_Histogram_Not_Empty
                          }
                      }
                  }
                  dir Q2 {
                      dir (?P<sector>[AC][0-9]{2}) {  
                          hist Residuals_in_Q2_.* {
                               output = MuonDetectors/STG/Expert/Residuals/Q2/${sector}
                               display = Draw=E1,gauspluspol1(-2,2),AxisRange(-2,2,"X")
                               algorithm = stg_gaus_Fit&stgc_Histogram_Not_Empty
                          }
                      }
                  }
                  dir Q3 {
                      dir (?P<sector>[AC][0-9]{2}) { 
                          hist Residuals_in_Q3_.* {
                               output = MuonDetectors/STG/Expert/Residuals/Q3/${sector}
                               display = Draw=E1,gauspluspol1(-2,2),AxisRange(-2,2,"X")
                               algorithm = stg_gaus_Fit&stgc_Histogram_Not_Empty
                          }
                      }
                  }
              }
              dir Efficiency {
                  regex = 1
                  dir (?P<sector>[AC][0-9]{2}) {
                      hist Efficiency_per_Radius_.* {
                           output = MuonDetectors/STG/Expert/Efficiency/${sector}
                           algorithm = chi2NDF_check
                      }
                  }
              }
              dir Charge {
                  regex = 1
                  dir Pad {
                      dir Q1Inner {
                          dir A01 {
                              hist All_pad_charge_in_Q1Inner_Layer1 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer2 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer3 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer4 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer5 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer6 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer7 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer8 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A01
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                          }
                          dir A02 {
                              hist All_pad_charge_in_Q1Inner_Layer1 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer2 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer3 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer4 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer5 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer6 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer7 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer8 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A02
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                          }
                          dir A03 {
                              hist All_pad_charge_in_Q1Inner_Layer1 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer2 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer3 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer4 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer5 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer6 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer7 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer8 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A03
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                          }
                          dir A04 {
                              hist All_pad_charge_in_Q1Inner_Layer1 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer2 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer3 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer4 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer5 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer6 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer7 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer8 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A04
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                          }
                          dir A05 {
                              hist All_pad_charge_in_Q1Inner_Layer1 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer2 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer3 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer4 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = Dummy_Algorithm
                              }
                              hist All_pad_charge_in_Q1Inner_Layer5 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer6 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer7 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                              hist All_pad_charge_in_Q1Inner_Layer8 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A05
                                   display = Draw=e1,StatBox 
                                   algorithm = stg_pad_landau_Fit&stgc_Histogram_Not_Empty
                              }
                          }
                          dir A06 {
                              hist All_pad_charge_in_Q1Inner_Layer1 {
                                   output = MuonDetectors/STG/Expert/Charge/Pad/Q1Inner/A06
                                   display = Draw=e1,StatBox 
