############################################################
# MuonCombined
############################################################

#############
# Output
#############

output top_level {

    algorithm = WorstCaseSummary

    output MuonTracking {

        output Shifter {
        }
        
        output Expert {

            weight = 0
            
            output vsLB {
            }
            output Resonances {
                output Z {
                }
                output Jpsi {
                }
            }
            output Muons {
                output Z_Jpsi {
                }                
                output CBMuons {
                }          
                output NonCBMuons {
                }
                output AllCBMuons {
                }          
                output AllNonCBMuons {
                }          
                output NoTrigCBMuons {
                }          
                output NoTrigNonCBMuons {
                }
            }
            output Segments {
                output Z_Jpsi {
                }                   
                output AllMuons {
                }
                output Container {
                }
                output AllMuonsNoTrig {
                }
                output ContainerNoTrig {
                }
            }
            output TracksMS {
                output ContainerNoTrig {
                }
                output Container {
                }
            }
            output TracksID {
                output AllMuonsNoTrig {
                }
                output AllCBMuons {
                }
                output AllNonCBMuons {
                }
                output Z_Jpsi {
                }
            }
            output TracksME {
                output AllMuonsNoTrig {
                }
                output AllCBMuons {
                }
                output AllNonCBMuons {
                }
                output Z_Jpsi {
                }
            }
            output MSVertices {
            }
        }
    }
}

#######################
# Histogram Assessments
#######################


dir MuonPhysics {
    algorithm = MCP_10_events
    dir MSVertices {
        output = MuonTracking/Expert/MSVertices
        hist NoTrig_MSVertices_m_MSVx_nMDT {
}
        hist NoTrig_MSVertices_m_MSVx_nRPC {
}
        hist NoTrig_MSVertices_m_MSVx_nTGC {
}
        hist NoTrig_MSVertices_m_MSVx_nTracklets {
}
        hist NoTrig_MSVertices_m_VertexEtaPhi {
}
} # dir MSVertices
    dir MuonTrkPhys {
        dir Jpsi {
            output = MuonTracking/Expert/Resonances/Jpsi
            hist m_Jpsi_2occupancy {
}
            hist m_Jpsi_M_BA_BA {
}
            hist m_Jpsi_M_BA_BC {
}
            hist m_Jpsi_M_BA_EA {
}
            hist m_Jpsi_M_BA_EC {
}
            hist m_Jpsi_M_BC_BA {
}
            hist m_Jpsi_M_BC_BC {
}
            hist m_Jpsi_M_BC_EA {
}
            hist m_Jpsi_M_BC_EC {
}
            hist m_Jpsi_M_EA_BA {
}
            hist m_Jpsi_M_EA_BC {
}
