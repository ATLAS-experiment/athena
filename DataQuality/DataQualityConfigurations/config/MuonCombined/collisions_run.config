}
            hist m_Jpsi_occy {
}
            hist m_Jpsi_plus_minus_Eta {
}
            hist m_Jpsi_M_Mean {
                display   = Draw=EP,AxisRange(2,4,"Y")
                algorithm = MCP_BinsOutOfRange_Jpsimass
}
            hist m_Jpsi_M_Sigma {
                display   = Draw=EP,AxisRange(0,0.2,"Y")
                algorithm = MCP_BinsOutOfRange_Jpsisigma
}
            hist m_Jpsi_M_Mean_eta {
                display   = Draw=EP,AxisRange(2,4,"Y")
                algorithm = MCP_BinsOutOfRange_Jpsimass
}
            hist m_Jpsi_M_Sigma_eta {
                display   = Draw=EP,AxisRange(0,0.2,"Y")
                algorithm = MCP_BinsOutOfRange_Jpsisigma
}
    hist JpsiMassEta2D {
}
    hist m_Jpsi_M_minus_Eta {
}
    hist m_Jpsi_M_plus_Eta {
}
} # dir Jpsi
        dir Z {
