# **********************************************************************
# ITk Alignment monitoring han configuration
#
# Covers the histograms produced by the ITkAlignmentMonitoring package
# (ITkAlignMon/CombinedITkTracks) on Phase-II / ITk reconstruction.
# Headline residual distributions carry gaussian-fit width checks and
# the stacked module-map profiles carry reference bin-content
# comparisons, ported from the Run 3 InDetAlignment configuration
# (thresholds to be fine-tuned for ITk).  Everything else is swept up
# by all_in_dir with GatherData.
#
# The reference is a Phase-II MC HIST file (ttbar mu=200,
# ATLAS-P2-RUN4-03); it also defines the histogram set swept up by
# all_in_dir at han-config-gen time.  Replace with a centrally managed
# reference once ITk references exist.
# **********************************************************************

#######################
# References
#######################

reference ITkAlignmentReferences {
  location = /eos/user/m/mvessell/dqrun4/run/test-itk-packages/
  file = test_residuals.root
  path = run_350200
  info = ITk MC development reference (ttbar mu=200, ATLAS-P2-RUN4-03)
  name = same_name
}

#############
# Output
#############

output top_level {
  output InnerDetector {
    output ITkAlignment {
      output CombinedITkTracks {
        output GenericTracks {
        }
        output Residuals {
        }
        output PVBiases {
        }
      }
    }
  }
}

#######################
# Histogram Assessments
#######################

dir ITkAlignMon {
  algorithm = ITkAlign_GatherData
  reference = ITkAlignmentReferences

  dir CombinedITkTracks {
    dir GenericTracks {
      output = InnerDetector/ITkAlignment/CombinedITkTracks/GenericTracks
      hist Npixhits_per_track {
        algorithm = ITkAlign_Gen_PixHits
      }
      hist Nstriphits_per_track {
        algorithm = ITkAlign_Gen_StripHits
      }
      hist chi2oDoF {
        algorithm = ITkAlign_Gen_Chi2
      }
      hist all_in_dir {
        reference = ITkAlignmentReferences
      }
    }
    dir Residuals {
      output = InnerDetector/ITkAlignment/CombinedITkTracks/Residuals
      hist pix_b_residualx {
        algorithm = ITkAlign_PixResXGaussFit
        display = AxisRange(-0.15,0.15,"X"), StatBox,gaus(-0.05,0.05)
      }
      hist pix_b_residualy {
        algorithm = ITkAlign_PixResYGaussFit
        display = StatBox,gaus(-0.5,0.5)
      }
      hist pix_eca_residualx {
        algorithm = ITkAlign_PixEcResXGaussFit
        display = StatBox,gaus(-0.1,0.1), AxisRange(-0.2,0.2,"X")
      }
      hist pix_ecc_residualx {
        algorithm = ITkAlign_PixEcResXGaussFit
        display = StatBox,gaus(-0.1,0.1), AxisRange(-0.2,0.2,"X")
      }
      hist pix_eca_residualy {
        algorithm = ITkAlign_PixEcResYGaussFit
        display = StatBox,gaus(-0.5,0.5)
      }
      hist pix_ecc_residualy {
        algorithm = ITkAlign_PixEcResYGaussFit
        display = StatBox,gaus(-0.5,0.5)
      }
      hist strip_b_residualx {
        algorithm = ITkAlign_StripBarrelXGaussFit
        display = Statbox,gaus(-0.08,0.08), AxisRange(-0.2,0.2,"X")
      }
      hist strip_eca_residualx {
        algorithm = ITkAlign_StripEcXGaussFit
        display = Statbox,gaus(-0.5,0.5), AxisRange(-0.2,0.2,"X")
      }
      hist strip_ecc_residualx {
        algorithm = ITkAlign_StripEcXGaussFit
        display = Statbox,gaus(-0.5,0.5), AxisRange(-0.2,0.2,"X")
      }
      hist pix_b_xresvsmodeta_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist pix_b_xresvsmodphi_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist strip_b_xresvsmodeta_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist strip_b_xresvsmodphi_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist pix_eca_xresvsmodphi_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist pix_ecc_xresvsmodphi_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist strip_eca_xresvsmodphi_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist strip_ecc_xresvsmodphi_profile {
        algorithm = ITkAlign_Res_BinContentCompLoose/MaxDiffabs
        display = AxisRange(-0.02,0.02,"Y")
      }
      hist all_in_dir {
        reference = ITkAlignmentReferences
      }
    }
    dir PVBiases {
      output = InnerDetector/ITkAlignment/CombinedITkTracks/PVBiases
      hist trk_d0_wrtPV_vs_eta_10GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_10GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_1GeV_2GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_1GeV_2GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_2GeV_5GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_2GeV_5GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_5GeV_10GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_5GeV_10GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_600MeV_1GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_eta_600MeV_1GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_10GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_10GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_1GeV_2GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_1GeV_2GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_2GeV_5GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_2GeV_5GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_5GeV_10GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_5GeV_10GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_600MeV_1GeV_negative_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist trk_d0_wrtPV_vs_phi_600MeV_1GeV_positive_profile {
        algorithm = ITkAlign_PVbiases_CheckHisto_Mean
      }
      hist all_in_dir {
        reference = ITkAlignmentReferences
      }
    }
  }
}

#############
# Algorithms
#############

algorithm ITkAlign_GatherData {
  libname = libdqm_algorithms.so
  name = GatherData
}

algorithm ITkAlign_Gen_PixHits {
  libname = libdqm_algorithms.so
  name = CheckHisto_Mean&GatherData
  reference = ITkAlignmentReferences
  thresholds = ITkAlign_Gen_PixHits_Thresh
  MinStat = 1000
}

algorithm ITkAlign_Gen_StripHits {
  libname = libdqm_algorithms.so
  name = CheckHisto_Mean&GatherData
  reference = ITkAlignmentReferences
  thresholds = ITkAlign_Gen_StripHits_Thresh
  MinStat = 1000
}

algorithm ITkAlign_Gen_Chi2 {
  libname = libdqm_algorithms.so
  name = CheckHisto_Mean
  reference = ITkAlignmentReferences
  thresholds = ITkAlign_Gen_Chi2_Thresh
  MinStat = 1000
}

algorithm ITkAlign_PixResXGaussFit {
  libname = libdqm_algorithms.so
  name = Simple_gaus_Fit
  thresholds = ITkAlign_PixResXGaussThresholds
  xmin = -0.05
  xmax = 0.05
  MinStat = 1000
  reference = ITkAlignmentReferences
}

algorithm ITkAlign_PixResYGaussFit {
  libname = libdqm_algorithms.so
  name = Simple_gaus_Fit
  thresholds = ITkAlign_PixResYGaussThresholds
  xmin = -0.3
  xmax = 0.3
  MinStat = 1000
  reference = ITkAlignmentReferences
}

algorithm ITkAlign_PixEcResXGaussFit {
  libname = libdqm_algorithms.so
  name = Simple_gaus_Fit
  thresholds = ITkAlign_PixEcResXGaussThresholds
  xmin = -0.05
  xmax = 0.05
  MinStat = 1000
  reference = ITkAlignmentReferences
}

algorithm ITkAlign_PixEcResYGaussFit {
  libname = libdqm_algorithms.so
  name = Simple_gaus_Fit
  thresholds = ITkAlign_PixEcResYGaussThresholds
  xmin = -0.3
  xmax = 0.3
  MinStat = 1000
  reference = ITkAlignmentReferences
}

algorithm ITkAlign_StripBarrelXGaussFit {
  libname = libdqm_algorithms.so
  name = Simple_gaus_Fit
  thresholds = ITkAlign_StripResXGaussThresholds
  xmin = -0.05
  xmax = 0.05
  MinStat = 1000
  reference = ITkAlignmentReferences
}

algorithm ITkAlign_StripEcXGaussFit {
  libname = libdqm_algorithms.so
  name = Simple_gaus_Fit
  thresholds = ITkAlign_StripEcXGaussThresholds
  xmin = -0.05
  xmax = 0.05
  MinStat = 1000
  reference = ITkAlignmentReferences
}

algorithm ITkAlign_Res_BinContentCompLoose {
  libname = libdqm_algorithms.so
  name = BinContentComp
  reference = ITkAlignmentReferences
  thresholds = ITkAlign_Res_BinContentCompLooseThresh
  NSigma = 5
  Value = 0

  algorithm MaxDiffabs {
    MaxDiffAbs = 0.003
  }
}

algorithm ITkAlign_PVbiases_CheckHisto_Mean {
  libname = libdqm_algorithms.so
  name = CheckHisto_Mean&GatherData
  reference = ITkAlignmentReferences
  thresholds = ITkAlign_PVbiases_CheckHisto_Mean_Thresh
  MinStat = 10
}

#############
# Thresholds
#############

thresholds ITkAlign_Gen_PixHits_Thresh {
  limits XMean {
    warning = 2.5
    error = 0
  }
}

thresholds ITkAlign_Gen_StripHits_Thresh {
  limits XMean {
    warning = 7
    error = 0
  }
}

thresholds ITkAlign_Gen_Chi2_Thresh {
  limits XMean {
    warning = 3
    error = 1000.0
  }
}

thresholds ITkAlign_PixResXGaussThresholds {
  limits Sigma {
    warning = 0.03
    error = 1000.0
  }
}

thresholds ITkAlign_PixResYGaussThresholds {
  limits Sigma {
    warning = 0.17
    error = 1000.0
  }
}

thresholds ITkAlign_PixEcResXGaussThresholds {
  limits Sigma {
    warning = 0.03
    error = 1000.0
  }
}

thresholds ITkAlign_PixEcResYGaussThresholds {
  limits Sigma {
    warning = 0.17
    error = 1000.0
  }
}

thresholds ITkAlign_StripResXGaussThresholds {
  limits Sigma {
    warning = 0.045
    error = 1000.0
  }
}

thresholds ITkAlign_StripEcXGaussThresholds {
  limits Sigma {
    warning = 0.054
    error = 1000.0
  }
}

thresholds ITkAlign_Res_BinContentCompLooseThresh {
  limits NBins {
    warning = 1
    error = 1000
  }
}

thresholds ITkAlign_PVbiases_CheckHisto_Mean_Thresh {
  limits AbsYMean {
    warning = 0.005
    error = 0.01
  }
}
