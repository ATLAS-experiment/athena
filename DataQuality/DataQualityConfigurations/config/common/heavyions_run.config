#######################
# References
# 2025 Heavy Ions Runs
# O-O and Ne-Ne: 
#     Use data24_hi.00490156.physics_PC.merge.HIST.f1599_h526.slimmed for all.
#     Will only have express_express and physics_MinBias streams.
#  PbPb:
#     Revert to run 488334 initally
#######################

reference CentrallyManagedReferences {
  location = /eos/atlas/atlascerngroupdisk/data-dqm/references/,root://eosatlas.cern.ch//eos/atlas/atlascerngroupdisk/data-dqm/references/
  file = data24_hi.00490156.physics_PC.merge.HIST.f1599_h526.slimmed
  path = run_490156
  info = Run 490156, express
  #database = heavyions
  name = same_name
}

