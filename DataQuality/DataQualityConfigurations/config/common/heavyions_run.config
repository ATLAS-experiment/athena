#######################
# References
# 2025 Heavy Ions Runs
#  PbPb:
#     Using run 490085 initally
#     Update ZDCCalib reference run to 490223
#######################

reference CentrallyManagedReferences {
  location = /eos/atlas/atlascerngroupdisk/data-dqm/references/,root://eosatlas.cern.ch//eos/atlas/atlascerngroupdisk/data-dqm/references/
  file = data24_hi.00490085.express_express.merge.HIST.x885_h507.slimmed
  path = run_490085
  info = Run 490085, express
  #database = heavyions
  name = same_name
}

