#
# This module is used to set up the runtime environment for Powheg
# 
#

# Set the environment variable(s):

set( ATLAS_POWHEGVER "08-05" CACHE STRING "Version of the Powheg configuration files" )
set( ATLAS_POWHEGPATH ${COMPILEBOX_LCGROOT})

find_package( OpenLoops )
find_package( Lhapdf )

if(LHAPDF_FOUND AND OPENLOOPS_FOUND)
set( POWHEGENVIRONMENT_ENVIRONMENT
    SET POWHEGVER "${ATLAS_POWHEGVER}"
    SET POWHEGPATH "${ATLAS_POWHEGPATH}" 
    FORCESET OPENLOOPSVER ${OPENLOOPS_LCGVERSION} 
    FORCESET OPENLOOPSPATH ${OPENLOOPS_LCGROOT}    
    FORCESET OpenLoopsPath ${OPENLOOPS_LCGROOT}    
    FORCESET LHAPDFVER ${LHAPDF_LCGVERSION} 
    FORCESET LHAPDF_INSTAL_PATH ${LHAPDF_LCGROOT}
    PREPEND LHAPDF_DATA_PATH
      /cvmfs/sft.cern.ch/lcg/external/lhapdfsets/current
    PREPEND LHAPATH
      /cvmfs/sft.cern.ch/lcg/external/lhapdfsets/current    
    APPEND PYTHONPATH
      "${_LHAPDF_PYTHON_PATH}"
    )

# Silently declare the module found.
set( POWHEGENVIRONMENT_FOUND TRUE )
endif()
set(COMPILEBOX_FOUND TRUE)
lcg_need_rpm(compilebox)

