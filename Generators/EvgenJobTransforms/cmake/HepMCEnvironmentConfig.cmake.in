# Set the environment variable(s):

set( ATLAS_HEPMCVER "3" CACHE STRING
   "Version of HEPMC" )

set( HEPMCENVIRONMENT_ENVIRONMENT
    SET HEPMCVER "${ATLAS_HEPMCVER}" )

# Silently declare the module found.
set( HEPMCENVIRONMENT_FOUND TRUE )

