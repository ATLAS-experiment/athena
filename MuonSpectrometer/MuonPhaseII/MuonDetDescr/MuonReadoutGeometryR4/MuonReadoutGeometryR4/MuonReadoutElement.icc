#ifndef MUONGEOMODELR4_MUONREADOUTELEMENT_ICC
#define MUONGEOMODELR4_MUONREADOUTELEMENT_ICC

#include <ActsGeoUtils/TransformCache.h>

namespace ActsTrk{
    template <> inline Amg::Transform3D 
        TransformCacheDetEle<MuonGMR4::MuonReadoutElement>::fetchTransform(const DetectorAlignStore* store) const {
        return m_parent->toStation(store) * MuonGMR4::detail::rotationToAMDB(detectorType());
    }
}

namespace MuonGMR4 {

inline const GeoAlignableTransform* MuonReadoutElement::alignableTransform() const { return m_args.alignTransform; }
inline Identifier MuonReadoutElement::identify() const { return m_args.detElId; }
inline IdentifierHash MuonReadoutElement::identHash() const { return m_detElHash;}
inline const std::string& MuonReadoutElement::chamberDesign() const { return m_args.chambDesign; }
inline const Muon::IMuonIdHelperSvc* MuonReadoutElement::idHelperSvc() const { return m_idHelperSvc.get(); }
inline Muon::MuonStationIndex::ChIndex MuonReadoutElement::chamberIndex() const { return m_chIdx; }
inline int MuonReadoutElement::stationName() const { return m_stName; }
inline int MuonReadoutElement::stationEta() const { return m_stEta; }
inline int MuonReadoutElement::stationPhi() const { return m_stPhi; }

/// Returns the detector center (Which is the same as the detector center of the
/// first measurement layer)
inline Amg::Vector3D MuonReadoutElement::center(const ActsTrk::GeometryContext& ctx) const {
    return localToGlobalTransform(ctx).translation();
}
inline Amg::Vector3D MuonReadoutElement::center(const ActsTrk::GeometryContext& ctx,
                                                const Identifier& id) const {
    return localToGlobalTransform(ctx, id).translation();
}
inline Amg::Vector3D MuonReadoutElement::center(const ActsTrk::GeometryContext& ctx, 
                                                const IdentifierHash& hash) const {
    return localToGlobalTransform(ctx, hash).translation();
}
inline Amg::Transform3D MuonReadoutElement::globalToLocalTransform(const ActsTrk::GeometryContext& ctx, 
                                                               const IdentifierHash& hash) const {   
    return localToGlobalTransform(ctx, hash).inverse();
}
inline Amg::Transform3D MuonReadoutElement::globalToLocalTransform(const ActsTrk::GeometryContext& ctx, 
                                                               const Identifier& id) const {
    return globalToLocalTransform(ctx, layerHash(id));
}
inline const Amg::Transform3D& MuonReadoutElement::localToGlobalTransform(const ActsTrk::GeometryContext& ctx, 
                                                                      const Identifier& id) const {
    return localToGlobalTransform(ctx, layerHash(id));
}
#ifndef SIMULATIONBASE
inline const SpectrometerSector* MuonReadoutElement::msSector() const { return m_msSectorLink; }
inline const Chamber* MuonReadoutElement::chamber() const { return m_chambLink; }
#endif

inline const Amg::Transform3D& MuonReadoutElement::localToGlobalTransform(const ActsTrk::GeometryContext& ctx, 
                                                                   const IdentifierHash& hash) const {
    const ActsTrk::TransformCache* cache = transformCache(hash);
    if (cache) {
        return cache->getTransform(ctx.getStore(detectorType()).get());
    }
    ATH_MSG_FATAL(__FILE__<<":"<<__LINE__<<" "<<__func__<<"() -- "
                <<idHelperSvc()->toStringDetEl(identify())<<" hash: "<<hash<<" is unknown.");
    static const Amg::Transform3D dummyTrf{Amg::Transform3D::Identity()};
    return dummyTrf;
}

inline const ActsTrk::TransformCache* MuonReadoutElement::transformCache(const IdentifierHash& measHash) const {
    if (measHash == geoTransformHash()) {
        return m_centralTrfCache.get();
    }
    return m_localToGlobalCaches.size() > static_cast<unsigned>(measHash) ? 
           m_localToGlobalCaches[measHash].get() : nullptr;
}
template<class MuonImpl>
StatusCode MuonReadoutElement::insertTransform(const IdentifierHash& hash) {
    const unsigned idx = static_cast<unsigned>(hash);
    ATH_MSG_VERBOSE(__FILE__<<":"<<__LINE__<<" - "<<idHelperSvc()->toStringDetEl(identify())
                 <<" Insert new transform cache: "<<idx);

    if (m_localToGlobalCaches.size() <= idx) {
        m_localToGlobalCaches.resize(idx+1);
    }
    if (m_localToGlobalCaches[idx]) {
        ATH_MSG_FATAL(__FILE__<<":"<<__LINE__<<" - "<<idHelperSvc()->toStringDetEl(identify())
                   <<" has already a transformation cached for hash "<<hash);
        return StatusCode::FAILURE;
    }
    m_localToGlobalCaches[idx] = std::make_unique<ActsTrk::TransformCacheDetEle<MuonImpl>>(hash, static_cast<MuonImpl*>(this));
    return StatusCode::SUCCESS;
}

}  // namespace MuonGMR4
#endif
