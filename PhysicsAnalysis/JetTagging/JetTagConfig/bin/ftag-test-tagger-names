#!/usr/bin/env python

"""
Test that taggers follow flavor tagging naming conventions
"""

from FlavorTagInference.FlavorTagNNConfig import getModifierSet

from AthenaConfiguration.AllConfigFlags import initConfigFlags
from AthenaConfiguration.Enums import LHCPeriod, ProductionStep

from argparse import ArgumentParser
import os, sys, re

def get_args():
    parser = ArgumentParser()
    parser.add_argument('-v', '--verbose', action='store_true')
    return parser.parse_args()

jetmet_tagger = re.compile('.*/CalibArea(-[0-9]{2}){3}/.*')

def run():
    args = get_args()
    flags = initConfigFlags()

    # some flags are only automatically set if we have inputs, short
    # circuit that by defining them
    flags.GeoModel.Run = LHCPeriod.Run3
    # Some of the taggers are disabled outside derivations, but we
    # want to test them all
    flags.Common.ProductionStep = ProductionStep.Derivation

    if args.verbose:
        verb_out = sys.stdout
    else:
        verb_out = open(os.devnull, 'w')

    for jetcol, taggers in flags.BTagging.NNs.items():
        verb_out.write(f'In jet collection {jetcol}\n')
        for tagger in taggers:
            for fold in tagger['folds']:
                verb_out.write(f'checking path {fold}\n')
                if jetmet_tagger.match(fold):
                    verb_out.write(f'skipping jetmet tagger {fold}\n')
                    continue
                # we assume a format ending with name/jetcol/network.onnx
                tagger_name = fold.split('/')[-3]
                verb_out.write(f'tagger {tagger_name}\n')
                modset = getModifierSet(tagger_name)
                verb_out.write(f'mods: {modset}\n')
    return 0

if __name__ == "__main__":
    run()
