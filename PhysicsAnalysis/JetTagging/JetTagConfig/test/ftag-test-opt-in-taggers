def _fake_triton_name(path):
    """Stand-in for tritonModelName that needs no CALIBPATH lookup."""
    return 'fake_' + PurePath(path).stem


def _handle_name(handle):
    """Instance name of a service handle (a configurable or its string)."""
    if hasattr(handle, 'getName'):
        return handle.getName()
    return str(handle).split('/')[-1]


class TestTriton(unittest.TestCase):

    def test_shipped_name(self):
        # tritonModelName (PyUtils.TritonUtils) resolves the file on
        # CALIBPATH, here the dev file on cvmfs GroupData, which ctest and
        # CI have. The name is dev_<stem[:20]>_<sha256(resolved path)[:12]>.
        self.assertEqual(tritonModelName(GN3LARGE_PATH), GN3LARGE_TRITON_NAME)

    @staticmethod
    def svc(useTriton, files):
        ca = ComponentAccumulator()
        s = addAndReturnSharingSvc(useTriton, ca, files)
        ca.wasMerged()
        return s

    @unittest.skipUnless(_has_triton_svc(),
                         'NNSharingTritonSvc not built (AthAnalysis)')
    def test_routing(self):
        # (i) useTriton: Triton, one '<path>:<name>' entry per file
        s = self.svc(True, [GN3LARGE_PATH])
        self.assertIn('Triton', s.getType())
        self.assertEqual(set(s.TritonModelsNames),
                         {f'{GN3LARGE_PATH}:{GN3LARGE_TRITON_NAME}'})

        # (ii) no useTriton: ONNX
        self.assertIn('Onnx', self.svc(False, [GN3LARGE_PATH]).getType())

        # (iii) a multifold tagger gets one entry per fold
        with mock.patch.object(FTNN, 'tritonModelName',
                               side_effect=_fake_triton_name):
            s = self.svc(True, GN2V01_FOLDS)
        self.assertIn('Triton', s.getType())
        self.assertEqual(
            set(s.TritonModelsNames),
            {f'{p}:fake_network_fold{i}' for i, p in enumerate(GN2V01_FOLDS)})
        self.assertEqual(len(set(s.TritonModelsNames)), 4)

    @unittest.skipUnless(_has_triton_svc(),
                         'NNSharingTritonSvc not built (AthAnalysis)')
    def test_routing_dedup(self):
        # two taggers with different files share one service, which must
        # carry the entries of both. A failure here means the CA
        # deduplication does not union the std::set property: a finding
        # about !92294, not something to work around in this test.
        ca1 = ComponentAccumulator()
        addAndReturnSharingSvc(True, ca1, [GN3LARGE_PATH])
        ca2 = ComponentAccumulator()
        with mock.patch.object(FTNN, 'tritonModelName',
                               side_effect=_fake_triton_name):
            addAndReturnSharingSvc(True, ca2, GN2V01_FOLDS)
        ca1.merge(ca2)
        names = set(
            ca1.getService('FTagNNSharingTritonSvc').TritonModelsNames)
        self.assertEqual(names, {
            f'{GN3LARGE_PATH}:{GN3LARGE_TRITON_NAME}',
            *(f'{p}:fake_network_fold{i}' for i, p in enumerate(GN2V01_FOLDS)),
        })
        ca1.wasMerged()

    @unittest.skipUnless(_has_triton_svc(),
                         'NNSharingTritonSvc not built (AthAnalysis)')
    def test_opt_in_full_chain(self):
        """The opt-in entry from getNNs, scheduled with MultifoldGNNCfg.

        A configuration-level test: useTriton is passed here by hand, so
        this is not proof that BTagging.UseTriton propagates through the
        production chain (see test_production_chain_forwards_use_triton).
        """
        flags = _flags(opt_in=[GN3LARGE_FILE])
        flags.BTagging.UseTriton = True
        entry, = [n for n in getNNs(flags)['AntiKt4EMPFlowJets']
                  if n['folds'] == [GN3LARGE_PATH]]
        acc = FTNN.MultifoldGNNCfg(
            flags, 'AntiKt4EMPFlowJets', 'InDetTrackParticles',
            entry['folds'], dependencies=entry.get('dependencies'),
            useTriton=flags.BTagging.UseTriton)
        self.assertIn(
            f'{GN3LARGE_PATH}:{GN3LARGE_TRITON_NAME}',
            set(acc.getService('FTagNNSharingTritonSvc').TritonModelsNames))
        acc.wasMerged()

    @unittest.skipUnless(_has_triton_svc(),
                         'NNSharingTritonSvc not built (AthAnalysis)')
    def test_production_chain_forwards_use_triton(self):
        # Through the production entry point, which reads
        # BTagging.UseTriton itself: useTriton is not passed here.
        # The support algorithms need an input file to configure and are
        # not under test, so they are replaced by empty accumulators;
        # MultifoldGNNCfg is the real one.
        from BTagging import FlavorTaggingConfig as FTC

        def empty(*args, **kwargs):
            return ComponentAccumulator()

        for use_triton in (True, False):
            with self.subTest(UseTriton=use_triton):
                flags = _flags(opt_in=[GN3LARGE_FILE])
                flags.BTagging.UseTriton = use_triton
                entry, = [n for n in flags.BTagging.NNs['AntiKt4EMPFlowJets']
                          if n['folds'] == [GN3LARGE_PATH]]
                with mock.patch.multiple(
                        FTC,
                        BTagTrackAugmenterAlgCfg=mock.DEFAULT,
                        JetTagVertexDecoratorCfg=mock.DEFAULT,
                        TaggerDependenciesCfg=mock.DEFAULT,
                        JetParticleAssociationAlgCfg=mock.DEFAULT,
                ) as patched:
                    for patch in patched.values():
                        patch.side_effect = empty
                    acc = FTC._FlavorTaggingChainCfg(
                        flags, 'AntiKt4EMPFlowJets', nns=[entry])
                services = {s.getName(): s for s in acc.getServices()}
                decorator, = [
                    alg.decorator for alg in acc.getEventAlgos()
                    if alg.getName().startswith('FtagNN_')
                    and getattr(alg.decorator, 'nnFile', None) == GN3LARGE_PATH
                ]
                svc_name = _handle_name(decorator.nnSharingService)
                if use_triton:
                    self.assertIn('FTagNNSharingTritonSvc', services)
                    self.assertIn(
                        f'{GN3LARGE_PATH}:{GN3LARGE_TRITON_NAME}',
                        set(services['FTagNNSharingTritonSvc'].TritonModelsNames))
                    self.assertEqual(svc_name, 'FTagNNSharingTritonSvc')
                    self.assertIn('Triton', services[svc_name].getType())
                else:
                    self.assertIn('FTagNNSharingOnnxSvc', services)
                    self.assertNotIn('FTagNNSharingTritonSvc', services)
                    self.assertEqual(svc_name, 'FTagNNSharingOnnxSvc')
                acc.wasMerged()


