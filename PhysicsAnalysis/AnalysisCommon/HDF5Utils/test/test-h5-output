#!/usr/bin/env bash
set -eu

# check that one number we set is there
TMP=$(mktemp)
h5dump -o $TMP -y -d '4d[0,1,2,3,4]' output.h5 > /dev/null
EIGHTY_SIX=$(cat $TMP | xargs | paste -s | cut -d , -f 2)
if (( $EIGHTY_SIX != 86 )); then
    echo "test magic number is incorrect ($EIGHTY_SIX != 86)"
    exit 1
fi
