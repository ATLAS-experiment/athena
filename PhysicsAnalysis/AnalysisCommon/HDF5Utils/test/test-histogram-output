#!/usr/bin/env bash
set -eu

function check() {
    # check that one number we set is there
    local TMP=$(mktemp)
    h5dump -o $TMP -y -d $1 hists.h5 > /dev/null
    local NUMBER=$(cat $TMP | xargs )
    if [[ $NUMBER == $2 ]]; then
        true #echo "number in $1 is correct! ($NUMBER)"
    else
        echo "test magic number is incorrect ($NUMBER != $2)"
        return 1
    fi
}

# weighted hist (storage/values)
check 'h3dw/storage/values[0,1,2]' 0.5
check 'h3dw/storage/values[0,1,3]' 10
check 'h3dw/storage/values[0,1,1]' 0

# profile hist (storage/*)
check 'h3dp/storage/sum_of_weights_squared[0,1,0]' 0
check 'h3dp/storage/sum_of_weights_squared[0,1,2]' 0.5
check 'h3dp/storage/sum_of_weights[0,1,2]' 1
check 'h3dp/storage/count[0,1,2]' 2
check 'h3dp/storage/variances[0,1,2]' 0

# category hist (storage/values)
check 'h1c/storage/values[0]' 0
check 'h1c/storage/values[2]' 1
check 'h1c/storage/values[4]' 1

# integer storage (storage/values): layout is [underflow, bin0, bin1, bin2, overflow]
check 'h1i/storage/values[1]' 1
check 'h1i/storage/values[2]' 2

# atomic integer storage (storage/values)
check 'h1a/storage/values[2]' 1
check 'h1a/storage/values[3]' 1

# thread-safe double storage (storage/values)
check 'h1td/storage/values[1]' 1
check 'h1td/storage/values[2]' 2

# thread-safe float storage (storage/values)
check 'h1tf/storage/values[2]' 1
check 'h1tf/storage/values[3]' 2
