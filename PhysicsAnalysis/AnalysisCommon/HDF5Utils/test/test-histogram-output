set -eu

declare -A TYPE_MAP
TYPE_MAP[i64]='H5T_STD_I64'
TYPE_MAP[f32]='H5T_IEEE_F32'
TYPE_MAP[f64]='H5T_IEEE_F64'
TYPE_MAP[u8]='H5T_STD_U8'
TYPE_MAP[u16]='H5T_STD_U16'

function check() {
    local DATASET="$1"   # with [index], e.g. 'h1i/storage/values[1]'
    local TYPE="$2"      # short key from TYPE_MAP
    local VALUE="$3"     # expected numeric value
    local FILE="$4"      # required (no default)

    # value check
    local TMP; TMP=$(mktemp)
    h5dump -o "$TMP" -y -d "$DATASET" "$FILE" > /dev/null
    local NUMBER; NUMBER=$(cat "$TMP" | xargs)
    if [[ "$NUMBER" != "$VALUE" ]]; then
        echo "value check failed for $DATASET in $FILE: expected '$VALUE', got '$NUMBER'"
        return 1
    fi

    # type check (strip the [index] suffix to get the base dataset path)
    local BASE="${DATASET%%\[*}"
    local EXPECTED="${TYPE_MAP[$TYPE]}"
    if ! h5dump -p -d "$BASE" "$FILE" 2>/dev/null | grep -q "$EXPECTED"; then
        local ACTUAL
        ACTUAL=$(h5dump -p -d "$BASE" "$FILE" 2>/dev/null \
                 | grep "DATATYPE" | head -1 | xargs)
        echo "type check failed for $BASE in $FILE: expected '$EXPECTED', got '$ACTUAL'"
        return 1
    fi
}

function should_fail() {
    if "$@" > /dev/null 2>&1; then
        echo "should_fail: test unexpectedly passed: $*"
        return 1
    fi
}

# weighted hist (storage/values)
check 'h3dw/storage/values[0,1,2]' f64 0.5  hists.h5
check 'h3dw/storage/values[0,1,3]' f64 10   hists.h5
check 'h3dw/storage/values[0,1,1]' f64 0    hists.h5

# profile hist (storage/*)
check 'h3dp/storage/sum_of_weights_squared[0,1,0]' f64 0    hists.h5
check 'h3dp/storage/sum_of_weights_squared[0,1,2]' f64 0.5  hists.h5
check 'h3dp/storage/sum_of_weights[0,1,2]'         f64 1    hists.h5
check 'h3dp/storage/count[0,1,2]'                  f64 2    hists.h5
check 'h3dp/storage/variances[0,1,2]'              f64 0    hists.h5

# category hist (storage/values)
check 'h1c/storage/values[0]' f64 0  hists.h5
check 'h1c/storage/values[2]' f64 1  hists.h5
check 'h1c/storage/values[4]' f64 1  hists.h5

# integer storage (storage/values): layout is [underflow, bin0, bin1, bin2, overflow]
check 'h1i/storage/values[1]' i64 1  hists.h5
check 'h1i/storage/values[2]' i64 2  hists.h5

# atomic integer storage (storage/values)
check 'h1a/storage/values[2]' i64 1  hists.h5
check 'h1a/storage/values[3]' i64 1  hists.h5

# thread-safe double storage (storage/values)
check 'h1td/storage/values[1]' f64 1  hists.h5
check 'h1td/storage/values[2]' f64 2  hists.h5

# thread-safe float storage (storage/values)
check 'h1tf/storage/values[2]' f32 1  hists.h5
check 'h1tf/storage/values[3]' f32 2  hists.h5

# uint8 storage
check 'h1u8/storage/values[2]'  u8  1  hists.h5
check 'h1u8/storage/values[3]'  u8  1  hists.h5

# uint16 storage
check 'h1u16/storage/values[2]' u16 1  hists.h5
check 'h1u16/storage/values[3]' u16 1  hists.h5

# --- merge checks ---
# Copy the file and merge both copies; values double for additive types.
cp hists.h5 hists2.h5
hdf5-merge --overwrite hists.h5 hists2.h5 -o merged.h5

# double storage: 1 fill per file → 2 after merge
check 'h3d/storage/values[0,1,2]'     f64 2     merged.h5
# weighted storage
check 'h3dw/storage/values[0,1,2]'    f64 1     merged.h5
check 'h3dw/storage/values[0,1,3]'    f64 20    merged.h5
check 'h3dw/storage/variances[0,1,2]' f64 0.5   merged.h5
# weighted_mean storage
check 'h3dp/storage/sum_of_weights[0,1,2]'  f64 2  merged.h5
check 'h3dp/storage/count[0,1,2]'           f64 4  merged.h5
check 'h3dp/storage/values[0,1,2]'          f64 1  merged.h5
# integer storage
check 'h1i/storage/values[1]'  i64 2  merged.h5
check 'h1i/storage/values[2]'  i64 4  merged.h5

# type preservation: merged datasets must keep their original HDF5 type
check 'h1tf/storage/values[2]' f32 2   merged.h5
check 'h1td/storage/values[1]' f64 2   merged.h5
check 'h1a/storage/values[2]'  i64 2   merged.h5

# uint8 merged
check 'h1u8/storage/values[2]'  u8  2  merged.h5
check 'h1u8/storage/values[3]'  u8  2  merged.h5

# uint16 merged
check 'h1u16/storage/values[2]' u16 2  merged.h5
check 'h1u16/storage/values[3]' u16 2  merged.h5

# merge merged.h5 (2x) with the original (1x) → values triple
hdf5-merge --overwrite merged.h5 hists.h5 -o triple.h5
check 'h1i/storage/values[1]' i64 3 triple.h5

# self-test: verify that check detects wrong inputs
should_fail check 'h1i/storage/values[1]' i64 99  merged.h5  # wrong value
should_fail check 'h1i/storage/values[1]' f32 2   merged.h5  # wrong type

# --- axis-type and value checks ---

# h1v: variable-width axis — edges dataset must be float64
check 'h1v/ref_axes/axis_0/edges[0]' f64 0   hists.h5
check 'h1v/ref_axes/axis_0/edges[3]' f64 10  hists.h5
# storage values for h1v: bh::axis::variable has underflow+overflow by default,
# so layout is [underflow, bin0, bin1, bin2, overflow]
check 'h1v/storage/values[1]' f64 1  hists.h5   # bin 0 [0,1) <- h1v(0.5)
check 'h1v/storage/values[2]' f64 1  hists.h5   # bin 1 [1,3) <- h1v(2.0)

# h1c: category<short> axis {0,4,5,15} — categories dataset must be int64
check 'h1c/ref_axes/axis_0/categories[0]' i64 0   hists.h5
check 'h1c/ref_axes/axis_0/categories[1]' i64 4   hists.h5
check 'h1c/ref_axes/axis_0/categories[3]' i64 15  hists.h5

# h_fmap: map-based labels, bin order = {b, light, c, tau}, two fills
# category axis has no underflow; layout: [bin0, bin1, bin2, bin3, overflow]
check 'h_fmap/storage/values[0]' f64 1  hists.h5   # Flav::b
check 'h_fmap/storage/values[1]' f64 1  hists.h5   # Flav::light
check 'h_fmap/storage/values[2]' f64 0  hists.h5   # Flav::c (unfilled)

# h_olist: deque list override, shape [letters=3][digits=2][pt=4].
# Fill (letters=0, digits=10->bin0, pt=0.5->bin0+uf=1): [0,0,1]
check 'h_olist/storage/values[0,0,1]' f64 1  hists.h5
check 'h_olist/storage/values[0,0,0]' f64 0  hists.h5

# h_omap: unordered_map override, same shape [3][2][4].
# Fill (letters=1, digits=20->bin1, pt=1.5->bin1+uf=2): [1,1,2]
check 'h_omap/storage/values[1,1,2]' f64 1  hists.h5
check 'h_omap/storage/values[0,0,0]' f64 0  hists.h5
