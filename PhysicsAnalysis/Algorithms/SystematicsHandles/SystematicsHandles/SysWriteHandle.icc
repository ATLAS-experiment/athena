//
// includes
//

#include <AsgDataHandles/WriteHandle.h>
#include <AsgMessaging/MessageCheck.h>
#include <AsgMessaging/StatusCode.h>
#include <SystematicsHandles/AthenaDependencyHelpers.h>
#include <SystematicsHandles/ISystematicsSvc.h>
#include <SystematicsHandles/SysListHandle.h>

//
// method implementations
//

namespace CP
{
  template<typename T,typename Aux> template<typename T2> SysWriteHandle<T,Aux> ::
  SysWriteHandle (T2 *owner, const std::string& propertyName,
                  const std::string& propertyValue,
                  const std::string& propertyDescription)
    : SysWriteHandle (propertyValue, owner)
  {
    owner->declareProperty (propertyName, m_outputName, propertyDescription);
    owner->declareProperty (propertyName + "Type", m_outputType,
                            "an explicit type name for output dependencies");
  }


  template<typename T,typename Aux> template<typename T2> SysWriteHandle<T,Aux> ::
  SysWriteHandle (const std::string &outputName, T2 *owner)
    : AsgMessagingForward (owner), m_outputName (outputName)
  {
#ifndef XAOD_STANDALONE
    m_addAlgDependency = [owner](const DataObjID& id, Gaudi::DataHandle::Mode mode) {
      owner->addDependency(id, mode);
    };
#endif
  }



  template<typename T,typename Aux> bool SysWriteHandle<T,Aux> ::
  empty () const noexcept
  {
    return m_outputName.empty();
  }



  template<typename T,typename Aux> SysWriteHandle<T,Aux> ::
  operator bool () const noexcept
  {
    return !m_outputName.empty();
  }



  template<typename T,typename Aux> std::string SysWriteHandle<T,Aux> ::
  getNamePattern () const
  {
    return m_outputName;
  }



  template<typename T,typename Aux> StatusCode SysWriteHandle<T,Aux> ::
  initialize (SysListHandle& sysListHandle)
  {
    return sysListHandle.addHandle (*this);
  }



  template<typename T,typename Aux> StatusCode SysWriteHandle<T,Aux> ::
  initialize (SysListHandle& sysListHandle, SG::AllowEmptyEnum)
  {
    if (!empty())
      return initialize (sysListHandle);
    else
      return StatusCode::SUCCESS;
  }



  template<typename T,typename Aux> const std::string& SysWriteHandle<T,Aux> ::
  getName (const CP::SystematicSet& sys) const
  {
    return getWriteHandle (sys).key();
  }



  template<typename T,typename Aux> template<typename,typename>
  ::StatusCode SysWriteHandle<T,Aux> ::
  record (std::unique_ptr<T> object, const CP::SystematicSet& sys,
          const EventContext& ctx) const
  {
    SG::WriteHandle<T> handle (getWriteHandle (sys), ctx);
    return handle.recordNonConst (std::move (object));
  }



  template<typename T,typename Aux> template<typename,typename>
  ::StatusCode SysWriteHandle<T,Aux> ::
  record (std::unique_ptr<T> object, std::unique_ptr<Aux> aux,
          const CP::SystematicSet& sys,
          const EventContext& ctx) const
  {
    SG::WriteHandle<T> handle (getWriteHandle (sys), ctx);
    return handle.recordNonConst (std::move (object), std::move (aux));
  }



  template<typename T,typename Aux> CP::SystematicSet SysWriteHandle<T,Aux> ::
  getInputAffecting (const ISystematicsSvc& /*svc*/) const
  {
    return CP::SystematicSet ();
  }



  template<typename T,typename Aux> StatusCode SysWriteHandle<T,Aux> ::
  fillSystematics (const ISystematicsSvc& svc,
                   const CP::SystematicSet& fullAffecting,
                   const std::vector<CP::SystematicSet>& sysList)
  {
    if (!empty())
    {
      for (auto& sys : sysList)
      {
        std::string newName;
        ANA_CHECK (svc.makeSystematicsName (newName, m_outputName, sys));
        ANA_MSG_DEBUG ("SysWriteHandle: " << newName << " (" << sys.name() << ")");
        SG::WriteHandleKey<T> writeHandle (newName);
        ANA_CHECK (writeHandle.initialize ());
        m_sysData.emplace (sys, SysData{std::move (writeHandle)});
      }
    }
    ANA_CHECK (svc.setObjectSystematics (m_outputName, fullAffecting));

    ANA_CHECK (addDecorationDependency(svc, "", false));

    return StatusCode::SUCCESS;
  }



  template<typename T,typename Aux> StatusCode SysWriteHandle<T,Aux> ::
  addDecorationDependency (const ISystematicsSvc& svc, const std::string& decoName, bool decoWrite)
  {
#ifdef XAOD_STANDALONE
    (void) svc;
    (void) decoName;
    (void) decoWrite;
    return StatusCode::SUCCESS;
#else
    const CLID clid = detail::getClidForDependency<T>(m_outputType, decoName, decoWrite);
    ANA_CHECK (detail::addSysDependency(msg(), svc, m_addAlgDependency, clid, m_outputName, Gaudi::DataHandle::Writer, decoName, decoWrite));
    return StatusCode::SUCCESS;
#endif
  }



  template<typename T,typename Aux> const SG::WriteHandleKey<T>& SysWriteHandle<T,Aux> ::
  getWriteHandle (const CP::SystematicSet& sys) const
  {
    auto cache = m_sysData.find (sys);
    if (cache == m_sysData.end())
    {
      if (m_sysData.empty())
        throw std::logic_error ("uninitialized SysWriteHandle (" + m_outputName + ")");
      else
        throw std::logic_error ("unsupported systematic in SysWriteHandle (" + m_outputName + "): (" + sys.name() + ")");
    }
    return cache->second.writeHandle;
  }
}
