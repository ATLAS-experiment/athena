# Declare the package name:
atlas_subdir( PixelToTPIDDualTool )

# External dependencies:
# NB: what about CLHEP?
find_package( ROOT COMPONENTS Core Hist RIO TMVA )

# Libraries in the package:
# NB: What about ${CLHEP_INCLUDE_DIRS} and ${CLHEP_LIBRARIES}?
atlas_add_library( PixelToTPIDDualToolLib
   PixelToTPIDDualTool/*.h Root/*.cxx
   PUBLIC_HEADERS PixelToTPIDDualTool
   INCLUDE_DIRS ${ROOT_INCLUDE_DIRS}
   LINK_LIBRARIES ${ROOT_LIBRARIES} AsgTools xAODEventInfo PATCoreLib AsgDataHandlesLib PATInterfaces xAODTracking PathResolver TrkAnalysisInterfacesLib 
   PixelConditionsData PixelGeoModelLib
   PRIVATE_LINK_LIBRARIES )

if( NOT XAOD_STANDALONE )
    target_link_libraries(PixelToTPIDDualToolLib PRIVATE TrkTrack TrkRIO_OnTrack InDetRIO_OnTrack TrkSurfaces TrkEventPrimitives TrkMeasurementBase  InDetIdentifier PixelGeoModelLib PixelConditionsData StoreGateLib GaudiKernel TrkToolInterfaces) # TrkParametersIdentifier
endif()

if( NOT XAOD_STANDALONE )
   atlas_add_component( PixelToTPIDDualTool
      src/*.h src/*.cxx src/components/*.cxx
      LINK_LIBRARIES AthenaBaseComps GaudiKernel xAODCore PathResolver xAODTracking
      PixelToTPIDDualToolLib PATCoreLib Identifier InDetIdentifier InDetRIO_OnTrack 
      TrkToolInterfaces TrkAnalysisInterfacesLib )
#      TrkTrack TrkSurfaces TrkMeasurementBase TrkParameters TrkRIO_OnTrack TrkToolInterfaces TrkAnalysisInterfacesLib PixelGeoModelLib PixelConditionsData )
endif()

atlas_add_dictionary( PixelToTPIDDualToolDict
   PixelToTPIDDualTool/PixelToTPIDDualToolDict.h
   PixelToTPIDDualTool/selection.xml
   LINK_LIBRARIES PixelToTPIDDualToolLib )

# Executable(s) in the package:
if( XAOD_STANDALONE )
   atlas_add_executable( PixelToTPIDDualToolTester
      util/PixelToTPIDDualToolTester.cxx
      INCLUDE_DIRS ${ROOT_INCLUDE_DIRS}
      LINK_LIBRARIES ${ROOT_LIBRARIES} xAODRootAccess xAODEventInfo xAODMuon
      xAODTracking xAODCore PixelToTPIDDualToolLib PATCoreLib )
endif()



# Test(s) in the package: 

# Install files from the package:
atlas_install_python_modules( python/*.py POST_BUILD_CMD ${ATLAS_FLAKE8} )
