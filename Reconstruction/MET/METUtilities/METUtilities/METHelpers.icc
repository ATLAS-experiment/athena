// Template definitions

namespace met {

    // Hides these from other code that might include METHelpers.h
  namespace accessors {
    static const SG::ConstAccessor< std::vector< ElementLink< xAOD::IParticleContainer> > > constitObjLinks("ConstitObjectLinks");
    static const SG::ConstAccessor< std::vector< float > > constitObjWeights("ConstitObjectWeights");
  }

  template <class T>
  std::vector<const T*> getMETElements(const xAOD::MissingET& met) {
    using namespace msgMET;

    const auto& uniqueLinks = accessors::constitObjLinks(met);
    std::vector<const T*> objs_out{};
    objs_out.reserve(uniqueLinks.size());
    // Loop through links
    for (const auto& link: uniqueLinks){
      if (link.isValid()) {
        const T* obj = dynamic_cast<const T*>(*link);
        if(obj == nullptr) {
          ANA_MSG_WARNING("Mismatched element type retrieved from " << met.name());
          objs_out.push_back(nullptr);
        } else {
          objs_out.push_back(obj);
        }
      } else {
        ANA_MSG_WARNING("Invalid ElementLink from MET term " << met.name());
        objs_out.push_back(nullptr);        
      }
    }

    return objs_out;
  }

  template <class T>
  std::vector<std::pair<const T*,float> > getMETElementsWeights(const xAOD::MissingET& met) {
    using namespace msgMET;

    const auto& uniqueLinks = accessors::constitObjLinks(met);
    const auto& uniqueWeights = accessors::constitObjWeights(met);
    std::vector<std::pair<const T*,float> > objs_weights_out{};
    objs_weights_out.reserve(uniqueLinks.size());
    // Loop through links
    for (size_t i=0; i<uniqueLinks.size(); ++i) {
      auto& link = uniqueLinks[i];
      float weight = uniqueWeights[i];
      if (link.isValid()) {
        const T* obj = dynamic_cast<const T*>(*link);
        if(obj == nullptr) {
          ANA_MSG_WARNING("Mismatched element type retrieved from " << met.name());
          objs_weights_out.push_back(std::make_pair(nullptr,0));        
        } else {
          objs_weights_out.push_back(std::make_pair(obj,weight));
        }
      } else {
          ANA_MSG_WARNING("Invalid ElementLink from MET term " << met.name());
          objs_weights_out.push_back(std::make_pair(nullptr,0));        
      }
    }

    return objs_weights_out;
  }

}