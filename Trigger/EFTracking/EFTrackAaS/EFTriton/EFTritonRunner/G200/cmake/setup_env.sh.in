#!/bin/bash
#
# Generated by CMake at configure time -- do not edit.
#
# The backend links traccc, detray, vecmem and the LCG gcc runtime out of CVMFS.
# Those paths reach the dynamic loader via LD_LIBRARY_PATH, which `asetup` sets on
# the build node but which does not exist inside a Triton container. Without it,
# loading libtriton_traccc.so fails on its first dependency:
#
#   unable to load shared library: libtraccc_io.so.1: cannot open shared object file
#
# This script replays the search path recorded when the backend was configured.
#
# Requires /cvmfs to be visible in the container, e.g.
#   apptainer run --nv --bind /cvmfs:/cvmfs ...
#
# Usage:
#   source setup_env.sh
#   tritonserver --model-repository=.../model_repository --log-verbose=1

ATHENA_LD_LIBRARY_PATH="@ATHENA_LD_LIBRARY_PATH@"

if [ -z "${ATHENA_LD_LIBRARY_PATH}" ]; then
  echo "setup_env.sh: no LD_LIBRARY_PATH was captured at configure time." >&2
  echo "  Re-run cmake from a shell where 'asetup' has been sourced." >&2
  return 1 2>/dev/null || exit 1
fi

# Prepended, not replaced: Apptainer puts the injected NVIDIA driver libraries on
# LD_LIBRARY_PATH (/.singularity.d/libs), and --nv breaks if those are dropped.
export LD_LIBRARY_PATH="${ATHENA_LD_LIBRARY_PATH}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Fail loudly here rather than inside Triton's dlopen, whose error names only the
# first missing library and not the reason.
if [ ! -d /cvmfs/atlas-nightlies.cern.ch ]; then
  echo "setup_env.sh: warning: /cvmfs/atlas-nightlies.cern.ch is not readable." >&2
  echo "  Re-launch the container with --bind /cvmfs:/cvmfs" >&2
fi
