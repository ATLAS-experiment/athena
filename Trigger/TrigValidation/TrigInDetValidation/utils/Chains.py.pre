    def get_values(self, slice_names: list, prop: str) -> set:
        values = set()
        d = self.get_menu_dict()

        for sn in slice_names:
            if sn not in d:
                raise RuntimeError("Undefined slice name {}".format(sn))
            cfg = d[sn]

            if prop in cfg:
                values.update(cfg[prop])

        return values

    def get_flag_str(self, slice_names: list, prop: str, flag_name: str) -> str:
        values = self.get_values(slice_names, prop)

        cs = ["'{}'".format(v) for v in values]
        return "flags.Trigger.{0}=[{1}]".format(flag_name, ",".join(cs))
    
    def get_selectChains_flag(self, slice_names: list) -> str:
        return self.get_flag_str(slice_names, "chains", "selectChains")
    
    def get_enabledSignatures_flag(self, slice_names: list) -> str:
        return self.get_flag_str(slice_names, "signature", "enabledSignatures")
    
    def get_menu_flag(self, slice_names: list) -> str:
        d = self.get_menu_dict()
        values = set()

        for sn in slice_names:
            cfg = d[sn]

            if(cfg["menu"] == ''):
                continue

            values.add(cfg["menu"])

        if(len(values) > 1):
            raise RuntimeError("Multiple menus specified, configured slices {0} conflict between {1}".format(slice_names, values))
        
        if(len(values) == 0):
            return ""
        
        return "flags.Trigger.triggerMenuSetup='{}'".format(list(values)[0])
    
    def get_compiled_flag_str(self, slice_names: list) -> str:
        flags = []
        flags.append(self.get_flag_str(slice_names, "chains", "selectChains"))
        flags.append(self.get_flag_str(slice_names, "signature", "enabledSignatures"))

        mf = self.get_menu_flag(slice_names)

        if(mf != ''):
            flags.append(mf)
            
        extra = self.get_values(slice_names, "extra")
        flags += extra

        return ";".join(flags)

