# Fail on errors.
set -e

# Run the command.
if [ -f "L1CaloPhase1Monitoring.py" ]; then
  # allows for local override of underlying script (e.g. from get_files L1CaloPhase1Monitoring.py)
  echo "Executing: athena L1CaloPhase1Monitoring.py $@ "
  athena L1CaloPhase1Monitoring.py "$@"
else
  echo "Executing: athena TrigT1CaloMonitoring/L1CaloPhase1Monitoring.py $@ "
  athena TrigT1CaloMonitoring/L1CaloPhase1Monitoring.py "$@"
fi
