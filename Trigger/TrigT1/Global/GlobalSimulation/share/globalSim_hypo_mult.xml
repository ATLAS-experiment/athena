<?xml version = "1.0" encoding="UTF-8"?>
<GlobalSimAlgConfig>
  <desc>AlgTool propertys to run the hypo Count with eFexRoIs</desc>
  <!-- TOB Writers-->
  <TOBWriters>
    <AlgTool class="eFexCvtrAlgTool" name="eFexCvtrAlgTool">
    </AlgTool>
  </TOBWriters>
  <!-- TIP Writers-->
  <TIPWriters>
    <AlgTool class="eEmMultAlgTool" name="eEmMultAlgTool">
      <!-- rhad-->
      <property name="rhad" value="0"/>
      <property name="rhad_op" value="&lt;="/>
      <!-- reta-->
      <property name="reta" value="0"/>
      <property name="reta_op" value="&lt;="/>
      <!-- wstot-->
      <property name="wstot" value="0"/>
      <property name="wstot_op" value="&lt;="/>
    </AlgTool>
  </TIPWriters>
</GlobalSimAlgConfig>
