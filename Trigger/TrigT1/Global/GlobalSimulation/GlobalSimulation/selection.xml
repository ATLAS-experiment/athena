<lcgdict>
    <!-- The BitSpecs the TOB text reader and writer can be pointed at. This is
         the list: the pack and unpack functions are built from these names
         through the interpreter, so a spec absent here cannot be used. -->

    <class pattern="GlobalSim::*"/>
    <exclusion>
        <class pattern="GlobalSim::Bit*"/>
        <class name="GlobalSim::AuxSpec"/>
        <class name="GlobalSim::NoBase"/>
        <class pattern="GlobalSim::*::ObjectAcc"/>
    </exclusion>
    <class pattern="GlobalSim::Object<*>"/>
</lcgdict>
