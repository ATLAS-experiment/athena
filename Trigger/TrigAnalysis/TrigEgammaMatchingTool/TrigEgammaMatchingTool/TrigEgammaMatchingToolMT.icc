#include <ranges>
#include <string_view>
#include <vector>


// L2Calo, L2Electron, L2Photon, EFCalo, Electron and Photon trigger passed access
template<class T>
inline bool TrigEgammaMatchingToolMT::ancestorPassed( const EventContext& ctx,
                                                      const TrigCompositeUtils::Decision *dec, const std::string& trigger, const std::string& key,
                                                      unsigned int condition) const
{

  if( !dec ) return false;

  auto initRoi = TrigCompositeUtils::findLink<TrigRoiDescriptorCollection>(ctx, dec, "initialRoI");
  if( !initRoi.isValid() ) 
    return false;

  auto vec =  tdt()->features< T >(trigger,condition ,key);

  for( auto &featLinkInfo : vec )
  {                                                       
    auto roi = TrigCompositeUtils::findLink<TrigRoiDescriptorCollection>(ctx, featLinkInfo.source, "initialRoI");
    if( ! roi.isValid()) continue;                                                              
    if( (*roi.link)->roiWord() == (*initRoi.link)->roiWord()) 
    {
      bool passed = (featLinkInfo.state==TrigCompositeUtils::ActiveState::ACTIVE);
      if(passed)  return true;
    }
  }
  return false;                      
}


// L1Calo trigger passed access
template<>
inline bool TrigEgammaMatchingToolMT::ancestorPassed<TrigRoiDescriptorCollection>( const EventContext& ctx,
                                                                                   const TrigCompositeUtils::Decision *dec,
                                                                                   const std::string& trigger, const std::string& /*key*/,
                                                                                   unsigned int condition ) const
{
  if( !dec ) return false;
  auto initRoi = TrigCompositeUtils::findLink<TrigRoiDescriptorCollection>(ctx, dec, "initialRoI");
  if( !initRoi.isValid() ) 
    return false;

  auto vec =  tdt()->features<TrigRoiDescriptorCollection>(trigger,condition,"",TrigDefs::allFeaturesOfType,"initialRoI");       

  for( auto &featLinkInfo : vec )
  {                   
    if(!featLinkInfo.isValid())  continue;                             
    if( (*featLinkInfo.link)->roiWord() == (*initRoi.link)->roiWord()) 
    {
      bool passed = (featLinkInfo.state==TrigCompositeUtils::ActiveState::ACTIVE);
      if(passed)  return true; 
    }
  }
  return true;                      
}




template<class T>
inline bool TrigEgammaMatchingToolMT::closestObject( const xAOD::Egamma *eg, const TrigCompositeUtils::Decision *&dec,
                                                     const std::string &trigger, const std::string &key ,
                                                     float dR_value, unsigned int condition ) const
{
  double deltaR=0.;        
  auto vec =  tdt()->features<T>(trigger, condition ,key);
  
  
  for( auto &featLinkInfo : vec ){

    if(! featLinkInfo.isValid() ) continue;
    const auto *feat = *(featLinkInfo.link);
    if(!feat) continue;
    deltaR = dR(eg->eta(),eg->phi(), feat->eta(),feat->phi());
    if(deltaR < dR_value){
      dec = featLinkInfo.source;
      return true;
    }
  }
  return false;
}


template<class T>
inline std::vector<TrigCompositeUtils::LinkInfo<T>> TrigEgammaMatchingToolMT::getFeatures( const EventContext& ctx,
                                                                                           const TrigCompositeUtils::Decision *dec ,
                                                                                           const std::string& trigger, const std::string& key,
                                                                                           unsigned int condition ) const
{
  std::vector<TrigCompositeUtils::LinkInfo<T>> vec;
  auto initRoi = TrigCompositeUtils::findLink<TrigRoiDescriptorCollection>(ctx, dec, "initialRoI");
  if( !initRoi.isValid() ) return vec;

  auto vec_dec = tdt()->features<T>(trigger,condition, key);
  for ( auto& featLinkInfo : vec_dec ){
    if( !featLinkInfo.isValid() ) continue;
    auto roi = TrigCompositeUtils::findLink<TrigRoiDescriptorCollection>(ctx, featLinkInfo.source, "initialRoI");
    if( ! roi.isValid()) continue;                                                              
    if( (*roi.link)->roiWord() == (*initRoi.link)->roiWord() )
      vec.push_back( featLinkInfo );
  }
  return vec;
}





// L1Calo
template<>
inline TrigCompositeUtils::LinkInfo<TrigRoiDescriptorCollection>
TrigEgammaMatchingToolMT::getFeature<TrigRoiDescriptorCollection>( const EventContext& ctx,
                                                                   const TrigCompositeUtils::Decision *dec ,
                                                                   const std::string& trigger, unsigned int condition ) const
{
  auto initRoi = TrigCompositeUtils::findLink<TrigRoiDescriptorCollection>(ctx, dec, "initialRoI");

  if( initRoi.isValid() ){
    // includeFailedDecisions

    auto vec_dec =  tdt()->features<TrigRoiDescriptorCollection>(trigger, condition,"",TrigDefs::allFeaturesOfType,"initialRoI");
    for( auto &featLinkInfo: vec_dec ){
      if( !featLinkInfo.isValid() ) continue;
      if( (*featLinkInfo.link)->roiWord() == (*initRoi.link)->roiWord() )  return featLinkInfo; 
    }
  }

  return TrigCompositeUtils::LinkInfo<TrigRoiDescriptorCollection>();
}


// L2Calo
template<>
inline TrigCompositeUtils::LinkInfo<xAOD::TrigEMClusterContainer>
TrigEgammaMatchingToolMT::getFeature<xAOD::TrigEMClusterContainer>( const EventContext& ctx,
                                                                    const TrigCompositeUtils::Decision *dec ,
                                                                    const std::string& trigger, unsigned int condition ) const
{
  std::vector<TrigCompositeUtils::LinkInfo<xAOD::TrigEMClusterContainer>> vec =
    getFeatures<xAOD::TrigEMClusterContainer>(ctx, dec, trigger, key("FastCalo") , condition);
  return !vec.empty() ? vec.front() : TrigCompositeUtils::LinkInfo<xAOD::TrigEMClusterContainer>();
}


// L2Electron
template<>
inline std::vector<TrigCompositeUtils::LinkInfo<xAOD::TrigElectronContainer>>
TrigEgammaMatchingToolMT::getFeatures<xAOD::TrigElectronContainer>( const EventContext& ctx,
                                                                    const TrigCompositeUtils::Decision *dec ,
                                                                    const std::string& trigger,
                                                                    unsigned int condition ) const
{
  if(trigger.contains("lrt")){
    return getFeatures<xAOD::TrigElectronContainer>(ctx, dec, trigger, key("FastElectrons_LRT"), condition);
  }else{
    return getFeatures<xAOD::TrigElectronContainer>(ctx, dec, trigger, key("FastElectrons"), condition);
  }
}


// L2Photon
template<>
inline TrigCompositeUtils::LinkInfo<xAOD::TrigPhotonContainer>
TrigEgammaMatchingToolMT::getFeature<xAOD::TrigPhotonContainer>( const EventContext& ctx,
                                                                 const TrigCompositeUtils::Decision *dec ,
                                                                 const std::string& trigger,
                                                                 unsigned int condition ) const
{
  auto vec = getFeatures<xAOD::TrigPhotonContainer>(ctx, dec, trigger, key("FastPhotons") , condition);
  return !vec.empty() ? vec.front() : TrigCompositeUtils::LinkInfo<xAOD::TrigPhotonContainer>();
}


// EFCalo
template<>
inline std::vector<TrigCompositeUtils::LinkInfo<xAOD::CaloClusterContainer>>
TrigEgammaMatchingToolMT::getFeatures<xAOD::CaloClusterContainer>( const EventContext& ctx,
                                                                   const TrigCompositeUtils::Decision *dec ,
                                                                   const std::string& trigger,
                                                                   unsigned int condition ) const
{
  std::vector<std::string> parts;
  for (auto&& part : trigger | std::views::split('_')) parts.emplace_back(part.begin(), part.end());
  if(trigger.contains("lrt")){
    return getFeatures<xAOD::CaloClusterContainer>(ctx, dec, trigger, key("PrecisionCalo_LRT"), condition );
  }else if(parts.at(0).contains("g")){
    return getFeatures<xAOD::CaloClusterContainer>(ctx, dec, trigger, key("PrecisionCalo_Photon"), condition );
  }else{
    return getFeatures<xAOD::CaloClusterContainer>(ctx, dec, trigger, key("PrecisionCalo_Electron"), condition );
  }

}



// Electron
template<>
inline std::vector<TrigCompositeUtils::LinkInfo<xAOD::ElectronContainer>>
TrigEgammaMatchingToolMT::getFeatures<xAOD::ElectronContainer>(const EventContext& ctx,
                                                               const TrigCompositeUtils::Decision *dec,
                                                               const std::string& trigger,
                                                               unsigned int condition) const
{
  if (trigger.contains("gsf")){
    return getFeatures<xAOD::ElectronContainer>(ctx, dec, trigger, key("Electrons_GSF") , condition);
  }else if(trigger.contains("lrt")){
    return getFeatures<xAOD::ElectronContainer>(ctx, dec, trigger, key("Electrons_LRT") , condition);
  }else{
    return getFeatures<xAOD::ElectronContainer>(ctx, dec, trigger, key("Electrons") , condition);
  }
}


// Photon
template<>
inline std::vector<TrigCompositeUtils::LinkInfo<xAOD::PhotonContainer>>
TrigEgammaMatchingToolMT::getFeatures<xAOD::PhotonContainer>( const EventContext& ctx,
                                                              const TrigCompositeUtils::Decision *dec ,
                                                              const std::string& trigger,
                                                              unsigned int condition ) const
{
  return getFeatures<xAOD::PhotonContainer>(ctx, dec, trigger, key("Photons"), condition );
}






