class _FileOutputs:
    def initialize(self, suffix):
        self.athena_log = f"athena{suffix}.log"
        self.calonoise_db = f"caloSqlite_UPD1_online{suffix}.db"
        self.calonoise_diff = f"noise_summary{suffix}.txt"
        self.calonoise_root = f"cellnoise_data{suffix}.root"
        self.calonoise_txt = f"calonoise{suffix}.txt"  # keep consistent with CaloCellNoiseAlg.cxx
        self.calonoise_log = f"makedb{suffix}.log"
        self.coolcopy_log = f"mergedb{suffix}.log"
        self.hlt_log = f"hlt{suffix}.log"
        self.hvcorr_diff = f"hvlist{suffix}.txt"
        self.hvcorr_file_prefix = f"hvcorr{suffix}"  # the CA config appends _ntuple.root to it
        self.hvcorr_db = f"{self.hvcorr_file_prefix}.sqlite"  # keep consistent with LArCalib_HVCorrConfig.py
        self.hvcorr_ntuple = f"{self.hvcorr_file_prefix}_ntuple.root"  # idem
        self.larnoise_db = f"larnoisesqlite{suffix}.db"
    def cleanup(self, quiet=False):
        for  _ in self.__dict__.values():
            if isinstance(_, str) and os.path.isfile(_):
                if not quiet: print(f"WARNING: deleting existing file {_}")
                os.remove(_)
    @staticmethod
    def files_exist(*files):
        return not any(not os.access(_, os.R_OK) for _ in files)
    def is_clean_dir(self):
        return not any(isinstance(_, str) and os.path.isfile(_) for _ in self.__dict__.values())


