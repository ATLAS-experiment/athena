<!-- Smart pointer dictionaries for xAOD container type: @_type@ -->

<class name="SG::BaseInfo<@_type@>" />

<class name="DataLink<@_type@>" />
<class name="std::vector<DataLink<@_type@> >" />

<class name="ElementLink<@_type@>" />
<class name="std::vector<ElementLink<@_type@> >" />
<class name="std::vector<std::vector<ElementLink<@_type@> > >" />

<class name="SG::AuxTypeVectorFactory<DataLink<@_type@> >" />
<class name="SG::AuxTypeVectorFactory<ElementLink<@_type@> >" />
<class name="SG::AuxTypeVectorFactory<std::vector<ElementLink<@_type@> > >" />
<class name="SG::AuxTypeVectorFactoryImpl<DataLink<@_type@> >" />
<class name="SG::AuxTypeVectorFactoryImpl<ElementLink<@_type@> >" />
<class name="SG::AuxTypeVectorFactoryImpl<std::vector<ElementLink<@_type@> > >" />

<class name="DataVectorBase<@_type@::base_value_type>" />


<!-- Extra dictionaries needed to avoid cling assertion failures in the
     dbg build with ROOT 6.38.04. See ATEAM-1143. -->
<class name="std::allocator<ElementLink<@_type@> >" />
<class name="std::allocator<std::vector<ElementLink<@_type@> > >" />
<class name="std::_Vector_base<ElementLink<@_type@>, std::allocator<ElementLink<@_type@> > >" />
<class name="std::_Vector_base<std::vector<ElementLink<@_type@> >, std::allocator<std::vector<ElementLink<@_type@> > > >" />
